    if(ln.label){ctx.font=LABEL_FONT;var tw=ctx.measureText(ln.label).width,cands=[{x1:plotW-5,yc:py-10},{x1:plotW-5,yc:py+11}],best=null;for(var cc=0;cc<cands.length;cc++){var b={x0:cands[cc].x1-tw,x1:cands[cc].x1,y0:cands[cc].yc-7,y1:cands[cc].yc+7};if(b.y0<padT||b.y1>priceH)continue;if(!taken.some(function(t){return overlap(t,b);})){best=b;break;}if(!best)best=b;}if(!best)best={x0:plotW-5-tw,x1:plotW-5,y0:py-17,y1:py-3};ctx.fillStyle=col;ctx.textAlign='right';ctx.fillText(ln.label,best.x1,(best.y0+best.y1)/2);ctx.textAlign='left';best.t=ln.label;taken.push(best);layout.labels.push({t:ln.label,box:best,kind:'line'});}
    ctx.restore();});
  var vis=markers.filter(function(m){return m.idx>=first&&m.idx<=last&&isFinite(m.price);});
  vis.forEach(function(m){m._x=x(m.idx);m._y=y(m.price);taken.push({x0:m._x-6,y0:m._y-6,x1:m._x+6,y1:m._y+6,dot:true});});
  var path=vis.filter(function(m){return m.lane;}).sort(function(a,b){return a.idx-b.idx;});
  if(path.length>1){ctx.save();ctx.strokeStyle='rgba(152,118,255,.85)';ctx.shadowColor=COL.violet;ctx.shadowBlur=6;ctx.lineWidth=1.8;ctx.beginPath();path.forEach(function(m,j){if(j)ctx.lineTo(m._x,m._y);else ctx.moveTo(m._x,m._y);});ctx.stroke();ctx.restore();}
  vis.forEach(function(m){var col=m.color||COL.cyan;ctx.save();ctx.fillStyle=col;ctx.shadowColor=col;ctx.shadowBlur=12;ctx.beginPath();ctx.arc(m._x,m._y,4.5,0,Math.PI*2);ctx.fill();ctx.restore();layout.dots.push({t:m.label,x:m._x,y:m._y,idx:m.idx});});
  ctx.font=LABEL_FONT;ctx.textBaseline='middle';
  if(path.length){ctx.font='800 10px -apple-system,"PingFang TC",sans-serif';var order=[path[path.length-1],path[0]].concat(path.slice(1,-1)),laneBoxes=[],yc=laneTop+LANE/2;
    order.forEach(function(m){var tw=ctx.measureText(m.label).width,b={x0:m._x-tw/2-1,x1:m._x+tw/2+1,y0:yc-7,y1:yc+7};if(b.x0<0||b.x1>W-2)return;if(laneBoxes.some(function(t){return overlap(t,b);}))return;laneBoxes.push(b);m._lane=b;});
    path.forEach(function(m){if(!m._lane)return;var col=m.color||COL.cyan;ctx.save();ctx.strokeStyle=col;ctx.globalAlpha=.32;ctx.setLineDash([2,3]);ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(m._x,m._y+6);ctx.lineTo(m._x,laneTop+1);ctx.stroke();ctx.restore();ctx.fillStyle=col;ctx.textAlign='center';ctx.fillText(m.label,m._x,yc);ctx.textAlign='left';layout.lane.push({t:m.label,box:m._lane,dot:{x:m._x,y:m._y}});});ctx.font=LABEL_FONT;}
  vis.filter(function(m){return !m.lane;}).forEach(function(m){var tw=ctx.measureText(m.label||'').width,th=14,cx=m._x,cy=m._y;
