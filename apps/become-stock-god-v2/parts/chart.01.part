  var pad=(hi-lo)*.085||Math.max(1,hi*.02);lo-=pad;hi+=pad;function y(p){return padT+(hi-p)/(hi-lo)*(priceH-padT);}function yi(py){return hi-(py-padT)/(priceH-padT)*(hi-lo);}function x(ii){return blank+(ii-first+.5)*bw;}geo={y:y,yi:yi,x:x,bw:bw,first:first,last:last,plotW:plotW,priceH:priceH};
