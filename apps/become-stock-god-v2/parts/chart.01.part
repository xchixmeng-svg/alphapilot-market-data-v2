/* 成為股神 V3 — neon training chart */
(function(root){
'use strict';
var COL={bg:'#050b17',grid:'rgba(70,118,155,.16)',up:'#ff465f',down:'#24d79b',text:'#eefaff',muted:'#7190a8',ma20:'#ffd44a',ma60:'#27c8ff',cyan:'#39f5ff',violet:'#9876ff'};
function rr(ctx,x,y,w,h,r){ctx.beginPath();ctx.moveTo(x+r,y);ctx.arcTo(x+w,y,x+w,y+h,r);ctx.arcTo(x+w,y+h,x,y+h,r);ctx.arcTo(x,y+h,x,y,r);ctx.arcTo(x,y,x+w,y,r);ctx.closePath();}
function create(wrap,opt){
 opt=opt||{};var cv=document.createElement('canvas'),tip=document.createElement('div'),ctl=document.createElement('div'),legend=document.createElement('div');
 tip.className='charttip';tip.style.display='none';ctl.className='chartctl v3';legend.className='chartlegend';
 ctl.innerHTML=[20,60,120,240].map(function(n){return '<button type="button" data-range="'+n+'">'+(n===240?'1Y':n+'D')+'</button>';}).join('');
 wrap.innerHTML='';wrap.appendChild(cv);wrap.appendChild(tip);wrap.appendChild(ctl);wrap.appendChild(legend);
 var ctx=cv.getContext('2d'),dpr=1,W=0,H=0,geo=null,pointers={},drag=null,lastSeen=null,view={count:60,right:null,cross:null};
 function data(){return opt.getData?opt.getData():null;}
 function resize(){var r=wrap.getBoundingClientRect();W=Math.max(280,r.width);H=Math.max(260,r.height);dpr=Math.min(2,window.devicePixelRatio||1);cv.width=Math.round(W*dpr);cv.height=Math.round(H*dpr);cv.style.width=W+'px';cv.style.height=H+'px';draw();}
 function fmt(p){if(!isFinite(p))return '—';var d=p<50?2:(p<1000?1:0);return p.toFixed(d);}
 function clampView(d){var mx=Math.max(20,d.lastIdx+1);view.count=Math.max(20,Math.min(view.count,mx));if(view.right===null)view.right=d.lastIdx;view.right=Math.min(d.lastIdx,Math.max(view.count-1,view.right));}
 function drawGlowLine(arr,col,first,last,x,y,width){if(!arr)return;ctx.save();ctx.shadowColor=col;ctx.shadowBlur=10;ctx.strokeStyle=col;ctx.lineWidth=width||1.8;ctx.beginPath();var on=false;for(var q=first;q<=last;q++){var v=arr[q];if(v==null){on=false;continue;}var xx=x(q),yy=y(v);if(!on){ctx.moveTo(xx,yy);on=true;}else ctx.lineTo(xx,yy);}ctx.stroke();ctx.restore();}
 function draw(){var d=data();if(!d||!d.R)return;clampView(d);updateCtl(d);if(lastSeen!==null&&d.lastIdx>lastSeen&&view.right>=lastSeen-1)view.right=d.lastIdx;lastSeen=d.lastIdx;
  var R=d.R;ctx.setTransform(dpr,0,0,dpr,0,0);var g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,'#071321');g.addColorStop(1,COL.bg);ctx.fillStyle=g;ctx.fillRect(0,0,W,H);
  var axis=62,padT=14,plotW=W-axis-4,showVol=d.showVolume!==false,priceH=showVol?Math.floor(H*.74):(H-10),volTop=priceH+14,volH=showVol?Math.max(30,H-volTop-8):0,first=Math.max(0,view.right-view.count+1),last=view.right,n=last-first+1,bw=plotW/view.count,blank=(view.count-n)*bw;
  var lo=Infinity,hi=-Infinity,vmax=0;for(var i=first;i<=last;i++){lo=Math.min(lo,R.l[i]);hi=Math.max(hi,R.h[i]);vmax=Math.max(vmax,R.v[i]||0);} (d.lines||[]).forEach(function(z){if(z.price>0){lo=Math.min(lo,z.price);hi=Math.max(hi,z.price);}});(d.zones||[]).forEach(function(z){lo=Math.min(lo,z.lo);hi=Math.max(hi,z.hi);});
  var pad=(hi-lo)*.085||Math.max(1,hi*.02);lo-=pad;hi+=pad;function y(p){return padT+(hi-p)/(hi-lo)*(priceH-padT);}function yi(py){return hi-(py-padT)/(priceH-padT)*(hi-lo);}function x(ii){return blank+(ii-first+.5)*bw;}geo={y:y,yi:yi,x:x,bw:bw,first:first,last:last,plotW:plotW,priceH:priceH};
  ctx.strokeStyle=COL.grid;ctx.lineWidth=1;ctx.font='600 11px ui-monospace,Menlo,monospace';ctx.fillStyle=COL.muted;ctx.textAlign='left';ctx.textBaseline='middle';for(var gy=0;gy<=4;gy++){var py=padT+gy*(priceH-padT)/4,pv=yi(py);ctx.beginPath();ctx.moveTo(0,Math.round(py)+.5);ctx.lineTo(plotW,Math.round(py)+.5);ctx.stroke();ctx.fillText(fmt(pv),plotW+7,py);}for(var gx=1;gx<5;gx++){var xx=plotW*gx/5;ctx.beginPath();ctx.moveTo(xx,padT);ctx.lineTo(xx,H-6);ctx.stroke();}if(showVol){ctx.beginPath();ctx.moveTo(0,volTop-6);ctx.lineTo(W,volTop-6);ctx.stroke();}
  (d.zones||[]).forEach(function(z){var yt=y(z.hi),yb=y(z.lo),col=z.color||COL.cyan;ctx.save();ctx.globalAlpha=z.alpha||.13;var zg=ctx.createLinearGradient(0,yt,0,yb);zg.addColorStop(0,col);zg.addColorStop(1,'rgba(0,0,0,0)');ctx.fillStyle=zg;ctx.fillRect(0,yt,plotW,Math.max(2,yb-yt));ctx.globalAlpha=.85;ctx.strokeStyle=col;ctx.setLineDash([5,5]);ctx.strokeRect(.5,yt+.5,plotW-1,Math.max(2,yb-yt));ctx.setLineDash([]);ctx.fillStyle=col;ctx.shadowColor=col;ctx.shadowBlur=6;ctx.font='800 11px -apple-system,"PingFang TC",sans-serif';ctx.fillText(z.label||'',8,yt+11);ctx.restore();});
  if(d.d0Idx>=first&&d.d0Idx<=last){var xd=x(d.d0Idx)+bw/2;ctx.save();ctx.setLineDash([3,5]);ctx.strokeStyle='rgba(80,230,255,.45)';ctx.beginPath();ctx.moveTo(xd,padT);ctx.lineTo(xd,H-4);ctx.stroke();ctx.restore();ctx.fillStyle=COL.cyan;ctx.font='800 10px ui-monospace';ctx.fillText('NOW',Math.max(2,xd-26),22);}
  var fset={};(d.focusCandles||[]).forEach(function(z){fset[z]=1;});
  for(var k=first;k<=last;k++){var o=R.o[k],h=R.h[k],l=R.l[k],c=R.c[k],up=c>=o,col=up?COL.up:COL.down,cx=x(k),body=Math.max(2,Math.min(bw*.66,13));if(fset[k]){ctx.save();ctx.globalAlpha=.12;ctx.fillStyle=COL.cyan;ctx.shadowColor=COL.cyan;ctx.shadowBlur=18;ctx.fillRect(cx-Math.max(9,bw*.45),padT,Math.max(18,bw*.9),priceH-padT);ctx.restore();}
    ctx.save();if(fset[k]){ctx.shadowColor=col;ctx.shadowBlur=10;}ctx.strokeStyle=col;ctx.fillStyle=col;ctx.lineWidth=Math.max(1,Math.min(1.6,bw*.14));ctx.beginPath();ctx.moveTo(Math.round(cx)+.5,y(h));ctx.lineTo(Math.round(cx)+.5,y(l));ctx.stroke();var yt=y(Math.max(o,c)),yb=y(Math.min(o,c));ctx.fillRect(cx-body/2,yt,body,Math.max(1.4,yb-yt));ctx.restore();
    if(showVol){var vh=vmax?((R.v[k]||0)/vmax)*volH:0;ctx.save();ctx.globalAlpha=(d.focusVolume===k)?.9:.32;ctx.fillStyle=col;if(d.focusVolume===k){ctx.shadowColor=col;ctx.shadowBlur=10;}ctx.fillRect(cx-body/2,volTop+volH-vh,body,vh);ctx.restore();}}
  var mode=d.showMA===true?'both':d.showMA;if(mode==='ma20'||mode==='both')drawGlowLine(R.ma20,COL.ma20,first,last,x,y,2.1);if(mode==='ma60'||mode==='both')drawGlowLine(R.ma60,COL.ma60,first,last,x,y,2.1);
  var leg=[];function badge(arr,col,name){if(!arr)return;var idx=Math.min(last,d.lastIdx),v=arr[idx];if(v==null)return;leg.push('<span style="color:'+col+'"><i style="background:'+col+'"></i>'+name+' '+fmt(v)+'</span>');}
  if(mode==='ma20'||mode==='both')badge(R.ma20,COL.ma20,'MA20');if(mode==='ma60'||mode==='both')badge(R.ma60,COL.ma60,'MA60');legend.innerHTML=leg.join('');legend.style.display=leg.length?'flex':'none';
  (d.markers||[]).forEach(function(m){if(m.idx<first||m.idx>last)return;var cx=x(m.idx),py=y(m.price),col=m.color||COL.cyan;ctx.save();ctx.fillStyle=col;ctx.shadowColor=col;ctx.shadowBlur=12;ctx.beginPath();ctx.arc(cx,py,4.5,0,Math.PI*2);ctx.fill();ctx.shadowBlur=5;ctx.font='800 11px -apple-system,"PingFang TC",sans-serif';ctx.fillText(m.label||'',Math.min(plotW-110,cx+8),py-10);ctx.restore();});
  (d.lines||[]).forEach(function(ln){if(!(ln.price>0))return;var py=y(ln.price),col=ln.color||COL.cyan;ctx.save();ctx.strokeStyle=col;ctx.shadowColor=col;ctx.shadowBlur=7;ctx.lineWidth=1.5;if(ln.dash)ctx.setLineDash([6,4]);ctx.beginPath();ctx.moveTo(0,py);ctx.lineTo(plotW,py);ctx.stroke();ctx.setLineDash([]);ctx.shadowBlur=0;ctx.fillStyle=col;rr(ctx,plotW+1,py-10,axis-2,20,8);ctx.fill();ctx.fillStyle='#041019';ctx.font='800 10px ui-monospace,Menlo,monospace';ctx.fillText(fmt(ln.price),plotW+6,py+.5);if(ln.label){ctx.fillStyle=col;ctx.textAlign='right';ctx.font='800 11px -apple-system,"PingFang TC",sans-serif';ctx.fillText(ln.label,plotW-5,py-10);ctx.textAlign='left';}ctx.restore();});
  if(view.cross!==null&&view.cross>=first&&view.cross<=last){var ci=view.cross,cxp=x(ci);ctx.save();ctx.setLineDash([2,3]);ctx.strokeStyle='rgba(110,230,255,.55)';ctx.beginPath();ctx.moveTo(cxp,padT);ctx.lineTo(cxp,H-4);ctx.stroke();ctx.restore();tip.style.display='block';tip.textContent=(d.labelFor?d.labelFor(ci):ci)+'  開 '+fmt(R.o[ci])+'  高 '+fmt(R.h[ci])+'  低 '+fmt(R.l[ci])+'  收 '+fmt(R.c[ci])+'  量 '+Math.round(R.v[ci]||0).toLocaleString('en-US');}else tip.style.display='none';
 }
 function updateCtl(d){Array.from(ctl.querySelectorAll('button')).forEach(function(b){var n=+b.dataset.range;b.disabled=n>d.d0Idx+1&&d.lastIdx<=d.d0Idx;b.classList.toggle('on',view.count===Math.min(n,d.lastIdx+1));});}
 function loc(e){var r=cv.getBoundingClientRect();return{x:e.clientX-r.left,y:e.clientY-r.top};}
 cv.addEventListener('pointerdown',function(e){cv.setPointerCapture(e.pointerId);var p=loc(e);pointers[e.pointerId]=p;var ids=Object.keys(pointers);if(ids.length===1)drag={type:'pan',x0:p.x,right0:view.right,moved:false};else if(ids.length===2){var a=pointers[ids[0]],b=pointers[ids[1]];drag={type:'pinch',d0:Math.abs(a.x-b.x)||1,count0:view.count};}});
 cv.addEventListener('pointermove',function(e){if(!pointers[e.pointerId]||!drag||!geo)return;var p=loc(e);pointers[e.pointerId]=p;if(drag.type==='pan'){var dx=p.x-drag.x0;if(Math.abs(dx)>3)drag.moved=true;view.right=Math.max(view.count-1,Math.min(data().lastIdx,Math.round(drag.right0-dx/geo.bw)));draw();}else{var ids=Object.keys(pointers);if(ids.length<2)return;var dd=Math.abs(pointers[ids[0]].x-pointers[ids[1]].x)||1;view.count=Math.max(20,Math.min(data().lastIdx+1,Math.round(drag.count0*drag.d0/dd)));draw();}});
 function up(e){var p=pointers[e.pointerId];delete pointers[e.pointerId];if(drag&&drag.type==='pan'&&!drag.moved&&p&&geo){var i=Math.round(geo.first+(p.x-(view.count-(geo.last-geo.first+1))*geo.bw)/geo.bw-.5);view.cross=(i===view.cross||i<geo.first||i>geo.last)?null:i;draw();}if(!Object.keys(pointers).length)drag=null;}
 cv.addEventListener('pointerup',up);cv.addEventListener('pointercancel',up);ctl.addEventListener('click',function(e){var b=e.target.closest('[data-range]');if(!b||b.disabled)return;var d=data();view.count=Math.min(+b.dataset.range,d.lastIdx+1);view.right=d.lastIdx;view.cross=null;draw();});
 var ro=typeof ResizeObserver!=='undefined'?new ResizeObserver(resize):null;if(ro)ro.observe(wrap);else window.addEventListener('resize',resize);resize();
 return{draw:draw,setRange:function(n){var d=data();view.count=Math.min(n,d.lastIdx+1);view.right=d.lastIdx;draw();},destroy:function(){if(ro)ro.disconnect();}};
}
root.BSGChart={create:create};
})(window);
