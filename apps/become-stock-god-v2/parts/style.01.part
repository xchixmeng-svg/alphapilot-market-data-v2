:root{
  --bg:#071019;--s1:#0d1722;--s2:#13202d;--s3:#18293a;--bd:#26394c;--t1:#f4f7fb;--t2:#8a99ad;
  --gold:#e7b84b;--blue:#55a8ff;--up:#ff5364;--down:#25c77a;--warn:#ffad38;--ink:#071019;
  --font:-apple-system,BlinkMacSystemFont,"PingFang TC","Noto Sans TC","Microsoft JhengHei",sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,monospace
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;background:var(--bg);color:var(--t1);font:500 15px/1.55 var(--font);min-height:100%;overscroll-behavior:none}button,input{font:inherit;color:inherit}button{cursor:pointer}#app{max-width:520px;margin:0 auto;min-height:100vh;min-height:100dvh}.screen{min-height:100vh;min-height:100dvh;display:flex;flex-direction:column}.content{flex:1;padding:8px 16px 24px;overflow-y:auto}.topbar{display:flex;align-items:center;gap:8px;min-height:56px;padding:8px 12px}.topbar .title{font-size:16px;font-weight:800;flex:1;text-align:center}.iconbtn{width:44px;height:44px;border:1px solid var(--bd);border-radius:13px;background:var(--s1);font-size:20px}.footer{font-size:11px;color:var(--t2);text-align:center;border-top:1px solid var(--bd);padding:8px 12px calc(8px + env(safe-area-inset-bottom));background:rgba(7,16,25,.96)}
.logo{font-size:35px;font-weight:900;letter-spacing:.05em}.logo span{color:var(--gold)}.eyebrow{font-size:11px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;color:var(--gold)}.h1{font-size:25px;font-weight:900;line-height:1.2;margin:4px 0 8px}.h2{font-size:19px;font-weight:850;margin:2px 0 6px}.lead{font-size:16px;line-height:1.65;color:#d9e0e8}.muted{color:var(--t2)}.small{font-size:13px}.tiny{font-size:11px}.mono{font-family:var(--mono)}.big{font:800 28px/1.1 var(--mono)}.center{text-align:center}.up{color:var(--up)}.down{color:var(--down)}.gold{color:var(--gold)}.blue{color:var(--blue)}.warn{color:var(--warn)}
.card{background:linear-gradient(180deg,var(--s1),#0b1520);border:1px solid var(--bd);border-radius:18px;padding:16px;margin:0 0 12px}.card.flat{background:var(--s1)}.card.hero{padding:20px}.card.good{border-color:rgba(37,199,122,.45)}.card.bad{border-color:rgba(255,83,100,.45)}.card.info{border-color:rgba(85,168,255,.45)}.row{display:flex;align-items:center;gap:8px}.between{justify-content:space-between}.wrap{flex-wrap:wrap}.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}.stack{display:flex;flex-direction:column;gap:10px}.hr{height:1px;background:var(--bd);margin:12px 0}
.btn{min-height:50px;border-radius:14px;border:1px solid var(--bd);background:var(--s2);font-weight:800;padding:10px 14px;display:inline-flex;align-items:center;justify-content:center;gap:7px}.btn:active{transform:scale(.99)}.btn.block{width:100%}.btn.primary{background:var(--gold);border-color:var(--gold);color:#17120a}.btn.blue{background:var(--blue);border-color:var(--blue);color:#04121e}.btn.good{background:rgba(37,199,122,.13);border-color:rgba(37,199,122,.55);color:#73e5ad}.btn.bad{background:rgba(255,83,100,.09);border-color:rgba(255,83,100,.5);color:#ff8d99}.btn.ghost{background:transparent}.btn.sm{min-height:40px;padding:6px 11px;font-size:13px}.btn[disabled]{opacity:.35;pointer-events:none}.btnrow{display:flex;gap:10px}.btnrow>*{flex:1}
.chip{border:1px solid var(--bd);background:var(--s2);border-radius:999px;min-height:38px;padding:7px 12px;font-weight:750;font-size:13px}.chip.on{border-color:var(--gold);color:var(--gold);background:rgba(231,184,75,.08)}.badge{display:inline-flex;align-items:center;min-height:23px;border:1px solid var(--bd);border-radius:999px;padding:2px 8px;color:var(--t2);font-size:11px;font-weight:750}.badge.gold{border-color:rgba(231,184,75,.5);color:var(--gold)}.badge.blue{border-color:rgba(85,168,255,.5);color:var(--blue)}.badge.warn{border-color:rgba(255,173,56,.5);color:var(--warn)}
.progress{height:8px;background:var(--s2);border-radius:999px;overflow:hidden}.progress i{display:block;height:100%;background:var(--gold);border-radius:inherit}.lesson{display:grid;grid-template-columns:42px 1fr auto;align-items:center;gap:12px;border:1px solid var(--bd);background:var(--s1);border-radius:16px;padding:12px;margin-bottom:9px}.lesson .n{width:42px;height:42px;border-radius:14px;background:var(--s2);display:grid;place-items:center;font:800 15px var(--mono)}.lesson.done .n{background:rgba(37,199,122,.12);color:var(--down)}.lesson.locked{opacity:.38}.lesson .tt{font-weight:850}.lesson .st{font-size:12px;color:var(--t2)}
.rulegrid{display:grid;grid-template-columns:1fr;gap:10px}.rulebox{border-radius:15px;border:1px solid var(--bd);padding:13px;background:var(--s2)}.rulebox.good{border-color:rgba(37,199,122,.35)}.rulebox.bad{border-color:rgba(255,83,100,.35)}.rulebox .rt{font-weight:850;margin-bottom:5px}.rulebox ul{margin:7px 0 0;padding-left:20px;color:#d9e0e8}.rulebox li{margin:6px 0}
.chart-shell{position:relative;background:#071019;border:1px solid var(--bd);border-radius:17px;overflow:hidden;margin:10px 0}.chartwrap{position:relative;height:clamp(310px,50vh,520px);touch-action:none;user-select:none;-webkit-user-select:none}.chartwrap canvas{width:100%;height:100%;display:block}.charttip{position:absolute;left:8px;top:8px;z-index:5;max-width:calc(100% - 16px);font:700 11px var(--mono);color:#dce4ec;background:rgba(7,16,25,.9);padding:5px 7px;border:1px solid var(--bd);border-radius:8px;pointer-events:none}.chartctl.v2{position:absolute;left:8px;bottom:8px;display:flex;gap:5px;z-index:4}.chartctl.v2 button{height:32px;min-width:42px;border-radius:9px;border:1px solid var(--bd);background:rgba(13,23,34,.92);font-size:11px;font-weight:800}.chartctl.v2 button.on{color:var(--gold);border-color:rgba(231,184,75,.65)}.chartctl.v2 button:disabled{opacity:.28}.chart-note{padding:9px 12px;background:#0b1520;border-top:1px solid var(--bd);font-size:12px;color:var(--t2)}
.coach{display:flex;gap:11px;align-items:flex-start;border:1px solid rgba(85,168,255,.35);background:rgba(85,168,255,.065);border-radius:16px;padding:13px}.coach .avatar{width:34px;height:34px;border-radius:11px;background:var(--blue);color:#06121e;display:grid;place-items:center;font-weight:900;flex:none}.coach .say{font-size:14px}.coach strong{color:#fff}.decision3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.decision3 .btn{min-height:64px;flex-direction:column;gap:2px;font-size:14px}.decision3 small{font-size:10px;font-weight:650;color:var(--t2)}
.planline{display:grid;grid-template-columns:1fr auto;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid rgba(38,57,76,.65)}.planline:last-child{border:0}.planline .k{font-size:13px;color:var(--t2)}.planline .v{font:800 15px var(--mono)}.stepper{display:flex;align-items:center;gap:6px}.stepper input{width:100%;min-width:0;height:44px;border:1px solid var(--bd);border-radius:12px;background:var(--bg);font:800 17px var(--mono);text-align:center}.stepper .btn{min-height:44px;min-width:44px;padding:0}.quizopt{width:100%;text-align:left;border:1px solid var(--bd);background:var(--s2);border-radius:14px;padding:12px 13px;margin-top:8px;font-weight:700}.quizopt.right{border-color:var(--down);color:#8be8ba}.quizopt.wrong{border-color:var(--up);color:#ff9ca6}
.hud{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;padding:0 16px 6px}.hud .right{text-align:right}.hud .pnl{font:850 18px var(--mono)}.daybar{display:flex;gap:7px;align-items:center;padding:8px 14px;border-top:1px solid var(--bd);background:#0a1420;overflow-x:auto}.daybar .badge{white-space:nowrap}.actiondock{position:sticky;bottom:0;background:linear-gradient(180deg,rgba(7,16,25,.3),#071019 24%);padding:12px 16px calc(12px + env(safe-area-inset-bottom));z-index:8}.resultmark{font-size:38px;font-weight:900}.kv{display:flex;justify-content:space-between;gap:10px;padding:7px 0;border-bottom:1px solid rgba(38,57,76,.65)}.kv:last-child{border:0}.kv .k{color:var(--t2);font-size:13px}.kv .v{font:800 14px var(--mono);text-align:right}
.toast{position:fixed;z-index:99;left:50%;bottom:90px;transform:translateX(-50%);max-width:calc(100% - 32px);background:#172536;border:1px solid var(--bd);border-radius:12px;padding:10px 13px;font-size:13px;box-shadow:0 10px 30px rgba(0,0,0,.28)}.sheet-bg{position:fixed;inset:0;background:rgba(0,0,0,.6);z-index:40}.sheet{position:fixed;z-index:41;left:50%;bottom:0;transform:translateX(-50%);width:100%;max-width:520px;max-height:86vh;overflow-y:auto;background:var(--s1);border:1px solid var(--bd);border-bottom:0;border-radius:20px 20px 0 0;padding:16px 16px calc(18px + env(safe-area-inset-bottom))}.hidden{display:none!important}
@media(min-width:470px){.rulegrid{grid-template-columns:1fr 1fr}}@media(max-width:370px){.content{padding-left:12px;padding-right:12px}.decision3{grid-template-columns:1fr}.chartwrap{height:330px}}
