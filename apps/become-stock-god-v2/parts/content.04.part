
// V5 complete course map. Layer 1 (core teaching) adds the abilities the 50-mission skeleton did not yet teach
// explicitly. Ids stay sequential (save files and CT.MISSIONS[id-1] rely on that); CT.ORDER is the teaching order,
// so each new lesson sits right after the lesson it builds on — nothing is tested before it has been taught.
(function(root){
  'use strict';
  var CT=root.BSG_CONTENT;if(!CT)return;
  function mission(m){if(!CT.MISSIONS.some(function(x){return x.id===m.id;}))CT.MISSIONS.push(m);}
  [
    [51,1,'台股跳動單位','價格不是任意小數，每個價位區間有固定一檔','TICK','知道台股每個價位的最小跳動單位，看懂哪些價格可能成交。','10 元以下一檔 0.01、10～50 元 0.05、50～100 元 0.1、100～500 元 0.5、500～1000 元 1、1000 元以上 5。','不要把 32.17 這種不可能成交的價格當成支撐或停損。','tick'],
    [52,2,'結構還不明確','高低點方向不一致時，先承認看不出來','UNCLEAR','分辨「趨勢」與「還沒形成趨勢」。','高點與低點同方向墊高或降低才叫趨勢；一個墊高、一個降低，就是結構尚未明確。','不要因為最後一根 K 很長，就硬說趨勢已經出來。','structure'],
    [53,3,'找出畫錯的線','合理的線要有價格反應，不是隨手畫','WRONG_LINE','能檢查一條支撐／壓力線是否合理。','合理的水平線附近要有多次轉折或停頓；價格只是路過的地方，不構成支撐壓力。','不要只因為某個價位是整數，就把它當成關鍵價。','levels'],
    [54,3,'突破後角色互換','原本的壓力，突破後可能變成支撐','ROLE_REVERSAL','理解突破後原壓力可能轉成支撐，並用回測驗證。','有效突破後，價格回到原壓力附近若守住，原壓力就轉為支撐；守不住，突破可能失效。','角色互換是「可能」，要用回測結果證明，不是自動成立。','levels'],
    [55,3,'回測失敗','回到原壓力下方，突破論點就要重新檢查','RETEST_FAIL','分辨回測成功與回測失敗。','回測時收盤守在原壓力上方＝成功；收盤明顯跌回原壓力下方＝失敗，原突破論點失效。','回測失敗後不要攤平，也不要等它自己漲回來。','breakout'],
    [56,5,'量價衝突','價漲量縮、價跌量增都要提高警覺','VOLUME_CONFLICT','讀出價格與成交量方向是否一致。','價漲量增、價跌量縮較健康；價漲量縮代表追價變少，價跌量增代表賣壓積極。','量價衝突不是立刻反轉，而是延續性要打折。','volume'],
    [57,5,'突破有量 vs 無量','同樣站上前高，量能決定可信度','BREAKOUT_VOLUME','判斷突破當天是否有成交量支持。','突破日量能明顯高於 20 日均量（約 1.5 倍以上）才算有量；量縮突破要等回測或後續量能確認。','無量突破不一定失敗，但不能當成強訊號。','volume'],
    [58,6,'不交易也是答案','證據不夠、位置不好或不划算，就不做','NO_TRADE','把「不交易」當成正常而且常見的正確決策。','趨勢不明、位置在半路、R:R 不到 1.5 或失策太遠時，最好的交易就是不交易。','不要因為花了時間看圖，就覺得一定要買點什麼。','decision'],
    [59,7,'MACD 零軸與背離失敗','零軸是背景，背離只是警訊','MACD_ZERO','會用零軸判斷 MACD 背景，並知道背離可能失敗。','DIF 在零軸上方代表短均線在長均線之上，背景偏多；背離出現後價格若繼續創高，就是背離失敗。','不要一看到背離就放空，價格結構沒轉弱前背離可以一直失敗。','macd'],
    [60,7,'KD 交叉失敗','交叉之後價格不跟，就是失敗訊號','KD_FAIL','檢查 KD 交叉後價格有沒有照方向走。','黃金交叉後價格卻破底、死亡交叉後價格卻創高，代表交叉失敗，價格結構優先。','不要因為 KD 交叉就忽略價格正在破底。','kd'],
    [61,7,'RSI 背離、鈍化與假訊號','RSI 極端值可以一直延續','RSI_ADVANCED','認得 RSI 背離、鈍化與假訊號。','價格創新低但 RSI 低點墊高是偏多背離；RSI 長時間停在 70 以上或 30 以下叫鈍化；跌破 30 後反彈不等於反轉。','RSI 只是證據，不能脫離價格結構單獨決定進出場。','rsi'],
    [62,8,'反轉失敗','較高低點被跌破，反轉就要重來','REVERSAL_FAIL','知道反轉可能失敗，以及失敗時要怎麼處理。','下降結構先出現較高低點，之後又跌破它，就是反轉失敗，回到下降結構。','反轉失敗時不要把失策往下移，照原計畫處理。','reversal'],
    [63,8,'三種進場方式','突破進、回測進、確認後進','ENTRY_TYPES','分辨三種進場方式的時機與代價。','突破進最早但最容易遇到假突破；回測進失策近、R:R 較好但可能等不到；確認後進最穩但價格較差。','任何一種進場，都要先知道失策在哪裡。','entry']
  ].forEach(function(a){mission({id:a[0],world:a[1],title:a[2],sub:a[3],skill:a[4],objective:a[5],rule:a[6],anti:a[7],focus:a[8]});});
  // Teaching order (ids). New lessons follow the lesson whose idea they extend.
  CT.ORDER=[1,2,3,4,5,51,6, 7,8,9,10,11,52,12, 13,14,15,53,16,17,18,54,55, 19,20,21,22,23,24, 25,26,56,27,28,57,29,30, 31,32,33,58,34,35,36,
            37,38,39,40,41,59,42,43,60,44,61,45,46, 47,48,62,49,63,50];
  // Five product layers after/around the core lessons (see app.0300 for the engines).
  CT.LAYERS={core:'核心教學',drills:'技能訓練場',mixed:'混合判圖',daily:'逐日實戰',final:'技術面畢業考'};
})(window);
