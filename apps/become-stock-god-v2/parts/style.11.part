
/* ───────────── V4.1 visual polish — match approved neon chick mockup ───────────── */
:root{--ck-bg0:#020812;--ck-bg1:#051426;--ck-panel:#07192d;--ck-panel2:#0a2039;--ck-cyan2:#49efff;--ck-blue:#188cff;--ck-gold3:#ffc945}
body{background:radial-gradient(900px 520px at 50% -80px,rgba(18,126,214,.16),transparent 62%),linear-gradient(180deg,#020913,#061222 54%,#020913);color:#effaff}
/* The marketing poster is a landing page only. The app home is a true dashboard. */
.ckHome .ckHero{display:none!important}
.audioMixer,.hudstats>.soundBtn,.hudstats>.fullscreenBtn,[data-coach="speak"],.coachSpeak{display:none!important}

/* one-time cover */
.ckLanding{position:fixed;z-index:9999;inset:0;background:#000;display:flex;justify-content:center;overflow:auto;overscroll-behavior:contain;transition:opacity .2s ease,transform .2s ease}
.ckLanding.out{opacity:0;transform:scale(1.015);pointer-events:none}
.ckLandingFrame{position:relative;width:min(100vw,640px);margin:auto;background:#010812;box-shadow:0 0 70px rgba(0,174,255,.16)}
.ckLandingArt{width:100%;aspect-ratio:9/16;background:url(__LANDING_ASSET__) center/100% 100% no-repeat}
.ckLandingStart{position:absolute;left:17%;right:17%;top:72.2%;height:11.2%;border:0;background:transparent;cursor:pointer;border-radius:28px;-webkit-tap-highlight-color:transparent}
.ckLandingStart:focus-visible{outline:3px solid #fff;outline-offset:-4px;box-shadow:0 0 30px var(--ck-cyan)}

/* dashboard header — data, not decoration */
.hudbar.ckDashHud{position:sticky!important;top:0;z-index:80;max-width:640px!important;margin:0 auto!important;min-height:80px!important;padding:calc(8px + env(safe-area-inset-top,0px)) 14px 8px!important;background:linear-gradient(180deg,rgba(3,12,25,.98),rgba(5,18,34,.94))!important;border-bottom:1px solid rgba(57,245,255,.25)!important;box-shadow:0 10px 28px rgba(0,0,0,.24),0 1px 0 rgba(57,245,255,.07) inset!important;backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);display:grid!important;grid-template-columns:minmax(0,1.35fr) minmax(100px,.75fr) auto!important;gap:10px!important;align-items:center!important}
.ckDashHud .brand{min-width:0;gap:9px!important;cursor:pointer;border-radius:14px;padding:3px 5px 3px 2px}
.ckDashHud .brand:active{background:rgba(57,245,255,.07)}
.ckDashHud .ckChick.crown{width:48px!important;height:48px!important;border:2px solid rgba(57,245,255,.85)!important;box-shadow:0 0 0 3px rgba(57,245,255,.08),0 0 20px rgba(57,245,255,.25)!important}
.ckDashHud .brandname{font-size:15px!important;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:#fff!important}
.ckDashHud .brandsub{display:block!important;font:800 11px/1.3 var(--font)!important;color:var(--ck-cyan)!important;margin-top:2px}
.ckDashHud .xpbox{display:flex!important;flex-direction:column!important;align-items:stretch!important;gap:4px!important;min-width:0!important}
.ckDashHud .xpbox>.lv:first-child{font-size:9px!important;letter-spacing:.12em;color:#88a9bd!important}
.ckDashHud .xpbox>.lv:last-child{font-size:10px!important;text-align:right;color:#c5dae6!important}
.ckDashHud .xpbar{width:100%!important;height:7px!important;border:1px solid rgba(57,245,255,.25)!important;background:#061528!important}
.ckDashHud .xpbar i{background:linear-gradient(90deg,#21b8ff,#35f6f3)!important;box-shadow:0 0 12px rgba(57,245,255,.6)}
.ckDashHud .hudstats{display:flex!important;align-items:center!important;gap:6px!important;min-width:0}
.ckDashHud .hudpill{height:35px!important;min-width:50px!important;padding:0 8px!important;border-radius:11px!important;font-size:10px!important;background:#07192c!important;border:1px solid rgba(57,245,255,.22)!important;color:#dcebf3!important;box-shadow:inset 0 0 14px rgba(57,245,255,.04)}
.ckDashHud .hudpill.gold{color:#ffd45a!important}.ckDashHud .hudpill.fire{color:#ff9c68!important}
.ckTopActions{display:flex;gap:5px;align-items:center}
.ckTopBtn{appearance:none;width:36px;height:36px;border-radius:11px;border:1px solid rgba(57,245,255,.28);background:linear-gradient(180deg,#0d2945,#071a2e);color:#dffaff;font:900 17px/1 var(--font);display:grid;place-items:center;box-shadow:inset 0 0 14px rgba(57,245,255,.05);cursor:pointer}
.ckTopBtn:active{transform:scale(.96)}

/* app home closer to the approved mockup */
.ckDashboard{gap:12px!important;padding-top:14px!important;max-width:640px!important}
.ckDashboard .ckProfile{order:0;border:1px solid rgba(72,217,255,.45)!important;background:linear-gradient(145deg,rgba(9,34,59,.98),rgba(4,19,36,.98))!important;border-radius:20px!important;padding:13px!important;box-shadow:0 0 0 1px rgba(28,142,216,.08),inset 0 0 34px rgba(24,132,220,.07),0 13px 34px rgba(0,0,0,.22)!important}
.ckDashboard .ckAvatar{width:68px!important;height:68px!important;border:2px solid var(--ck-cyan)!important;box-shadow:0 0 22px rgba(57,245,255,.23)!important}
.ckDashboard .ckRank{font-size:18px!important}.ckDashboard .ckLv{font-size:16px!important;color:#5df4ff!important}.ckDashboard .ckXp{height:9px!important;border:1px solid rgba(57,245,255,.18)}
.ckDashboard .ckStats{padding-top:12px!important;margin-top:2px!important}.ckDashboard .ckStats b{font-size:20px!important}.ckDashboard .ckStats span{font-size:10px!important}

.ckDashboard .ckFeatures{order:1;display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:8px!important}
.ckDashboard .ckFeat{position:relative;height:184px!important;overflow:hidden!important;padding:13px 10px!important;border-radius:17px!important;border:1px solid rgba(80,207,255,.48)!important;background:linear-gradient(155deg,#0b2846 0%,#071a31 55%,#041323 100%)!important;box-shadow:inset 0 0 30px rgba(44,175,255,.08),0 10px 24px rgba(0,0,0,.18)!important;display:block!important}
.ckDashboard .ckFeat::before{display:block;font-size:25px;line-height:1;margin-bottom:8px;filter:drop-shadow(0 0 12px rgba(57,245,255,.35))}
.ckDashboard .ckFeat:nth-child(1)::before{content:"🎓"}.ckDashboard .ckFeat:nth-child(2)::before{content:"📊"}.ckDashboard .ckFeat:nth-child(3)::before{content:"🏆"}
.ckDashboard .ckFeat::after{content:"";position:absolute;inset:auto -18px -24px 20%;height:92px;background:linear-gradient(135deg,transparent 26%,rgba(57,245,255,.15) 27% 29%,transparent 30% 44%,rgba(57,245,255,.18) 45% 48%,transparent 49% 61%,rgba(57,245,255,.2) 62% 65%,transparent 66%);transform:skewX(-9deg);opacity:.9}
.ckDashboard .ckFeat b{position:relative;z-index:3;display:block;font-size:14px!important;color:#fff;margin-bottom:4px;text-shadow:0 1px 12px rgba(0,0,0,.5)}
.ckDashboard .ckFeat small{position:relative;z-index:3;display:block!important;font-size:9.5px!important;line-height:1.35!important;color:#b4ccda!important;max-width:88%}
.ckDashboard .ckFeatArt{position:absolute!important;z-index:2;right:-5px!important;bottom:-4px!important;width:86px!important;height:86px!important;aspect-ratio:1!important;margin:0!important;border-radius:50%!important;border:0!important;box-shadow:none!important;background-size:cover!important;background-position:center!important;filter:saturate(1.12) contrast(1.04)}
.ckDashboard .ckFeat:nth-child(1) .ckFeatArt{width:96px!important;height:96px!important}.ckDashboard .ckFeat:nth-child(3) .ckFeatArt{width:94px!important;height:94px!important}

/* hot courses: three compact real mission cards */
.ckDashboard .ckSection{order:2}
.ckDashboard .ckSecHead h2{font-size:20px!important;display:flex;gap:8px;align-items:center}.ckDashboard .ckSecHead h2::before{content:"▥";color:var(--ck-cyan);font-size:18px}
.ckDashboard .ckStrip{display:grid!important;grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:8px!important}
.ckDashboard .ckStrip .ckTile{position:relative;display:flex!important;min-height:132px!important;flex-direction:column!important;align-items:flex-start!important;justify-content:flex-end!important;overflow:hidden;border-radius:15px!important;padding:48px 10px 10px!important;background:linear-gradient(160deg,#0b2844,#061629)!important;border:1px solid rgba(64,192,255,.33)!important;box-shadow:inset 0 0 25px rgba(57,245,255,.05)}
.ckDashboard .ckStrip .ckTile::before{content:"";position:absolute;left:9px;right:9px;top:17px;height:35px;background:linear-gradient(90deg,transparent 0 7%,#ff4868 8% 13%,transparent 14% 27%,#34e3b4 28% 35%,transparent 36% 52%,#ff4868 53% 61%,transparent 62% 75%,#36dfb6 76% 84%,transparent 85%),linear-gradient(180deg,transparent 48%,rgba(57,245,255,.18) 49% 51%,transparent 52%);opacity:.92}
.ckDashboard .ckStrip .ckTileNum{position:absolute;left:8px;top:8px;width:auto!important;height:auto!important;padding:3px 7px!important;border-radius:8px!important;font-size:10px!important;background:#096a9a!important;color:#e6fbff!important;border-color:#33c8ff!important;z-index:2}
.ckDashboard .ckStrip .ckTileTxt{position:relative;z-index:2;width:100%}.ckDashboard .ckStrip .ckTileTxt b{font-size:12px!important;white-space:normal!important;line-height:1.25}.ckDashboard .ckStrip .ckTileTxt small{font-size:9px!important;white-space:normal!important;line-height:1.25;margin-top:3px}.ckDashboard .ckStrip .ckTileState{display:none!important}
.ckDashboard .ckMods,.ckDashboard .ckPremium,.ckDashboard>.legal{order:4}.ckDashboard .ckMods{gap:7px!important}

/* bottom nav: solid, app-like, safe-area aware */
.ckNav{max-width:640px;margin:0 auto;left:50%!important;right:auto!important;transform:translateX(-50%);width:min(100%,640px);background:rgba(3,12,26,.975)!important;border:1px solid rgba(57,245,255,.18)!important;border-bottom:0!important;border-radius:18px 18px 0 0;box-shadow:0 -16px 35px rgba(0,0,0,.28),inset 0 1px rgba(255,255,255,.02)!important;padding-top:6px!important}
.ckNavBtn{min-height:58px!important;font-size:10px!important}.ckNavIc{font-size:22px!important}.ckNavBtn.on{background:linear-gradient(180deg,rgba(57,245,255,.13),rgba(57,245,255,.04))!important;box-shadow:inset 0 2px 0 rgba(57,245,255,.42)}

/* settings / help / profile sheets */
.ckUiModal{position:fixed;z-index:10000;inset:0;display:flex;align-items:flex-end;justify-content:center;padding:18px max(10px,env(safe-area-inset-right,0px)) calc(12px + env(safe-area-inset-bottom,0px)) max(10px,env(safe-area-inset-left,0px))}
.ckUiShade{position:absolute;inset:0;background:rgba(0,5,14,.72);backdrop-filter:blur(7px);-webkit-backdrop-filter:blur(7px)}
.ckUiSheet{position:relative;width:min(100%,600px);max-height:min(82dvh,760px);overflow:auto;border:1px solid rgba(57,245,255,.42);border-radius:24px;background:linear-gradient(180deg,#0a2038,#051322 72%,#04101d);box-shadow:0 28px 80px rgba(0,0,0,.58),inset 0 0 40px rgba(57,245,255,.045);padding:18px}
.ckUiSheet>header{display:flex;align-items:center;justify-content:space-between;gap:12px;border-bottom:1px solid rgba(57,245,255,.13);padding-bottom:12px;margin-bottom:14px}.ckUiSheet h2{margin:2px 0 0;font:950 24px/1.15 var(--font);color:#fff}.ckUiEyebrow{font:900 9px var(--mono);letter-spacing:.14em;color:var(--ck-cyan)}
.ckUiClose{width:38px;height:38px;border-radius:12px;border:1px solid rgba(57,245,255,.2);background:#081a2d;color:#dffaff;font-size:25px;line-height:1;cursor:pointer}.ckUiBody{display:flex;flex-direction:column;gap:12px}
.ckSetList{display:flex;flex-direction:column;gap:8px}.ckSetRow{appearance:none;width:100%;display:grid;grid-template-columns:42px minmax(0,1fr) auto;align-items:center;gap:10px;padding:11px;border:1px solid rgba(57,245,255,.16);border-radius:15px;background:#071a2e;color:#eaf9ff;text-align:left}.ckSetRow:not(.static){cursor:pointer}.ckSetIcon{width:40px;height:40px;display:grid;place-items:center;border-radius:12px;background:rgba(57,245,255,.08);color:var(--ck-cyan);font-size:19px}.ckSetRow b{display:block;font-size:14px}.ckSetRow small{display:block;color:#89a8ba;font-size:10px;margin-top:3px;line-height:1.35}.ckSetRow i{font:900 11px var(--font);font-style:normal;color:#8ca6b6;border:1px solid rgba(255,255,255,.12);border-radius:99px;padding:5px 9px}.ckSetRow i.on{color:#07151e;background:var(--ck-cyan);border-color:var(--ck-cyan)}
.ckSetActions{display:grid;grid-template-columns:1fr 1fr;gap:8px}.ckDanger{border:1px solid rgba(255,83,103,.4);border-radius:14px;background:rgba(255,70,94,.08);color:#ff9ca8;font:900 12px var(--font);cursor:pointer}.ckFine{margin:0;color:#648396;font-size:10px;line-height:1.45}
.ckHelpHero{padding:14px;border-radius:16px;background:linear-gradient(135deg,rgba(28,148,230,.16),rgba(57,245,255,.05));border:1px solid rgba(57,245,255,.18)}.ckHelpHero b{display:block;font-size:16px;color:#fff}.ckHelpHero span{display:block;margin-top:4px;color:#9fbbc9;font-size:11px}.ckHelpGrid{display:grid;gap:8px}.ckHelpGrid article{display:grid;grid-template-columns:38px 1fr;gap:10px;padding:10px;border-radius:14px;background:#07182a;border:1px solid rgba(57,245,255,.12)}.ckHelpGrid article>strong{font:950 16px var(--mono);color:var(--ck-cyan)}.ckHelpGrid b{font-size:13px;color:#fff}.ckHelpGrid p,.ckInfoBox p{margin:3px 0 0;color:#91adbd;font-size:10.5px;line-height:1.45}.ckInfoBox{padding:12px;border-radius:14px;border:1px solid rgba(255,207,63,.22);background:rgba(255,207,63,.045)}.ckInfoBox b{color:#ffd45a}
.ckProfileHero{display:flex;gap:14px;align-items:center;padding:6px 2px 12px}.ckProfileBig{width:86px;height:86px;border:2px solid var(--ck-cyan)!important;box-shadow:0 0 28px rgba(57,245,255,.25)!important}.ckProfileHero h3{margin:3px 0 4px;font-size:22px;color:#fff}.ckProfileHero b{display:block;color:var(--ck-cyan)}.ckProfileHero small{color:#91adbd}.ckRecordGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.ckRecordGrid div{padding:12px;border-radius:14px;background:#071a2d;border:1px solid rgba(57,245,255,.14)}.ckRecordGrid b{display:block;font:900 17px var(--mono);color:#fff}.ckRecordGrid span{font-size:10px;color:#84a4b8}

@media(max-width:430px){
 .hudbar.ckDashHud{grid-template-columns:minmax(0,1.2fr) 82px auto!important;padding-left:10px!important;padding-right:8px!important;gap:6px!important}.ckDashHud .ckChick.crown{width:43px!important;height:43px!important}.ckDashHud .brandname{font-size:13px!important}.ckDashHud .brandsub{font-size:9px!important}.ckDashHud .hudpill.fire{display:none!important}.ckDashHud .hudpill{min-width:42px!important;padding:0 6px!important}.ckTopBtn{width:34px;height:34px}
 .ckDashboard{padding-left:10px!important;padding-right:10px!important}.ckDashboard .ckFeat{height:166px!important;padding:11px 8px!important}.ckDashboard .ckFeat b{font-size:12px!important}.ckDashboard .ckFeat small{font-size:8.5px!important}.ckDashboard .ckFeatArt{width:74px!important;height:74px!important}.ckDashboard .ckFeat:nth-child(1) .ckFeatArt,.ckDashboard .ckFeat:nth-child(3) .ckFeatArt{width:80px!important;height:80px!important}.ckDashboard .ckStrip .ckTile{min-height:121px!important;padding-left:8px!important;padding-right:8px!important}.ckDashboard .ckStrip .ckTileTxt b{font-size:10.5px!important}.ckDashboard .ckStrip .ckTileTxt small{font-size:8px!important}
}
@media(max-width:360px){.ckDashboard .ckFeatures{gap:5px!important}.ckDashboard .ckFeat small{display:none!important}.ckDashboard .ckFeat{height:145px!important}.ckDashHud .xpbox{display:none!important}.hudbar.ckDashHud{grid-template-columns:minmax(0,1fr) auto!important}}
@media(orientation:landscape) and (max-height:520px){.ckLandingFrame{width:min(360px,45vw)}.ckDashboard .ckFeatures{grid-template-columns:repeat(3,1fr)!important}.ckUiModal{align-items:center}.ckUiSheet{max-height:92dvh}}
