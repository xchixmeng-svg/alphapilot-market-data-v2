/* 成為股神 V3 — complete learning map */
(function(root){
'use strict';
var WORLDS=[
 {id:1,code:'VISION',title:'讀懂價格',sub:'先看懂一根 K，再看懂一段價格',accent:'#39f5ff'},
 {id:2,code:'STRUCTURE',title:'看懂結構',sub:'高低點、趨勢與結構改變',accent:'#8d7cff'},
 {id:3,code:'LOCATION',title:'看懂位置',sub:'支撐、壓力、區間與突破',accent:'#ffcc57'},
 {id:4,code:'TOOLS',title:'使用工具',sub:'均線、乖離與波動',accent:'#42dfff'},
 {id:5,code:'SETUPS',title:'辨識機會',sub:'量價、回檔、突破與追高',accent:'#57f0a5'},
 {id:6,code:'RISK',title:'做出決策',sub:'失策、風報比、部位與出場',accent:'#ff6680'}
];
function M(id,world,title,sub,skill,objective,rule,anti,focus){return{id:id,world:world,title:title,sub:sub,skill:skill,objective:objective,rule:rule,anti:anti,focus:focus};}
var MISSIONS=[
 M(1,1,'一天四個價格','開盤、最高、最低、收盤','OHLC','先知道一根 K 棒到底由哪四個價格組成。','開＝第一筆附近；高＝當日最高；低＝當日最低；收＝最後成交附近。','不要先猜漲跌，先把四個價格認對。','candle'),
 M(2,1,'K 棒實體','實體其實只是在畫開盤到收盤','BODY','看懂 K 棒中間粗的部分代表什麼。','實體＝開盤與收盤之間的距離。','最高到最低不是實體，那是整天波動範圍。','candle'),
 M(3,1,'紅 K 與綠 K','顏色只比較今天開盤與收盤','COLOR','只用開盤與收盤判斷 K 棒顏色。','收盤高於開盤＝紅 K；收盤低於開盤＝綠 K。','K 棒顏色不等於今天相對昨收的漲跌。','candle'),
 M(4,1,'上影與下影','價格曾去過，但最後沒有收在那裡','WICK','看懂影線在描述盤中被拉回的痕跡。','上影＝曾更高又被壓回；下影＝曾更低又被拉回。','影線是線索，不是單獨買進訊號。','candle'),
 M(5,1,'K 棒顏色 ≠ 日漲跌','今天漲，仍可能收綠 K','DAYCHANGE','把「收盤 vs 開盤」與「收盤 vs 昨收」分開。','K 色看開收；日漲跌看今日收盤與昨日收盤。','不要看到綠 K 就說今天一定跌。','candle'),
 M(6,1,'從一根看到一段','價格不是一根 K 在走','SEQUENCE','開始觀察連續幾根 K 的收盤位置。','先比較最近幾天的高低與收盤是否逐步上移或下移。','單根長紅、長綠都不足以定義趨勢。','trend'),
 M(7,2,'找出近期高點','先會找，之後才談 HH','SWING_HIGH','在一段走勢中找出明顯波峰。','左右價格都比較低的區域，常形成局部高點。','不要把每一根小高點都當成重要波峰。','trend'),
 M(8,2,'高點有沒有墊高','第二個高點比第一個更高嗎？','HIGHER_HIGH','比較兩個重要高點。','後一個重要高點更高＝高點墊高。','先比較位置，不必急著背 HH。','trend'),
 M(9,2,'低點有沒有墊高','低點往上，代表買方守得更高','HIGHER_LOW','比較兩個重要低點。','後一個重要低點更高＝低點墊高。','跌一天不代表低點結構已經破壞。','trend'),
 M(10,2,'下降結構','高點降低、低點也降低','DOWNTREND','辨識偏空結構。','高點降低 + 低點降低＝下降結構。','跌很多不代表自動到底。','trend'),
 M(11,2,'盤整不是沒用','高低點互相重疊，就是資訊','RANGE','辨識沒有明確趨勢的區間。','高低點反覆重疊、沒有持續墊高或降低＝盤整。','盤整時不要硬說一定多或一定空。','trend'),
 M(12,2,'結構真的改變了嗎','從「正在跌」到「不再破底」','STRUCTURE_SHIFT','理解趨勢改變需要價格結構證據。','先停止破底，再突破前一個重要高點，結構才有較明確改變。','「跌久了」不是反轉證據。','trend'),
 M(13,3,'價格在哪裡常被接住','先看現象，再叫它支撐','SUPPORT','找到價格多次停止下跌的區域。','價格多次到附近就出現反應，形成支撐區。','支撐是區域，不是精準到一毛的神奇線。','zones'),
 M(14,3,'價格在哪裡常被壓回','這就是壓力區','RESISTANCE','找到價格多次停止上漲的區域。','價格多次到附近就遇到賣壓，形成壓力區。','前高附近要先問上方還有多少空間。','zones'),
 M(15,3,'區間的上緣與下緣','同一個盤整，位置可以完全不同','RANGE_EDGE','知道同一個區間裡，高位與低位的風險不同。','靠近下緣與靠近上緣，風險報酬不同。','不要在區間上緣把「快突破」當作一定突破。','zones'),
 M(16,3,'碰到壓力 vs 真突破','站上去，才跟碰到不一樣','BREAKOUT','分辨觸碰與有效突破。','收盤站上近期壓力，才比單純盤中刺過更有突破意義。','一根影線穿過不等於有效突破。','entry'),
 M(17,3,'假突破','突破後又跌回區間，就是警訊','FALSE_BREAKOUT','辨識突破失敗。','站上壓力後快速跌回區間，突破品質下降。','不要只因為曾經突破就一直認定它仍強。','entry'),
 M(18,3,'突破後回測','最強不一定是最好的買點','RETEST','理解突破後回到原壓力附近測試支撐。','原壓力被突破後，回測不破可能轉成支撐。','回測失守，就不能假裝突破仍有效。','entry'),
 M(19,4,'MA20 是什麼','把最近 20 天平均位置畫成一條線','MA20_ID','先認得 MA20 與它的用途。','MA20 是近 20 個交易日收盤價的移動平均。','均線是工具，不是自動買進按鈕。','ma20'),
 M(20,4,'股價在 MA20 上還是下','先學位置，不急著談好壞','MA20_SIDE','比較目前收盤與 MA20。','收盤高於 MA20＝在均線上方；低於則在下方。','在上方不代表一定會漲。','ma20'),
 M(21,4,'離 MA20 近還是遠','建立乖離的視覺感','MA20_DISTANCE','判斷價格是否已離短期平均太遠。','距離越大，追價風險通常越高；先看百分比再判斷。','不要只看線的畫面距離，價格尺度不同會騙眼睛。','ma20'),
 M(22,4,'MA20 自己在往哪裡走','均線斜率也是資訊','MA20_SLOPE','辨識 MA20 上彎、走平、下彎。','今天 MA20 比幾天前高＝偏上；低＝偏下。','股價一天站上均線，不等於均線趨勢已翻多。','ma20'),
 M(23,4,'加入 MA60','短期與中期位置一起看','MA_STACK','理解 MA20 與 MA60 的相對位置。','價格 > MA20 > MA60 且兩線向上，通常比亂序更整齊。','均線多頭排列仍不能取代位置與風險判斷。','ma'),
 M(24,4,'波動不是每檔都一樣','ATR 幫你量「平常一天會晃多少」','ATR','建立波動尺度。','ATR / 股價越高，代表日常波動相對越大。','高波動股不能用跟低波動股完全相同的停損距離。','volatility'),
 M(25,5,'成交量先看大小','量是市場參與程度','VOLUME','先會比較近期量能大小。','今天量與近 20 日平均量相比，才知道算放量或縮量。','只看絕對張數沒有意義，不同股票基準不同。','volume'),
 M(26,5,'量價一起看','價格與成交量必須合在一起','PRICE_VOLUME','讀懂漲跌與量能的組合。','突破配合放量通常比無量突破更值得重視；回檔縮量也常比爆量下跌健康。','放量本身不是利多，方向與位置更重要。','volume'),
 M(27,5,'回檔買點','強勢結構裡，等價格回到較舒服的位置','PULLBACK','辨識順勢回檔。','上升結構 + 回到支撐/MA20 附近 + 沒有破壞結構，是常見回檔觀察條件。','下降趨勢中的下跌，不叫順勢回檔買點。','entry'),
 M(28,5,'突破買點','突破的重點是「突破什麼」','BREAKOUT_SETUP','辨識有意義的突破。','整理後站上明確壓力，且位置沒有過度延伸，才值得研究。','沒有壓力區就談不上有效突破。','entry'),
 M(29,5,'突破回測買點','讓市場先證明突破有效','RETEST_SETUP','辨識突破後回測不破的機會。','突破 → 回測原壓力 → 守住再轉強，是較完整的回測結構。','跌回原區間太深，代表突破可能失敗。','entry'),
 M(30,5,'什麼位置不要追','看起來最強，不等於風險最好','NO_CHASE','學會放棄乖離過大、壓力太近的交易。','離 MA20 太遠、剛爆量急拉、上方壓力很近時，寧可錯過。','「怕錯過」不是買進理由。','avoid'),
 M(31,6,'失策點','跌到哪裡代表你的理由錯了','INVALIDATION','把停損改成「論點失效」。','回檔買點的失策常在關鍵支撐/結構低點下方，而不是固定 -5%。','停損不能只因為不想賠錢而亂放。','stop'),
 M(32,6,'先看上方空間','目標不是許願，是下一個壓力','TARGET','用已知壓力規劃合理空間。','先找下一個明顯壓力，再估可能報酬。','目標價不是你想賺 15% 就填 15%。','exit'),
 M(33,6,'風險報酬','先算值得不值得冒這個風險','RR','把目標空間與失策距離放在一起。','R:R = 潛在報酬 / 潛在風險；同樣勝率下，空間越好越值得研究。','只看「會不會漲」會忽略買點品質。','full'),
 M(34,6,'部位大小','先決定最多能賠，再決定買幾股','POSITION','建立帳戶風險概念。','失策距離越大，在固定帳戶風險下可買股數就越少。','不能因為更看好就無限放大部位。','full'),
 M(35,6,'續抱還是退出','不是持有第幾天，而是理由還在不在','HOLD_EXIT','學會用結構與失策管理持有。','理由未失效可續抱；跌破失策或突破失敗就應重新評估/退出。','不要用固定第 20 天、第 30 天代替判斷。','exit'),
 M(36,6,'完整掃描','趨勢 → 位置 → 量價 → 失策 → 空間','FULL_SCAN','把前面所有技能串成一個固定掃描順序。','先判斷環境，再看位置，再找失策與空間，最後才決定要不要出手。','不必每張圖都交易；看不懂或風報比差，就是有效的「不做」。','full')
];
root.BSG_CONTENT={WORLDS:WORLDS,MISSIONS:MISSIONS,FREE_THROUGH:6,PRODUCT_PRICE_TWD:190};
})(window);
