/* 成為股神 V2 — 看盤駕訓課程 */
(function (root) {
  'use strict';
  var LESSONS = [
    {
      n:1, title:'先看懂一根 K 線', sub:'開、高、低、收不是四個數字，是一天多空拉鋸的結果', demo:'candle',
      intro:'先不要急著猜漲跌。第一步只做一件事：看懂價格今天從哪裡開始、曾到哪裡、最後收在哪裡。',
      look:['紅 K：收盤高於開盤；綠 K：收盤低於開盤（台股配色）','上影線代表價格曾往上，但收盤前被壓回；下影線代表曾往下，但被拉回','單根 K 棒只能描述「這一天」，不能單獨當買進訊號'],
      can:['先比較收盤位置：靠近高點、中央、還是低點','再放回前後 10～20 根 K 棒裡看位置'],
      avoid:['看到一根長紅就直接追','看到下影線就認定一定止跌'],
      quiz:{q:'一根長紅 K 出現時，最合理的第一個動作是？', o:['直接買，因為多方很強','先看它出現在趨勢哪個位置，再判斷','等隔天如果再紅才一定買'], a:1, e:'K 棒必須放回「位置＋前後結構」解讀，不能脫離背景。'}
    },
    {
      n:2, title:'先判斷趨勢，再談買點', sub:'高點與低點的方向，比猜明天漲跌重要', demo:'trend',
      intro:'趨勢不是「最近幾天有漲」。上升趨勢要看到高點逐步墊高、低點也逐步墊高；下降趨勢則相反。',
      look:['高點更高 + 低點更高：偏多結構','高點更低 + 低點更低：偏空結構','高低點互相重疊：盤整，先別硬套趨勢'],
      can:['偏多時找回檔或整理後再轉強的位置','盤整時等區間邊界或突破確認'],
      avoid:['下降趨勢只因為跌很多就接','把一兩根反彈 K 棒當成趨勢反轉'],
      quiz:{q:'「跌很久了，所以應該到底了」最大的問題是？', o:['沒有定義價格結構何時真的改變','跌很久的股票成交量一定小','只要跌超過 20% 就不能買'], a:0, e:'便宜不是反轉條件。先找結構停止破底，再談買點。'}
    },
    {
      n:3, title:'支撐與壓力要看「區域」', sub:'不是神奇的一條線，而是過去大量買賣反覆發生的位置', demo:'zones',
      intro:'同一個價位附近如果多次出現轉折，它比較像一個區域，而不是精準到 0.1 元的一條線。',
      look:['前高附近：容易遇到賣壓','前低或突破後回測區：可能形成支撐','碰越多次、成交越集中，越值得注意，但也不是保證'],
      can:['進場前先問：上方最近的壓力在哪？','停損要放在「支撐真正失守後」，而不是剛好貼著支撐'],
      avoid:['在壓力正下方追高，卻只剩很小上漲空間','把支撐當成一定不會跌破的保證'],
      quiz:{q:'股價距離上方前高只剩 2%，合理停損卻要 6%，最重要的問題是？', o:['K 棒顏色不夠紅','風險報酬可能不划算','一定要把停損改近'], a:1, e:'買點不是只看會不會漲，也要看「能賺多少、錯了要付多少」。'}
    },
    {
      n:4, title:'成交量要跟價格一起看', sub:'量本身不是答案，它告訴你這次移動有多少參與', demo:'volume',
      intro:'同樣上漲 5%，放量突破與無量飄上去不是同一件事。量價要一起看。',
      look:['突破壓力同時量增：代表參與度提高','整理時量縮：代表買賣雙方暫時降溫','爆量卻收不高或留下長上影：要小心大量換手與賣壓'],
      can:['比較 5 日量與 20 日量，而不是只看單日絕對數字','突破後看量能是否能延續或至少價格守住'],
      avoid:['只因為「今天爆量」就買','把任何量縮都解讀成好事'],
      quiz:{q:'價格突破前高，但爆出大量後收回前高下方，較合理的態度是？', o:['突破一定成功，直接追','先視為可能假突破，觀察是否重新站回','量越大越安全'], a:1, e:'有量不代表一定偏多；突破失敗時，大量反而可能代表高檔換手。'}
    },
    {
      n:5, title:'均線是位置尺，不是買進按鈕', sub:'MA20 / MA60 幫你看趨勢與乖離，但不能取代結構', demo:'ma',
      intro:'均線把一段時間的平均成本平滑化。它適合拿來看方向與價格是否離近期平均太遠。',
      look:['價格在 MA20、MA60 上方且均線向上：偏多背景','價格離 MA20 太遠：即使很強，也可能已經不適合追','回到均線附近後是否守住，要搭配支撐與 K 線結構看'],
      can:['用均線判斷「現在離平均位置多遠」','把均線和前高前低、量價一起看'],
      avoid:['碰 MA20 就無條件買','跌破一點 MA20 就無條件賣'],
      quiz:{q:'股價已離 MA20 很遠又連漲數日，最合理的是？', o:['因為強勢所以更應該追','先評估乖離與停損距離，可能等待更好位置','MA20 沒用，完全忽略'], a:1, e:'強勢與好買點是兩件事。好股票也可能有很差的進場位置。'}
    },
    {
      n:6, title:'三種常見買點：回檔、突破、突破回測', sub:'不是找「一定漲」，而是找可以定義風險的位置', demo:'entry',
      intro:'你不是等到完全確定才買；你要找的是「理由足夠、錯了也知道在哪裡」的位置。',
      look:['回檔：原本偏多，回到支撐附近後停止轉弱','突破：價格有效穿越整理上緣，而且沒有離突破點太遠','突破回測：突破後回到原壓力區，守住再轉強'],
      can:['先標出失策點，再看進場價是否仍有合理空間','D1 開盤若超過你預先接受的價格，直接放棄'],
      avoid:['等漲了很多天「終於確定」才追','沒有失策點就先買再說'],
      quiz:{q:'你 D0 規劃最多接受 +2% 跳空，D1 開盤 +7%，最符合紀律的動作？', o:['因為更強所以買更多','放棄本題，不等幾天再偷看後追','等 D3 確定繼續漲再買'], a:1, e:'進場窗口失效就放棄。不能用更多未來資訊替原本決策補考。'}
    },
    {
      n:7, title:'哪些位置不該買', sub:'真正的進步，常常是學會不出手', demo:'avoid',
      intro:'很多虧損不是看錯公司，而是買的位置讓你沒有退路。',
      look:['連續急漲、離 MA20 過遠','正好撞到明顯前高壓力','合理停損太遠，導致風險報酬差','D1 開盤遠超原計畫'],
      can:['把「不買」當成完整決策，不是錯失機會','接受放棄後它仍可能大漲；好決策不等於每次都抓到行情'],
      avoid:['因為怕錯過就放寬原本進場條件','放棄後看到上漲，再在 D3/D4 追回'],
      quiz:{q:'你放棄後股票三天漲 15%，這是否證明原本放棄一定錯？', o:['是，結果漲就代表決策錯','不是，要回到當時可見資訊與風險條件評價','只要賺錢的做法都對'], a:1, e:'V2 會把「結果」和「決策品質」分開評價。'}
    },
    {
      n:8, title:'停損不是固定 −5%，是「我看錯的位置」', sub:'先定義失策，再算你能買多少', demo:'stop',
      intro:'停損最好對應交易理由失效的位置，例如突破跌回原區間、支撐明確失守，而不是每檔都固定同一百分比。',
      look:['停損應在進場前決定','ATR 用來檢查停損是否太貼近正常波動','跳空跌破停損時，只能接受開盤成交的更差價格'],
      can:['先找結構失策點，再用 ATR 檢查合理性','用最大可承受損失反推股數'],
      avoid:['虧損後才把停損往下移','為了買更多股，把停損硬縮到正常波動內'],
      quiz:{q:'買進後價格接近停損，你最不該做的是？', o:['重新檢查原交易理由是否仍成立','因為不想認賠就把停損往下移','接受原本失策條件被觸發'], a:1, e:'停損往下移會把「原本錯了就走」變成沒有規則。'}
    },
    {
      n:9, title:'賣點看理由失效，不看第幾天', sub:'時間本身不是賣出理由', demo:'exit',
      intro:'好趨勢可能第 20 天才剛開始；壞交易也可能第 4 天就已經失策。V2 不再使用「D21 強制賣出」。',
      look:['趨勢結構是否仍維持','原支撐、突破區是否被有效跌破','到達壓力/目標後，有沒有出現轉弱訊號','移動停損只上移，不往下放寬'],
      can:['理由仍成立就繼續持有','理由失效就退出，不因為尚未持有滿某個天數而拖延'],
      avoid:['只因為賺 5% 就固定全部賣掉','只因為「已經抱 20 天」就賣'],
      quiz:{q:'一筆交易第 25 天仍維持高低點墊高、支撐未破，哪個理由最不適合單獨拿來賣？', o:['原交易結構破壞','移動停損被觸發','已經持有 25 天'], a:2, e:'持有天數不是價格失策。時間停損只有在你原本策略就定義「多久沒發動算失敗」時才合理。'}
    },
    {
      n:10, title:'完整判斷：看懂 → 找位置 → 定義錯誤 → 才下單', sub:'把提示拿掉，開始真正的混合實戰', demo:'full',
      intro:'最後一課不再告訴你這題是在考什麼。你要自己判斷趨勢、位置、量價、風險與是否值得出手。',
      look:['先回答：現在是什麼結構？','再回答：如果要買，合理買在哪裡？','再回答：跌到哪裡代表我錯？','最後才算部位，不讓單筆失誤傷到整個帳戶'],
      can:['看不懂可以選「看不懂」；真正實戰本來就不是每天都要買','做完 10 課後進入 400 題亂數實戰'],
      avoid:['看到課名猜答案','為了每題都有動作而硬交易'],
      quiz:{q:'完整交易決策的正確順序較接近哪一個？', o:['先決定買幾張 → 再找理由','先看結構與位置 → 定義失策 → 評估風報比 → 決定部位','先猜明天漲跌 → 漲就追'], a:1, e:'V2 的核心就是把這個順序練到變成習慣。'}
    }
  ];
  root.BSG_CONTENT = { LESSONS: LESSONS };
})(window);
