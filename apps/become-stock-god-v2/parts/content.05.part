
// ═════════════ 100-lesson curriculum (curriculumVersion 2) ═════════════
// Permanent ids never change: completion records stay keyed by id (1..63 are the original lessons,
// 64..100 are new). What the player sees is displayNo 01..100, derived from the teaching order below.
(function(root){
  'use strict';
  var CT=root.BSG_CONTENT;if(!CT)return;
  CT.CURRICULUM_VERSION=2;
  var MODULES=[
    [1,'PRICE','讀懂價格','先看懂一根 K，再看懂一段價格','#39f5ff'],
    [2,'STRUCTURE','看懂結構','時間週期、高低點、趨勢與結構改變','#8d7cff'],
    [3,'LOCATION','看懂位置','支撐、壓力、區間、突破與回測','#ffcc57'],
    [4,'TOOLS','使用工具','均線、乖離與波動','#42dfff'],
    [5,'SETUPS','辨識機會','量價、回檔、突破與三種進場','#57f0a5'],
    [6,'DECISION','做出決策','失策、空間、風報比、部位與出場','#ff6680'],
    [7,'INDICATORS','讀懂指標','MACD、KD、RSI 怎麼用、怎麼失效','#c58cff'],
    [8,'PRACTICE','技術面實戰','自己畫線、確認反轉、逐日判斷','#ffb45b'],
    [9,'ORDERS','從看圖到真的下單','股票、成交單位、下單、成本與公司行動','#4fd1ff'],
    [10,'MARKET','看懂市場環境','大盤、產業、相對強弱、廣度與流動性','#7ee0a0'],
    [11,'CATALYST','看懂題材、新聞與資金','時間軸、消息來源、預期差、法人與資金','#ffa95c'],
    [12,'COMPANY','看懂公司','營收、毛利、營益、EPS、現金流、負債與估值','#9fb4ff'],
    [13,'SELF','管理風險與自己','分散、總風險、攤平、過程品質與交易日誌','#ff7fa8'],
    [14,'GRADUATION','綜合畢業實戰','三層掃描、四種證據、完整交易計畫','#ffd44a']
  ];
  CT.WORLDS.length=0;
  MODULES.forEach(function(a){CT.WORLDS.push({id:a[0],code:a[1],title:a[2],sub:a[3],accent:a[4]});});

  // [displayNo order] → permanent id, grouped by module (spec v2, 2026-10-21)
  var PLAN=[
    [1,[1,2,3,4,5,51,38,6]],
    [2,[37,7,8,9,10,11,52,12]],
    [3,[13,14,15,53,16,17,54,18,55]],
    [4,[19,20,21,22,23,24]],
    [5,[25,26,56,57,27,28,29,63,30]],
    [6,[31,32,33,58,34,35,36]],
    [7,[39,40,41,59,42,43,60,44,61,45,46]],
    [8,[47,48,62,49,50]],
    [9,[64,65,66,67,68,69,70]],
    [10,[71,72,73,74,75,76,77]],
    [11,[78,79,80,81,82,83,84,85]],
    [12,[86,87,88,89,90,91,92]],
    [13,[93,94,95,96,97]],
    [14,[98,99,100]]
  ];
  function mission(m){if(!CT.MISSIONS.some(function(x){return x.id===m.id;}))CT.MISSIONS.push(m);}
  // New lessons 64..100 — concept lessons played by the case player (app.0390). Content lives in content.06.
  [
    [64,'你買的是公司的一小部分','股票不是一串代碼，而是公司的股份','SHARE','知道股票、公司、股數與市值的關係。','股價 × 流通股數 ≈ 市值；買股票就是持有公司的一小部分。','股價高低不代表公司大小。'],
    [65,'一張、零股與成交單位','台股一張 1,000 股，零股也能買','LOT','會把預算換算成能買幾張、幾股。','1 張 = 1,000 股；不到一張用零股買，金額 = 股價 × 股數。','看到股價 50 元不是花 50 元就能買一張。'],
    [66,'限價、市價與成交','你下單的價格，不一定就是成交價','ORDER','分清楚委託價、委買委賣價與成交價。','限價：最多出這個價；市價：照當下對手價成交；買進看賣方掛的價（Ask）。','掛了價格不代表一定成交。'],
    [67,'五檔不是水晶球','掛單會撤，五檔只能告訴你現在','BOOK','知道五檔是「此刻的掛單」，不是預測。','五檔顯示目前最好的五個委買／委賣價與張數；掛單可以隨時撤。','看到大掛單不代表一定會漲或跌。'],
    [68,'漲跌停與買不到／賣不掉','有價格，不代表你一定成交得到','LIMIT','理解漲跌停鎖住時的成交風險。','台股一般股票單日漲跌幅限制 10%；鎖漲停可能買不到，鎖跌停可能賣不掉。','停損設在跌停鎖住的價位，不一定賣得出去。'],
    [69,'成本先算進去','手續費與交易稅會吃掉報酬','COST','會算扣掉手續費與證交稅後的真正損益。','真正損益 = 賣出金額 − 買進金額 − 買賣手續費 − 證交稅。','小價差的頻繁交易，可能全被成本吃掉。'],
    [70,'除權息、分割與還原價','圖上突然跳，不一定真的暴跌','CORP_ACTION','分辨公司行動造成的價格跳動與真正的下跌。','除息：股價扣掉發放的現金；除權：扣掉配股價值；還原價把這些調整回去再比較。','除息日股價變低，不等於股東虧錢。'],
    [71,'先看大盤在幹嘛','同一檔股票，順風與逆風差很多','MARKET_TREND','先判斷大盤處在什麼環境，再看個股。','先看大盤結構：上升、下降或盤整，再決定個股訊號要打幾折。','個股訊號再漂亮，也不能假裝大盤不存在。'],
    [72,'個股要跟大盤比','漲 2% 不一定叫強','RELATIVE','用相對報酬判斷強弱。','相對強弱 = 個股報酬 − 大盤報酬；大盤 +4%、個股 +2% 是相對弱。','不要只看個股自己漲多少。'],
    [73,'再跟同產業比','真正的強弱，要跟同類股票比較','SECTOR_RS','建立大盤 → 產業 → 個股三層比較。','個股要同時和大盤、同產業比；產業一起漲時，個股只是跟著漲。','同產業都漲，不代表這檔特別強。'],
    [74,'強勢不是一天漲最多','持續領先，比單日暴衝更有意義','PERSIST','分辨持續相對強勢與單日暴衝。','看一段時間的相對報酬是否持續領先，而不是只看某一天。','單日漲停不等於真正的強勢股。'],
    [75,'市場廣度','指數沒說完的事，上下跌家數會補充','BREADTH','用上漲／下跌家數補充指數看不到的資訊。','指數上漲但下跌家數更多，代表上漲集中在少數權值股。','廣度不是預測公式，是環境的補充證據。'],
    [76,'量能與流動性','想得到怎麼買，也要想得到怎麼賣','LIQUIDITY','分辨成交量、成交金額與流動性。','成交金額 = 股數 × 價格；低價股量大不代表錢多；部位要小於平常成交金額的一小部分。','成交量很大不等於流動性一定好。'],
    [77,'大盤 → 產業 → 個股','先看環境，再決定這檔值不值得做','TOP_DOWN','用三層順序完成一次環境判斷。','先大盤、再產業、最後個股；三層都順，才把個股訊號當真。','跳過環境直接看個股，容易逆風操作。'],
    [78,'題材只是催化','有故事，不等於股價一定會漲','CATALYST','知道題材要看價格有沒有反應、反應到哪裡。','同一個題材，有的已漲完、有的剛反應、有的不動；題材要配合價格與位置。','聽到題材就買，常買在別人賣的地方。'],
    [79,'先問市場何時知道','發布時間，比新聞標題更重要','AVAILABLE_AT','只用當時已經公開的資訊做判斷。','每則資訊都要問：幾點公開？在那之前的價格不可能因它而動。','用收盤後才公開的消息解釋盤中走勢，是倒果為因。'],
    [80,'消息來源有等級','官方公告、媒體與社群不能混著看','SOURCE','分辨資訊來源的可信度。','正式公告 > 主管機關 > 可信媒體 > 分析評論 > 論壇傳聞；等級越低越要查證。','社群說的不一定錯，但不能當成事實。'],
    [81,'利多不漲，利空不跌','市場常常早就先反應','EXPECTATION','理解「預期差」：結果和預期的差距才會動價格。','大家早就預期的好消息，公布時可能不再漲；比預期好或差才有新資訊。','好消息不等於股價一定要漲。'],
    [82,'新聞領先還是落後','漲完才出新聞，別把結果當成原因','NEWS_LAG','判斷新聞出現前價格是否已先動。','先看新聞時間點之前的走勢；價格先大漲、新聞才出現，新聞是在解釋結果。','漲完的新聞不是買進理由。'],
    [83,'法人買賣超怎麼看','單日買很多，不代表趨勢一定成立','INST_FLOW','會讀外資、投信、自營商買賣超的基本意思。','買賣超 = 買進 − 賣出；要看是否連續、和價格是否一致。','投信買不代表一定漲，單日資料噪音很大。'],
    [84,'買了多少，也要看原本有多少','絕對張數大，不代表影響一定大','FLOW_RATIO','用比例看法人買賣超的份量。','買賣超 ÷ 當日成交量、近期累積變化，比單看張數更有意義。','大型股買 5,000 張可能很小，小型股買 500 張可能很大。'],
    [85,'資金流不是看到錢就追','看占比、持續性，也要看價格有沒有跟','MONEY_FLOW','把資金流放回「持續性、相對占比、價格確認、位置」來看。','資金流要問：是否持續？占比是否升高？價格有沒有確認？是不是已經漲完？','資金湧入不是必勝訊號，還沒驗證的規則不能當成定律。'],
    [86,'營收成長先看趨勢','一個月很好，不代表整體真的變好','REVENUE','會讀月營收的 MoM、YoY 與近幾月趨勢。','YoY 比去年同月，避開季節性；連續幾個月的方向比單月更重要。','單月暴增可能是一次性出貨。'],
    [87,'毛利率看生意品質','賣得多，也要看每一塊錢留下多少','GROSS_MARGIN','用毛利率看產品賺錢的能力。','毛利率 = 毛利 ÷ 營收；上升可能來自產品組合、成本或定價改善。','營收成長但毛利率下滑，可能是靠降價衝量。'],
    [88,'營益率看本業效率','毛利高，不代表本業最後真的賺得好','OP_MARGIN','分清楚毛利率與營業利益率。','營益率 = 營業利益 ÷ 營收；扣掉研發、行銷、管理費用後才是本業效率。','毛利率很高，費用更高，本業一樣可能不賺。'],
    [89,'EPS 看成長也看來源','賺很多，也要知道是不是一次性的','EPS','分辨本業獲利與一次性收益。','EPS 成長要看來源：本業、業外、處分資產、匯兌，持續性差很多。','一次性處分收益讓 EPS 暴增，不代表公司變強。'],
    [90,'現金流要跟獲利對得上','帳上賺錢，不代表現金真的進來','CASH_FLOW','用營業現金流檢查獲利品質。','長期來看，營業現金流應該和淨利方向一致；獲利增加但現金流長期為負要提高警覺。','帳上有利潤不代表收得到錢。'],
    [91,'負債與利息壓力','成長很快，也可能撐得很辛苦','DEBT','理解負債本身不是壞事，但要承受得起。','看負債比與利息保障倍數：營業利益能不能輕鬆付利息。','不是零負債才是好公司，也不是成長快就不怕負債。'],
    [92,'估值不是越低越便宜','好公司也可能買太貴','VALUATION','會讀本益比、股價淨值比的基本意思。','本益比 = 股價 ÷ EPS；要和成長、同業、自己的歷史比；好公司 ≠ 好股票 ≠ 現在就是好買點。','本益比低不代表一定便宜，可能是獲利要衰退。'],
    [93,'分散不是亂買很多檔','同產業一起跌，還是同一種風險','DIVERSIFY','知道分散要分散的是「風險來源」。','同產業、同題材的五檔股票，常常一起漲一起跌，等於集中。','買很多檔不等於有分散。'],
    [94,'單筆風險和總風險','每一檔都能承受，不代表整個帳戶能承受','PORTFOLIO_RISK','把單筆風險加總成帳戶總風險。','總風險 ≈ 所有部位失策時的虧損加總；相關性高時會同時發生。','五筆各虧 2%，同時發生就是 10%。'],
    [95,'攤平不會讓理由變對','價格變便宜，不代表你的論點變好了','AVERAGING','分辨計畫性加碼與套牢攤平。','加碼前問：原論點還成立嗎？失策點沒破嗎？總風險還在預算內嗎？','跌破失策還加碼，是在加大錯誤。'],
    [96,'結果對，不代表決策對','靠運氣賺錢，也可能是一個壞決策','PROCESS','用過程品質評估一筆交易，而不是只看結果。','好決策：有理由、有失策、風報比合理；結果好壞還有運氣成分。','賺錢不代表做對，虧錢也不代表做錯。'],
    [97,'寫下理由，再回頭看','交易日誌會抓出你一直重複的錯','JOURNAL','完成一份簡易交易日誌，並找出判斷對錯。','進場前寫下：理由、進場、失策、空間、最大虧損；事後對照哪一步對、哪一步錯。','只記得賺賠金額，學不到東西。'],
    [98,'三層掃描','大盤 → 產業 → 個股','SCAN3','完成三層掃描並決定做、觀察或放棄。','先大盤、再產業、最後個股；名稱與未來都遮住，只能用當時資訊。','不要因為後來知道結果，就說當時一定看得出來。'],
    [99,'四種證據一起看','價格 → 量能 → 消息 → 基本面','EVIDENCE4','分清楚事實與推測，用四種證據做判斷。','先寫事實，再寫推測，最後決定；說得出什麼情況代表看錯。','證據越多不等於越確定，互相矛盾時要降低信心。'],
    [100,'最終畢業考：完整交易計畫','不是猜漲跌，而是做一個完整決策','GRADUATION','在盲測中完成完整交易計畫，並逐日管理。','完整計畫：環境、位置、證據、是否交易、進場、失策、空間、部位、續抱與退出條件。','好決策可能虧錢，壞決策也可能剛好賺錢。']
  ].forEach(function(a){mission({id:a[0],world:0,title:a[1],sub:a[2],skill:a[3],objective:a[4],rule:a[5],anti:a[6],focus:'concept',kind:'concept'});});

  var order=[],n=0;
  PLAN.forEach(function(row){row[1].forEach(function(id,k){var m=CT.MISSIONS[id-1];if(!m||m.id!==id)throw new Error('curriculum: lesson id '+id+' missing');n++;m.world=row[0];m.moduleId=row[0];m.displayNo=n;m.order=n;m.type=m.kind==='concept'?'concept':'chart';order.push(id);});});
  if(order.length!==100||CT.MISSIONS.length!==100)throw new Error('curriculum must have 100 lessons, got '+order.length+'/'+CT.MISSIONS.length);
  CT.ORDER=order;
  CT.MISSIONS[49].title='逐日 K 線技術面實戰';   // id 50 — the real graduation moved to displayNo 100
  CT.CHART_IDS=CT.MISSIONS.filter(function(m){return m.type==='chart';}).map(function(m){return m.id;});
  CT.byDisplay=function(no){return CT.MISSIONS[order[no-1]-1];};
  CT.displayNo=function(id){var m=CT.MISSIONS[id-1];return m&&m.displayNo?m.displayNo:id;};
  // Market rules in one place (rates as of 2026; change here only).
  CT.MARKET_RULES={lot:1000,feeRate:0.001425,feeMin:20,taxRate:0.003,taxRateDayTrade:0.0015,taxRateETF:0.001,priceLimit:0.10};
})(window);
