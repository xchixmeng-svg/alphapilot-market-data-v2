function chartData(m,R){var q=criterion(m.id,R),i=q.i,showMA=false,zones=[],markers=[],lines=[],focus=[],last=i,showVolume=m.id>=25;if(m.id>=19&&m.id<23)showMA='ma20';if(m.id>=23)showMA='both';if(m.id<=6)focus=[i];if(m.id===7)markers.push({idx:i,price:q.res,label:'近期高點',color:'#ffd44a'});if(m.id===8){markers.push({idx:i-13,price:q.hi1,label:'前段高',color:'#9876ff'},{idx:i,price:q.hi2,label:'後段高',color:'#39f5ff'});}if(m.id===9){markers.push({idx:i-13,price:q.lo1,label:'前段低',color:'#9876ff'},{idx:i,price:q.lo2,label:'後段低',color:'#39f5ff'});}if(m.id>=13){var w=q.a*.35;zones.push({lo:q.sup-w,hi:q.sup+w,color:'#24d79b',label:'支撐候選',alpha:UI.hint? .16:.08},{lo:q.res-w,hi:q.res+w,color:'#ff9f43',label:'壓力候選',alpha:UI.hint? .16:.08});}if(m.id===19||m.id===20||m.id===21||m.id===22)lines.push({price:q.ma,color:'#ffd44a',label:'MA20'});if(m.id===23)lines.push({price:q.ma,color:'#ffd44a',label:'MA20'},{price:q.ma60,color:'#27c8ff',label:'MA60'});if(m.id===31)lines.push({price:Math.max(.01,q.sup-q.a*.45),color:'#ff465f',label:'失策參考',dash:true});if(m.id===32||m.id===33){var tg=q.res>q.c?q.res:maxA(R.h,i-60,i-1);lines.push({price:tg,color:'#ffd44a',label:'壓力/目標'});lines.push({price:Math.max(.01,q.sup-q.a*.45),color:'#ff465f',label:'失策',dash:true});}if(m.id===35){last=Math.min(X(3),R.c.length-1);lines.push({price:Math.max(.01,q.sup-q.a*.45),color:'#ff465f',label:'原失策',dash:true});}if(m.id===25||m.id===26)focus=[i];if(UI.hint>=2&&m.id>=13)lines.push({price:q.sup,color:'#24d79b',label:'支撐核心',dash:true},{price:q.res,color:'#ff9f43',label:'壓力核心',dash:true});return{R:R,lastIdx:last,d0Idx:i,showMA:showMA,showVolume:showVolume,zones:zones,markers:markers,lines:lines,focusCandles:focus,focusVolume:(m.id===25||m.id===26)?i:null,labelFor:function(k){return 'D'+(k-i);}};}
function promptIntro(m){return '<div class="promptTop"><span class="qtag">MISSION '+String(m.id).padStart(2,'0')+'</span><span class="difficulty">LEARN</span></div><div class="question">'+esc(m.objective)+'</div><div class="explain"><strong style="color:var(--cyan)">只新增一件事：</strong> '+esc(m.rule)+'</div><div class="coachLine">AI 教練｜'+esc(m.anti)+'</div>';}
function promptQuestion(m,R){var tag=UI.mode==='exam'?'盲測 '+((UI.scanIdx||0)+1)+' / 100':UI.mode==='practice'?'實戰 '+((UI.scanIdx||0)+1)+' / 400':'Q '+UI.exercise+' / '+exCount(m);var diff=UI.mode==='exam'?'NO HINT':UI.mode==='practice'?'RANDOM':(UI.exercise===1?'GUIDED':UI.exercise===2?'CHECK':'SOLO');return '<div class="promptTop"><span class="qtag">'+tag+'</span><span class="difficulty">'+diff+'</span></div><div class="question">'+esc(qtext(m,R,UI.exercise))+'</div><div class="explain">'+(UI.mode==='exam'?'不提示、不告訴題型來源。只用你已學會的掃描順序。':UI.mode==='practice'?'題型與年份打亂，不告訴你該看哪個指標。':UI.exercise===1?'先看圖，不用急。系統只考剛學的這一件事。':UI.exercise===exCount(m)?(UI.hint?'提示已打開，再試一次。':'最後一題：先不給提示，答錯才會出現。'):'換一張真實歷史圖，再認一次。')+'</div>'+(UI.hint&&UI.mode!=='exam'?'<div class="coachLine">提示 '+UI.hint+'｜'+esc(hints(m,R)[Math.min(UI.hint,hints(m,R).length)-1])+'</div>':'');}
function answerHTML(m,R){if(UI.exercise===0)return '<button class="btn primary full pulse" data-act="beginQuestions">我看懂示範了，開始練 →</button><button class="answerHelp" data-act="hint">我還沒看懂，換更簡單的說法</button>';var q=question(m,R,UI.exercise),html=q.opts.map(function(o,idx){var cls='answer';if(UI.feedback&&idx===q.correct)cls+=' correct';if(UI.feedback&&UI.answer===idx&&idx!==q.correct)cls+=' wrong';return '<button class="'+cls+'" data-act="answer" data-i="'+idx+'" '+(UI.feedback?'disabled':'')+'>'+esc(o)+'</button>';}).join('');if(UI.feedback){var ok=UI.answer===q.correct,session=UI.mode==='practice'||UI.mode==='exam';html+='<div class="feedbackBox '+(ok?'':'bad')+'"><strong>'+(ok?'SCAN LOCKED｜你看對地方了':'MISREAD｜你看錯觀察點')+'</strong><br>'+esc(explain(m,R,UI.answer))+'</div><button class="btn '+(ok?'green':'ghost')+' full nextBtn" data-act="afterFeedback">'+(session?'下一題 →':ok?(UI.exercise>=exCount(m)?'完成本任務':'下一張圖 →'):'我懂了，重做這題')+'</button>';}else if(UI.mode!=='exam')html+='<button class="answerHelp" data-act="hint">我卡住了｜系統幫我拆小一步</button>';return html;}
function training(){var m=UI.mission;if(!m){setupMission(nextMission(),0,'mission');m=UI.mission;}var R=getR(UI.roundId),w=CT.WORLDS[m.world-1],scanMode=UI.mode==='practice'||UI.mode==='exam',dots=Array.from({length:exCount(m)},function(_,k){return k+1;}).map(function(n){return'<i class="'+(UI.exercise===n?'on':UI.exercise>n?'done':'')+'"></i>';}).join('');var head=scanMode?'<div class="trainingHead"><div class="missionTag">'+(UI.mode==='exam'?'盲測':'實戰')+'</div><div class="trainTitle"><strong>第 '+((UI.scanIdx||0)+1)+' / '+(UI.mode==='exam'?100:400)+' 題</strong><span>'+(UI.mode==='exam'?'不提示、不顯示題型，只用你學會的掃描順序':'題型隨機，先自己判斷這題在問什麼')+'</span></div></div>':'<div class="trainingHead"><div class="missionTag">M'+String(m.id).padStart(2,'0')+'</div><div class="trainTitle"><strong>'+esc(m.title)+'</strong><span>'+esc(m.sub)+'</span></div><div class="stepDots">'+dots+'</div></div>';app.innerHTML=scan+hud(true)+'<div class="main'+(scanMode?' scanMain':'')+'">'+(scanMode?'':sidebar(m))+'<section class="training">'+head+'<div class="chartArea"><div class="chartFrame"><div id="v3Chart" class="chartwrap"></div><div class="coachOrb">AI</div></div></div><div class="lessonDock"><div class="dockGrid"><div class="prompt">'+(UI.exercise===0?promptIntro(m):promptQuestion(m,R))+'</div><div class="answers">'+answerHTML(m,R)+'</div></div></div></section></div><div class="debugBadge">產品測試版</div>';UI.chart=BSGChart.create(document.getElementById('v3Chart'),{getData:function(){return chartData(m,R);}});if(m.id<=6)UI.chart.setRange(20);else if(m.id<=18)UI.chart.setRange(60);else UI.chart.setRange(60);}
function completeMission(){var m=UI.mission;if(!completed(m.id)){S.completed.push(m.id);S.completed.sort(function(a,b){return a-b;});S.xp+=120;S.coins+=80;S.streak+=1;S.lastMission=nextInOrder(m.id);var st=S.missionStats[m.id]||{wrong:0,hints:0};st.complete=true;S.missionStats[m.id]=st;save();}go('mastery');}
function mastery(){var m=UI.mission,w=CT.WORLDS[m.world-1],worldDone=currentWorldMissions(m).every(function(x){return completed(x.id);});var next=nextInOrder(m.id);app.innerHTML=scan+hud(true)+'<div class="mastery"><div>'+chickImg(null,'ckMasteryChick')+'<h2>第 '+String(m.id).padStart(2,'0')+' 關完成</h2><div class="ckRank" style="margin-bottom:6px">'+esc(rankName())+'</div><p><strong style="color:var(--cyan)">'+esc(m.title)+'</strong> 已加入你的判斷鏈。'+(worldDone?'「'+esc(w.title)+'」模組完成，下一模組只會在這些能力上再加一層。':'下一關只會多增加一個新變數。')+'</p><div class="rewardRow"><span class="reward">+120 EXP</span><span class="reward">◆ +80</span></div><div class="ctaRow" style="justify-content:center">'+(!isLastInOrder(m.id)?'<button class="btn primary pulse" data-act="mission" data-id="'+next+'">下一任務 →</button>':'<button class="btn gold pulse" data-act="practiceHome">進入實戰艙 →</button>')+'<button class="btn ghost" data-act="overview">36 關總覽</button><button class="btn ghost" data-act="home">返回首頁</button></div></div></div>';}
function paywall(){app.innerHTML=scan+hud(true)+'<div class="paywall"><div class="payCard"><div class="payIcon">◆</div><div class="kicker" style="color:var(--gold)">從菜雞到股神｜完整版</div><div class="payTitle">你已經會「看 K」。<br>完整版開始教你「做判斷」。</div><p style="color:#abc4d2">免費區讓玩家真的學會第一個能力，再決定要不要買。完整版不是多幾道題，而是完整能力鏈。</p><div class="payFeatures"><div class="payFeature">✓ 結構：高低點、趨勢、轉折</div><div class="payFeature">✓ 位置：支撐、壓力、突破、回測</div><div class="payFeature">✓ 工具：MA20 / MA60 / ATR</div><div class="payFeature">✓ 機會：量價、回檔、突破、追高</div><div class="payFeature">✓ 決策：失策、R:R、部位、出場</div><div class="payFeature">✓ 400 題亂數 + 100 題盲測</div></div><div class="payPrice">NT$ '+CT.PRODUCT_PRICE_TWD+' <span style="font:700 12px var(--font);color:var(--muted)">一次買斷</span></div><button class="btn gold full pulse" data-act="unlockPremium">產品測試：模擬購買並解鎖</button><button class="btn ghost full" style="margin-top:8px" data-act="home">先回免費區</button><div class="legal">測試版未串接 App Store / Google Play 金流，不會產生真實扣款。</div></div></div>';}
function practiceHome(){var unlock=S.completed.length>=36,examDone=S.exam.idx>=100,pr=S.practice,ex=S.exam,rate=function(o){return o.total?Math.round(o.correct/o.total*100)+'%':'—';};
 app.innerHTML=scan+hud(true)+'<main class="ckPage ckArena"><div class="ckArenaHead">'+chickImg(unlock?'god':'scholar','ckAvatar')+'<div><h1 class="ckPageTitle">實戰艙</h1><p class="ckMuted">沒有章節名稱，36 種題型隨機混在一起。你得自己先看出這題在問什麼。</p></div></div>'+
 '<section class="ckCard ckArenaCard"><header><b>400 題亂數實戰</b><span class="ckTag">第 '+pr.round+' 輪</span></header><p class="ckMuted">2020–2023 歷史題池｜可以使用提示｜做完 400 題會重新洗牌開新一輪</p><div class="ckXp"><i style="width:'+(pr.idx/4)+'%"></i></div><div class="ckArenaStats"><span>本輪進度 <b>'+pr.idx+' / 400</b></span><span>累計答對 <b>'+pr.correct+' / '+pr.total+'</b>（'+rate(pr)+'）</span></div><button class="ckBtn ckCyan" data-act="startPractice" '+(!unlock?'disabled':'')+'>'+(pr.idx?'繼續實戰':'開始實戰')+' ›</button></section>'+
 '<section class="ckCard ckArenaCard"><header><b>100 題盲測</b><span class="ckTag gold">'+(examDone?'已完成':'正式成績')+'</span></header><p class="ckMuted">隔離的 2024–2025 題池｜不提示、不顯示題型｜只記一次正式成績</p><div class="ckXp gold"><i style="width:'+Math.min(100,ex.idx)+'%"></i></div><div class="ckArenaStats"><span>進度 <b>'+Math.min(100,ex.idx)+' / 100</b></span><span>答對 <b>'+ex.correct+' / '+ex.total+'</b>（'+rate(ex)+'）</span></div><button class="ckBtn ckGold" data-act="startExam" '+(!unlock||examDone?'disabled':'')+'>'+(examDone?'盲測已完成':ex.idx?'繼續盲測':'開始盲測')+' ›</button></section>'+
 (!unlock?'<div class="ckCard ckNotice">'+chickImg('rookie','ckAvatar sm')+'<span>先完成 36 關才會開放。這裡不會讓你靠猜題進來。目前 '+S.completed.length+' / 36。</span><button class="ckBtn ckCyan ckSmall" data-act="overview">36 關總覽</button></div>':'')+
 '</main>'+bottomNav('practiceHome');}
function startScan(mode){var obj=mode==='exam'?S.exam:S.practice,limit=mode==='exam'?100:400,idx=obj.idx;if(idx>=limit){go('practiceHome');return;}var plan=skillPlan(mode),mid=plan[idx],variant=1+(idx%3),salt=mode==='exam'?idx:S.practice.round*10000+idx;
 setupMission(mid,variant,mode);UI.roundId=roundFor(mid,salt,mode);UI.exercise=variant;UI.scanIdx=idx;go('training');}
function startFullScan(mode){startScan(mode);}
function openSheet(html){closeSheet();var bg=document.createElement('div'),sh=document.createElement('div');bg.className='sheetBg';sh.className='sheet';bg.addEventListener('click',closeSheet);sh.innerHTML=html;document.body.appendChild(bg);document.body.appendChild(sh);UI.sheet={bg:bg,sh:sh};}
function closeSheet(){if(UI.sheet){UI.sheet.bg.remove();UI.sheet.sh.remove();UI.sheet=null;}}
var ACT={};
ACT.home=function(){go('home');};ACT.paywall=function(){go('paywall');};ACT.practiceHome=function(){go('practiceHome');};
ACT.overview=function(el){UI.focusWorld=el&&el.dataset&&el.dataset.world?+el.dataset.world:null;go('overview');};
ACT.continueNext=function(){var b=document.createElement('button');b.dataset.id=nextMission();ACT.mission(b);};
ACT.mission=function(el){var id=+(el.dataset.id||1);if(!unlocked(id)){toast('先完成前一個能力');return;}if(premiumNeeded(id)){UI.mission=CT.MISSIONS[id-1];go('paywall');return;}setupMission(id,0,'mission');go('training');};
ACT.unlockPremium=function(){S.premium=true;save();toast('測試版完整版已解鎖');var id=UI.mission&&orderPos(UI.mission.id)>=CT.FREE_THROUGH?UI.mission.id:ORDER_IDS[CT.FREE_THROUGH];setupMission(id,0,'mission');go('training');};
ACT.beginQuestions=function(){UI.exercise=1;UI.roundId=roundFor(UI.mission.id,1,UI.mode);UI.feedback=null;UI.hint=0;go('training');};
ACT.answer=function(el){var R=getR(UI.roundId),q=question(UI.mission,R,UI.exercise),idx=+el.dataset.i;UI.answer=idx;UI.feedback=true;var ok=idx===q.correct,st=S.missionStats[UI.mission.id]||{wrong:0,hints:0};if(!ok){st.wrong++;S.streak=0;}S.missionStats[UI.mission.id]=st;if(UI.mode==='practice'||UI.mode==='exam'){var obj=UI.mode==='exam'?S.exam:S.practice;obj.total++;if(ok)obj.correct++;obj.idx++;S.xp+=ok?20:5;S.coins+=ok?10:0;}save();render();};
ACT.afterFeedback=function(){var R=getR(UI.roundId),q=question(UI.mission,R,UI.exercise),ok=UI.answer===q.correct;if(UI.mode==='practice'||UI.mode==='exam'){var obj=UI.mode==='exam'?S.exam:S.practice,limit=UI.mode==='exam'?100:400;if(obj.idx>=limit){if(UI.mode==='practice'){S.practice.round+=1;S.practice.idx=0;save();toast('400 題完成！新一輪已重新洗牌');}else toast('盲測完成');go('practiceHome');return;}startScan(UI.mode);return;}if(!ok){UI.feedback=null;UI.answer=null;UI.hint=Math.max(1,UI.hint);render();return;}if(UI.exercise>=exCount(UI.mission)){completeMission();return;}UI.exercise++;UI.roundId=roundFor(UI.mission.id,UI.exercise,UI.mode);UI.feedback=null;UI.answer=null;UI.hint=0;render();};
ACT.hint=function(){var R=getR(UI.roundId),m=UI.mission,hs=hints(m,R);UI.hint=Math.min(hs.length,UI.hint+1);var st=S.missionStats[m.id]||{wrong:0,hints:0};st.hints++;S.missionStats[m.id]=st;save();if(UI.exercise===0){openSheet('<h3>把它拆小一步</h3>'+hs.slice(0,UI.hint).map(function(x){return'<div class="hintStep">'+esc(x)+'</div>';}).join('')+'<button class="btn primary full" data-act="closeSheet">回圖上再看一次</button>');}else render();};
ACT.closeSheet=function(){closeSheet();};ACT.startPractice=function(){if(S.completed.length<36){toast('完成 36 關後解鎖');return;}startScan('practice');};ACT.startExam=function(){if(S.completed.length<36){toast('完成 36 關後解鎖');return;}startScan('exam');};
// V5 layer handlers (app.0299x). Each receives the previous handler so it can wrap instead of replace.
Object.keys(ACT_V5).forEach(function(k){var prev=ACT[k];ACT[k]=function(el){return ACT_V5[k](el,prev);};});
document.addEventListener('click',function(e){var el=e.target.closest('[data-act]');if(!el)return;var fn=ACT[el.dataset.act];if(fn)try{fn(el);}catch(err){console.error(err);toast('SYSTEM：'+err.message);}});
window.BSGV3={reset:function(){localStorage.removeItem(SAVE_KEY);location.reload();},unlock:function(){S.premium=true;save();location.reload();},state:function(){return JSON.parse(JSON.stringify(S));},_test:{getR:getR,roundFor:roundFor,explain:function(m,R,a){return explain(m,R,a);},hints:function(m,R){return hints(m,R);},promptIntro:function(m){return promptIntro(m);},promptQuestion:function(m,R){return promptQuestion(m,R);},answerHTML:function(m,R){return answerHTML(m,R);},question:question,qtext:qtext,criterion:criterion,suitable:suitable,chartData:chartData,setupMission:setupMission,skillPlan:skillPlan,migrate:migrate,save:function(){return S;},TRAIN:TRAIN,EXAM:EXAM,ui:UI}};
render();
})();
