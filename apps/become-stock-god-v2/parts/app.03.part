 case'BODY':return'K 棒中間的「實體」代表哪一段？';case'COLOR':return'只比較 D0 的開盤與收盤，這根是什麼 K？';case'WICK':return'D0 這根 K，哪一側影線更明顯？';case'DAYCHANGE':return'不要看 K 棒顏色。和「昨天收盤」相比，今天到底漲還跌？';case'SEQUENCE':return'只看最近 5 個收盤位置，整體往哪裡移？';case'SWING_HIGH':return'近 20 個交易日，真正的高點大約在哪？';case'HIGHER_HIGH':return'把前半段與後半段的重要高點相比，發生什麼？';case'HIGHER_LOW':return'把前半段與後半段的重要低點相比，發生什麼？';case'DOWNTREND':return'高點與低點一起看，這段結構比較像什麼？';case'RANGE':return'這段走勢有明確墊高／降低嗎？';case'STRUCTURE_SHIFT':return'現在有足夠證據說結構已改變嗎？';case'SUPPORT':return'近 20 日價格最常被接住的下方區域大約在哪？';case'RESISTANCE':return'近 20 日上方最明顯的壓力大約在哪？';case'RANGE_EDGE':return'現在價格位在區間哪一側？';case'BREAKOUT':return'相對前 20 日壓力，D0 算真正站上去了嗎？';case'FALSE_BREAKOUT':return'圖上突破後又跌回原區間，最合理的解讀是？';case'RETEST':return'這個位置最像哪種行為？';case'MA20_ID':return'圖上黃色發光線是什麼？';case'MA20_SIDE':return'目前收盤 '+px(q.c)+'，MA20 '+px(q.ma)+'。股價在哪一側？';case'MA20_DISTANCE':return'目前收盤與 MA20 相差約 '+pct(Math.abs(q.dist||0))+ '，屬於哪種距離？';case'MA20_SLOPE':return'MA20 今天和 5 天前相比，方向如何？';case'MA_STACK':return'現在價格、MA20、MA60 的順序是？';case'ATR':return'ATR 約占股價 '+pct(q.a/q.c)+'，這檔波動程度如何？';case'VOLUME':return'今天成交量約為近 20 日平均的 '+(q.vr||0).toFixed(2)+' 倍，算什麼？';case'PRICE_VOLUME':return'今天價格與成交量合起來看，最接近哪種狀態？';case'PULLBACK':return'把趨勢、位置與 MA20 合起來，這更像哪種情況？';case'BREAKOUT_SETUP':return'這次向上穿越壓力的品質如何？';case'RETEST_SETUP':return'突破後回到原壓力附近，現在應怎麼解讀？';case'NO_CHASE':return'你現在最需要警惕的是不是「追高」？';case'INVALIDATION':return'如果這是一筆回檔交易，失策點應該放哪裡才有邏輯？';case'TARGET':return'先不許願 +15%。第一個合理的上方觀察目標應看哪裡？';case'RR':return'用目前位置、支撐下失策、上方壓力估算，風險報酬大約在哪一級？';case'POSITION':return'如果另一筆交易的停損距離更寬，固定帳戶風險下部位應怎麼變？';case'HOLD_EXIT':return'現在已經走到 D+3。交易理由還在，還是已經失效？';case'FULL_SCAN':return'按照「趨勢 → 位置 → 均線 → 量價 → 空間」掃完，現在最合理的動作是？';default:return m.objective;}}
function explain(m,R,ans){var q=criterion(m.id,R),i=q.i;switch(m.skill){case'OHLC':return'這一關只認四個價格，不做預測。開 '+px(q.o)+'｜高 '+px(R.h[i])+'｜低 '+px(R.l[i])+'｜收 '+px(q.c)+'。';case'COLOR':return'K 色只比較今天開盤 '+px(q.o)+' 與收盤 '+px(q.c)+'。';case'DAYCHANGE':return'日漲跌一定要拿今天收盤 '+px(q.c)+' 去比昨天收盤 '+px(q.pc)+'；這和紅綠 K 是兩套比較。';case'MA20_DISTANCE':return'收盤 '+px(q.c)+'、MA20 '+px(q.ma)+'，乖離約 '+pct(q.dist||0)+'。先用百分比建立距離感，不要只靠畫面比例。';case'VOLUME':return'今天量 / 近 20 日平均量 ≈ '+(q.vr||0).toFixed(2)+' 倍。量要和自己的近期基準比。';case'RR':var st=Math.max(.01,q.sup-q.a*.45),tg=q.res>q.c?q.res:maxA(R.h,i-60,i-1),rr=(tg-q.c)/(q.c-st);return'用收盤 '+px(q.c)+'、失策約 '+px(st)+'、壓力約 '+px(tg)+'，R:R 約 '+(isFinite(rr)?rr.toFixed(2):'—')+'。';case'HOLD_EXIT':return'持有判斷不是看第幾天，而是檢查原本支撐／結構是否失效。';case'FULL_SCAN':return'完整判斷不是找單一神奇訊號，而是固定順序掃描，最後也允許「不做」。';default:return m.rule;}}
function hints(m,R){var q=criterion(m.id,R),i=q.i;var a=['先忽略其他資訊，只找這關標題中的那一件事。'];switch(m.skill){case'COLOR':a.push('只比較兩個數字：開盤 '+px(q.o)+'、收盤 '+px(q.c)+'。');a.push(q.c>=q.o?'收盤比較高，所以這根偏紅。':'收盤比較低，所以這根偏綠。');break;case'DAYCHANGE':a.push('不要用今天開盤。拿今天收盤 '+px(q.c)+' 比昨天收盤 '+px(q.pc)+'。');break;case'MA20_SIDE':case'MA20_DISTANCE':a.push('黃色線就是 MA20，目前約 '+px(q.ma)+'；收盤約 '+px(q.c)+'。');a.push('差距約 '+pct(Math.abs(q.dist||0))+'。');break;case'SUPPORT':a.push('往左看近 20 天，找價格多次下去又被拉起的低位區。');a.push('這題的區域約在 '+px(q.sup)+' 附近。');break;case'RESISTANCE':a.push('往左找多次漲上去又被壓回的高位區。');a.push('這題約在 '+px(q.res)+' 附近。');break;case'VOLUME':a.push('不要看絕對張數，比「今天 / 近20日平均」。');a.push('這題約 '+(q.vr||0).toFixed(2)+' 倍。');break;case'FULL_SCAN':a.push('先問：趨勢？再問：現在靠近支撐還是壓力？');a.push('最後才把 MA、量與上方空間放進來。');break;default:a.push(m.rule);a.push(m.anti);}return a;}
function chartData(m,R){var q=criterion(m.id,R),i=q.i,showMA=false,zones=[],markers=[],lines=[],focus=[],last=i,showVolume=m.id>=25;if(m.id>=19&&m.id<23)showMA='ma20';if(m.id>=23)showMA='both';if(m.id<=6)focus=[i];if(m.id===7)markers.push({idx:i,price:q.res,label:'近期高點',color:'#ffd44a'});if(m.id===8){markers.push({idx:i-13,price:q.hi1,label:'前段高',color:'#9876ff'},{idx:i,price:q.hi2,label:'後段高',color:'#39f5ff'});}if(m.id===9){markers.push({idx:i-13,price:q.lo1,label:'前段低',color:'#9876ff'},{idx:i,price:q.lo2,label:'後段低',color:'#39f5ff'});}if(m.id>=13){var w=q.a*.35;zones.push({lo:q.sup-w,hi:q.sup+w,color:'#24d79b',label:'支撐候選',alpha:UI.hint? .16:.08},{lo:q.res-w,hi:q.res+w,color:'#ff9f43',label:'壓力候選',alpha:UI.hint? .16:.08});}if(m.id===19||m.id===20||m.id===21||m.id===22)lines.push({price:q.ma,color:'#ffd44a',label:'MA20'});if(m.id===23)lines.push({price:q.ma,color:'#ffd44a',label:'MA20'},{price:q.ma60,color:'#27c8ff',label:'MA60'});if(m.id===31)lines.push({price:Math.max(.01,q.sup-q.a*.45),color:'#ff465f',label:'失策參考',dash:true});if(m.id===32||m.id===33){var tg=q.res>q.c?q.res:maxA(R.h,i-60,i-1);lines.push({price:tg,color:'#ffd44a',label:'壓力/目標'});lines.push({price:Math.max(.01,q.sup-q.a*.45),color:'#ff465f',label:'失策',dash:true});}if(m.id===35){last=Math.min(X(3),R.c.length-1);lines.push({price:Math.max(.01,q.sup-q.a*.45),color:'#ff465f',label:'原失策',dash:true});}if(m.id===25||m.id===26)focus=[i];if(UI.hint>=2&&m.id>=13)lines.push({price:q.sup,color:'#24d79b',label:'支撐核心',dash:true},{price:q.res,color:'#ff9f43',label:'壓力核心',dash:true});return{R:R,lastIdx:last,d0Idx:i,showMA:showMA,showVolume:showVolume,zones:zones,markers:markers,lines:lines,focusCandles:focus,focusVolume:(m.id===25||m.id===26)?i:null,labelFor:function(k){return 'D'+(k-i);}};}
function promptIntro(m){return '<div class="promptTop"><span class="qtag">MISSION '+String(m.id).padStart(2,'0')+'</span><span class="difficulty">LEARN</span></div><div class="question">'+esc(m.objective)+'</div><div class="explain"><strong style="color:var(--cyan)">只新增一件事：</strong> '+esc(m.rule)+'</div><div class="coachLine">AI 教練｜'+esc(m.anti)+'</div>';}
function promptQuestion(m,R){var tag=UI.mode==='exam'?'BLIND '+(S.exam.idx+1)+' / '+Math.min(100,EXAM.length):UI.mode==='practice'?'PRACTICE '+(S.practice.idx+1)+' / '+Math.min(400,TRAIN.length):'Q '+UI.exercise+' / 3';var diff=UI.mode==='exam'?'NO HINT':UI.mode==='practice'?'RANDOM':(UI.exercise===1?'GUIDED':UI.exercise===2?'CHECK':'SOLO');return '<div class="promptTop"><span class="qtag">'+tag+'</span><span class="difficulty">'+diff+'</span></div><div class="question">'+esc(qtext(m,R,UI.exercise))+'</div><div class="explain">'+(UI.mode==='exam'?'不提示、不告訴題型來源。只用你已學會的掃描順序。':UI.mode==='practice'?'題型與年份打亂，不告訴你該看哪個指標。':UI.exercise===1?'先看圖，不用急。系統只考剛學的這一件事。':UI.exercise===3?'最後一次不給提示，確認你真的會。':'換一張真實歷史圖，再認一次。')+'</div>'+(UI.hint&&UI.mode!=='exam'?'<div class="coachLine">提示 '+UI.hint+'｜'+esc(hints(m,R)[Math.min(UI.hint,hints(m,R).length)-1])+'</div>':'');}
function answerHTML(m,R){if(UI.exercise===0)return '<button class="btn primary full pulse" data-act="beginQuestions">我看懂示範了，開始練 →</button><button class="answerHelp" data-act="hint">我還沒看懂，換更簡單的說法</button>';var q=question(m,R,UI.exercise),html=q.opts.map(function(o,idx){var cls='answer';if(UI.feedback&&idx===q.correct)cls+=' correct';if(UI.feedback&&UI.answer===idx&&idx!==q.correct)cls+=' wrong';return '<button class="'+cls+'" data-act="answer" data-i="'+idx+'" '+(UI.feedback?'disabled':'')+'>'+esc(o)+'</button>';}).join('');if(UI.feedback){var ok=UI.answer===q.correct,session=UI.mode==='practice'||UI.mode==='exam';html+='<div class="feedbackBox '+(ok?'':'bad')+'"><strong>'+(ok?'SCAN LOCKED｜你看對地方了':'MISREAD｜你看錯觀察點')+'</strong><br>'+esc(explain(m,R,UI.answer))+'</div><button class="btn '+(ok?'green':'ghost')+' full nextBtn" data-act="afterFeedback">'+(session?'下一題 →':ok?(UI.exercise>=3?'完成本任務':'下一張圖 →'):'我懂了，重做這題')+'</button>';}else if(UI.mode!=='exam')html+='<button class="answerHelp" data-act="hint">我卡住了｜系統幫我拆小一步</button>';return html;}
function training(){var m=UI.mission;if(!m){setupMission(nextMission(),0,'mission');m=UI.mission;}var R=getR(UI.roundId),w=CT.WORLDS[m.world-1],dots=[1,2,3].map(function(n){return'<i class="'+(UI.exercise===n?'on':UI.exercise>n?'done':'')+'"></i>';}).join('');app.innerHTML=scan+hud(true)+'<div class="main">'+sidebar(m)+'<section class="training"><div class="trainingHead"><div class="missionTag">M'+String(m.id).padStart(2,'0')+'</div><div class="trainTitle"><strong>'+esc(m.title)+'</strong><span>'+esc(m.sub)+'</span></div><div class="stepDots">'+dots+'</div></div><div class="chartArea"><div class="chartFrame"><div id="v3Chart" class="chartwrap"></div><div class="coachOrb">AI</div></div></div><div class="lessonDock"><div class="dockGrid"><div class="prompt">'+(UI.exercise===0?promptIntro(m):promptQuestion(m,R))+'</div><div class="answers">'+answerHTML(m,R)+'</div></div></div></section></div><div class="debugBadge">V3 PRODUCT TEST</div>';UI.chart=BSGChart.create(document.getElementById('v3Chart'),{getData:function(){return chartData(m,R);}});if(m.id<=6)UI.chart.setRange(20);else if(m.id<=18)UI.chart.setRange(60);else UI.chart.setRange(60);}
function completeMission(){var m=UI.mission;if(!completed(m.id)){S.completed.push(m.id);S.completed.sort(function(a,b){return a-b;});S.xp+=120;S.coins+=80;S.streak+=1;S.lastMission=Math.min(36,m.id+1);var st=S.missionStats[m.id]||{wrong:0,hints:0};st.complete=true;S.missionStats[m.id]=st;save();}go('mastery');}
function mastery(){var m=UI.mission,w=CT.WORLDS[m.world-1],worldDone=currentWorldMissions(m).every(function(x){return completed(x.id);});var next=m.id<36?m.id+1:36;app.innerHTML=scan+hud(true)+'<div class="mastery"><div><div class="rankRing"><div class="grade">S</div></div><h2>MISSION '+String(m.id).padStart(2,'0')+' COMPLETE</h2><p><strong style="color:var(--cyan)">'+esc(m.title)+'</strong> 已加入你的判斷鏈。'+(worldDone?'「'+esc(w.title)+'」模組完成，下一模組只會在這些能力上再加一層。':'下一關只會多增加一個新變數。')+'</p><div class="rewardRow"><span class="reward">+120 EXP</span><span class="reward">◆ +80</span></div><div class="ctaRow" style="justify-content:center">'+(m.id<36?'<button class="btn primary pulse" data-act="mission" data-id="'+next+'">下一任務 →</button>':'<button class="btn gold pulse" data-act="practiceHome">進入實戰艙 →</button>')+'<button class="btn ghost" data-act="home">返回基地</button></div></div></div>';}
function paywall(){app.innerHTML=scan+hud(true)+'<div class="paywall"><div class="payCard"><div class="payIcon">◆</div><div class="kicker" style="color:var(--gold)">FULL ACADEMY LICENSE</div><div class="payTitle">你已經會「看 K」。<br>完整版開始教你「做判斷」。</div><p style="color:#abc4d2">免費區讓玩家真的學會第一個能力，再決定要不要買。完整版不是多幾道題，而是完整能力鏈。</p><div class="payFeatures"><div class="payFeature">✓ 結構：高低點、趨勢、轉折</div><div class="payFeature">✓ 位置：支撐、壓力、突破、回測</div><div class="payFeature">✓ 工具：MA20 / MA60 / ATR</div><div class="payFeature">✓ 機會：量價、回檔、突破、追高</div><div class="payFeature">✓ 決策：失策、R:R、部位、出場</div><div class="payFeature">✓ 400 題亂數 + 100 題盲測</div></div><div class="payPrice">NT$ '+CT.PRODUCT_PRICE_TWD+' <span style="font:700 12px var(--font);color:var(--muted)">一次買斷</span></div><button class="btn gold full pulse" data-act="unlockPremium">產品測試：模擬購買並解鎖</button><button class="btn ghost full" style="margin-top:8px" data-act="home">先回免費區</button><div class="legal">測試版未串接 App Store / Google Play 金流，不會產生真實扣款。</div></div></div>';}
function practiceHome(){var unlock=S.completed.length>=36;app.innerHTML=scan+hud(true)+'<div class="paywall"><div class="payCard"><div class="kicker">SIMULATION DECK</div><div class="payTitle">沒有章節名稱。<br>現在只能靠你自己掃描。</div><p>完成課程後才進這裡。亂數實戰使用 2020–2023 訓練池；盲測使用隔離的 2024–2025 題池。</p><div class="payFeatures"><div class="payFeature">亂數實戰｜'+S.practice.correct+' / '+S.practice.total+' 答對</div><div class="payFeature">盲測考場｜'+S.exam.correct+' / '+S.exam.total+' 答對</div></div><div class="ctaRow"><button class="btn primary" data-act="startPractice" '+(!unlock?'disabled':'')+'>400 題亂數實戰</button><button class="btn gold" data-act="startExam" '+(!unlock?'disabled':'')+'>100 題盲測</button></div>'+(!unlock?'<div class="coachLine">先完成 36 個能力節點。這裡不會提前讓你靠猜題進來。</div>':'')+'</div></div>';}
function startFullScan(mode){var idx=mode==='exam'?S.exam.idx:S.practice.idx;setupMission(36,(idx%3)+1,mode);UI.roundId=roundFor(36,idx+10,mode);UI.exercise=3;go('training');}
function openSheet(html){closeSheet();var bg=document.createElement('div'),sh=document.createElement('div');bg.className='sheetBg';sh.className='sheet';bg.addEventListener('click',closeSheet);sh.innerHTML=html;document.body.appendChild(bg);document.body.appendChild(sh);UI.sheet={bg:bg,sh:sh};}
function closeSheet(){if(UI.sheet){UI.sheet.bg.remove();UI.sheet.sh.remove();UI.sheet=null;}}
var ACT={};
ACT.home=function(){go('home');};ACT.paywall=function(){go('paywall');};ACT.practiceHome=function(){go('practiceHome');};
ACT.mission=function(el){var id=+(el.dataset.id||1);if(!unlocked(id)){toast('先完成前一個能力');return;}if(premiumNeeded(id)){UI.mission=CT.MISSIONS[id-1];go('paywall');return;}setupMission(id,0,'mission');go('training');};
ACT.unlockPremium=function(){S.premium=true;save();toast('測試版完整版已解鎖');var id=UI.mission&&UI.mission.id>CT.FREE_THROUGH?UI.mission.id:7;setupMission(id,0,'mission');go('training');};
ACT.beginQuestions=function(){UI.exercise=1;UI.roundId=roundFor(UI.mission.id,1,UI.mode);UI.feedback=null;UI.hint=0;go('training');};
ACT.answer=function(el){var R=getR(UI.roundId),q=question(UI.mission,R,UI.exercise),idx=+el.dataset.i;UI.answer=idx;UI.feedback=true;var ok=idx===q.correct,st=S.missionStats[UI.mission.id]||{wrong:0,hints:0};if(!ok){st.wrong++;S.streak=0;}S.missionStats[UI.mission.id]=st;if(UI.mode==='practice'||UI.mode==='exam'){var obj=UI.mode==='exam'?S.exam:S.practice;obj.total++;if(ok)obj.correct++;obj.idx++;S.xp+=ok?20:5;S.coins+=ok?10:0;}save();render();};
ACT.afterFeedback=function(){var R=getR(UI.roundId),q=question(UI.mission,R,UI.exercise),ok=UI.answer===q.correct;if(UI.mode==='practice'||UI.mode==='exam'){var obj=UI.mode==='exam'?S.exam:S.practice,limit=UI.mode==='exam'?Math.min(100,EXAM.length):Math.min(400,TRAIN.length);if(obj.idx>=limit){toast('本輪題池完成');go('practiceHome');return;}startFullScan(UI.mode);return;}if(!ok){UI.feedback=null;UI.answer=null;UI.hint=Math.max(1,UI.hint);render();return;}if(UI.exercise>=3){completeMission();return;}UI.exercise++;UI.roundId=roundFor(UI.mission.id,UI.exercise,UI.mode);UI.feedback=null;UI.answer=null;UI.hint=0;render();};
ACT.hint=function(){var R=getR(UI.roundId),m=UI.mission,hs=hints(m,R);UI.hint=Math.min(hs.length,UI.hint+1);var st=S.missionStats[m.id]||{wrong:0,hints:0};st.hints++;S.missionStats[m.id]=st;save();if(UI.exercise===0){openSheet('<h3>把它拆小一步</h3>'+hs.slice(0,UI.hint).map(function(x){return'<div class="hintStep">'+esc(x)+'</div>';}).join('')+'<button class="btn primary full" data-act="closeSheet">回圖上再看一次</button>');}else render();};
ACT.closeSheet=function(){closeSheet();};ACT.startPractice=function(){startFullScan('practice');};ACT.startExam=function(){startFullScan('exam');};
document.addEventListener('click',function(e){var el=e.target.closest('[data-act]');if(!el)return;var fn=ACT[el.dataset.act];if(fn)try{fn(el);}catch(err){console.error(err);toast('SYSTEM：'+err.message);}});
// tester convenience: expose reset in console without putting destructive control in learning flow
window.BSGV3={reset:function(){localStorage.removeItem(SAVE_KEY);location.reload();},unlock:function(){S.premium=true;save();location.reload();},state:function(){return JSON.parse(JSON.stringify(S));},_test:{getR:getR,roundFor:roundFor,question:question,qtext:qtext,criterion:criterion,suitable:suitable,chartData:chartData,setupMission:setupMission,ui:UI}};
render();
})();
