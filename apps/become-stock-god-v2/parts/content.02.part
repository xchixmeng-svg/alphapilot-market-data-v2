
// V4 advanced curriculum map. This runs in content.js before app.js loads, so save migration,
// progress totals and unlock logic can see the full course from the first instruction.
(function(root){
  'use strict';
  var CT=root.BSG_CONTENT;if(!CT)return;
  function world(w){if(!CT.WORLDS.some(function(x){return x.id===w.id;}))CT.WORLDS.push(w);}
  function mission(m){if(!CT.MISSIONS.some(function(x){return x.id===m.id;}))CT.MISSIONS.push(m);}
  world({id:7,code:'INDICATORS',title:'讀懂指標',sub:'MACD、KD、RSI 都只是價格證據的輔助',accent:'#c58cff'});
  world({id:8,code:'INTEGRATION',title:'自己做判斷',sub:'畫線、確認反轉、找進場、最後逐日實戰',accent:'#ffb45b'});
  [
    [37,7,'先懂時間週期','日 K、週 K 看的是不同尺度','TIMEFRAME','知道同一檔股票換時間週期，看到的結構可能不同。','短週期看細節、長週期看大結構；先決定自己正在分析哪個尺度。','不要拿 5 分 K 的支撐，直接當成週 K 等級的關鍵支撐。','time'],
    [38,7,'缺口與特殊價格','K 棒中間也可能真的沒有成交','GAP','認得跳空缺口，理解它是價格直接跨過一段區域。','今天開盤若明顯高於昨高或低於昨低，中間可能形成缺口；缺口本身仍要放回結構判斷。','看到缺口不要自動當成必漲或必跌。','gap'],
    [39,7,'MACD 先看什麼','先懂 DIF、訊號線與零軸','MACD_BASE','先把 MACD 當成「趨勢與動能差」的工具。','DIF 在訊號線上方代表近期動能相對較強；零軸上下則提供較長尺度的背景。','黃金交叉不是自動買進鍵。','macd'],
    [40,7,'MACD 柱狀體','看動能是在增強還是收斂','MACD_HIST','讀懂 MACD 柱狀體變長、變短代表什麼。','柱體絕對值擴大＝DIF 與訊號線差距擴大；縮小＝動能差正在收斂。','柱體剛翻紅不代表上方壓力就消失。','macd'],
    [41,7,'MACD 背離','價格創高，不代表動能也創高','MACD_DIVERGENCE','理解價格與 MACD 不同步時，為什麼要提高警覺。','價格創新高、MACD 高點卻降低，叫偏空背離；它是警訊，不是保證反轉。','看到背離不要立刻逆勢進場，先等價格結構真的改變。','macd'],
    [42,7,'KD 先看什麼','K、D 是近期區間裡的位置與動能','KD_BASE','先會讀 KD 的 K 值、D 值與交叉。','K 往上穿 D 可視為短線動能改善證據，但一定要搭配價格位置。','KD 黃金交叉不能蓋過仍在破底的價格結構。','kd'],
    [43,7,'KD 鈍化','80 以上不等於立刻賣，20 以下也不等於立刻買','KD_STICKY','避免把 KD 超買超賣當成反轉按鈕。','強勢趨勢裡 KD 可以長時間維持高檔；弱勢趨勢也可長時間低檔。','不要只因 KD > 80 就放空，也不要只因 KD < 20 就抄底。','kd'],
    [44,7,'RSI 強弱','看近期上漲力與下跌力的比例','RSI','會讀 RSI 的相對強弱，而不是只背 70／30。','RSI 高表示近期上漲力較強、低表示下跌力較強；極端值要配合結構判斷。','RSI 超買超賣不是單獨的買賣訊號。','rsi'],
    [45,7,'指標衝突','價格結構永遠先於指標','INDICATOR_CONFLICT','當 MACD、KD、RSI 和價格結構打架時，知道先相信什麼。','先看價格是否破底／突破／守住支撐，再把指標當輔助證據。','不要用一個漂亮交叉去否定明確破底。','indicators'],
    [46,7,'多證據一起看','結構＋位置＋量價＋指標','CONFLUENCE','把指標放進完整判斷鏈，而不是各自背答案。','價格結構是主角；量、均線、MACD、KD、RSI 是加分或扣分的證據。','證據互相矛盾時，「先觀察」可以是最好的答案。','indicators'],
    [47,8,'自己畫支撐壓力','從系統標示進到你自己找位置','DRAW_LEVEL','自己找出合理支撐／壓力區，而不是等系統把答案畫好。','先找多次反應的區域；畫線允許合理範圍，不要求精準到單一價位。','不要為了貼合每個小轉折而畫出一堆沒有意義的線。','draw'],
    [48,8,'確認反轉','止跌 → 較高低點 → 突破前高','REVERSAL_CONFIRM','把「止跌」與「確認反轉」清楚分開。','下降結構先停止破底，再形成較高低點，最後突破關鍵前高，反轉證據才逐步完整。','一根紅 K、KD 黃金交叉或跌很久，都不等於反轉完成。','reversal'],
    [49,8,'找進場與失策','證據夠了才找可以試的位置','ENTRY_INVALIDATION','同時找進場位置與「哪裡代表我看錯」。','可以在突破、回測守住或重新轉強時考慮；進場前先把失策點說清楚。','不能先決定要買，再把停損硬塞到方便的位置。','entry'],
    [50,8,'逐日 K 線畢業實戰','未來遮住，一天一天重新判斷','DAILY_REVEAL','不用事後答案，只靠當下已知資料做完整判斷。','D0 做第一次判斷；之後逐日揭曉，重新檢查趨勢、位置、指標、失策與是否仍值得出手。','最後漲了不代表前面亂猜是好決策；最後停損也不代表原決策一定差。','daily']
  ].forEach(function(a){mission({id:a[0],world:a[1],title:a[2],sub:a[3],skill:a[4],objective:a[5],rule:a[6],anti:a[7],focus:a[8]});});
})(window);
