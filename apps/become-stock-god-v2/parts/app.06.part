
// V3.4 coach voice override — softer, slower and more feminine on iOS when available.
(function(){
  function storeGet(k,fallback){try{var v=localStorage.getItem(k);return v==null?fallback:v;}catch(e){return fallback;}}
  function scoreVoice(v){
    if(!v)return -999;
    var n=String(v.name||'').toLowerCase(),l=String(v.lang||'').toLowerCase(),s=0;
    if(l==='zh-tw'||l.indexOf('zh-tw')===0)s+=140;
    else if(l.indexOf('zh')===0)s+=55;
    if(/meijia|mei[- ]?jia|tingting|ting[- ]?ting|siri|美佳|婷婷/.test(n))s+=80;
    if(/premium|enhanced|natural/.test(n))s+=55;
    if(/female|女/.test(n))s+=20;
    if(v.localService)s+=8;
    if(/compact|eloquence|espeak|festival|male|男/.test(n))s-=100;
    return s;
  }
  function pickVoice(){
    try{
      var vs=window.speechSynthesis&&window.speechSynthesis.getVoices?window.speechSynthesis.getVoices():[];
      if(!vs||!vs.length)return null;
      return vs.slice().sort(function(a,b){return scoreVoice(b)-scoreVoice(a);})[0]||null;
    }catch(e){return null;}
  }
  function currentText(){
    var el=document.querySelector('.coachSpeechBody');
    if(el&&el.textContent.trim())return el.textContent.trim();
    el=document.querySelector('.homeCoachSpeech span');
    return el&&el.textContent?el.textContent.trim():'';
  }
  function softenText(t){
    return String(t||'')
      .replace(/\s+/g,' ')
      .replace(/。/g,'。　')
      .replace(/，/g,'， ')
      .replace(/：/g,'： ')
      .replace(/；/g,'； ')
      .trim();
  }
  function speakSoft(){
    if(storeGet('bsg_voice','1')==='0'||!('speechSynthesis' in window))return;
    var text=softenText(currentText());if(!text)return;
    try{
      window.speechSynthesis.cancel();
      var u=new SpeechSynthesisUtterance(text);
      u.lang='zh-TW';
      u.rate=.80;
      u.pitch=1.08;
      u.volume=.92;
      var v=pickVoice();if(v)u.voice=v;
      window.speechSynthesis.speak(u);
    }catch(e){}
  }
  document.addEventListener('click',function(e){
    var t=e.target&&e.target.closest?e.target.closest('[data-coach="speak"]'):null;
    if(!t)return;
    e.preventDefault();
    e.stopImmediatePropagation();
    speakSoft();
  },true);
  if('speechSynthesis' in window&&window.speechSynthesis.addEventListener){
    try{window.speechSynthesis.addEventListener('voiceschanged',function(){});}catch(e){}
  }
})();
