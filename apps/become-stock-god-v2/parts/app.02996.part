
// Accuracy pass for the advanced lessons: a gap means the opening price truly clears yesterday's
// range, and the graduation lesson asks concrete decisions from only the bars revealed so far.
var _v4AdvSuitable=suitable;
suitable=function(mid,R){
  if(mid===38){var i=X(0);return R.o[i]>R.h[i-1]||R.o[i]<R.l[i-1];}
  return _v4AdvSuitable(mid,R);
};
var _v4AdvQuestion2=question;
question=function(m,R,ex){
  if(!m||m.id!==50)return _v4AdvQuestion2(m,R,ex);
  var q=criterion(50,R),i=q.i,stop=E.roundToTick(Math.max(.01,q.sup-q.a*.45),'down'),target=q.res>q.c?q.res:maxA(R.h,i-60,i-1),risk=q.c-stop,rr=risk>0?(target-q.c)/risk:0;
  var good=q.trendUp&&q.ma&&q.c>q.ma&&(q.dist==null||q.dist<.08)&&rr>=1.5,poor=q.trendDown||rr<1,decision=good?'證據較完整，可列入可試':poor?'目前不做':'等待更多證據';
  if(ex%3===1)return _advSh(m,ex,['證據較完整，可列入可試','等待更多證據','目前不做'],decision==='證據較完整，可列入可試'?0:decision==='等待更多證據'?1:2);
  if(ex%3===2){var d1=Math.min(i+1,R.c.length-1),s1=R.l[d1]<=stop?'失策已被碰到／跌破':R.c[d1]>q.res?'證據增加，但仍需管理失策':'原論點尚未失效，繼續觀察';return _advSh(m,ex,['失策已被碰到／跌破','證據增加，但仍需管理失策','原論點尚未失效，繼續觀察'],s1.indexOf('失策')===0?0:s1.indexOf('證據增加')===0?1:2);}
  var d2=Math.min(i+2,R.c.length-1),breach=minA(R.l,i+1,d2)<=stop;
  return _advSh(m,ex,['D0 到 D+2 已觸發原失策','D0 到 D+2 尚未觸發原失策','只看最後損益就能判斷決策好壞'],breach?0:1);
};
var _v4AdvQtext2=qtext;
qtext=function(m,R,ex){
  if(!m||m.id!==50)return _v4AdvQtext2(m,R,ex);
  var q=criterion(50,R),i=q.i,stop=E.roundToTick(Math.max(.01,q.sup-q.a*.45),'down'),target=q.res>q.c?q.res:maxA(R.h,i-60,i-1),risk=q.c-stop,rr=risk>0?(target-q.c)/risk:0;
  if(ex%3===1)return'D0 未來全部遮住。依目前趨勢、MA20、位置與 R:R 約 '+rr.toFixed(2)+'，第一個決策是什麼？';
  if(ex%3===2)return'現在只多揭曉 D+1。對照原失策 '+px(stop)+'，原本論點目前怎麼了？';
  return'再揭曉 D+2。從 D0 到現在，原失策 '+px(stop)+' 有沒有被觸發？';
};
var _v4AdvExplain2=explain;
explain=function(m,R,ans){
  if(!m||m.id!==50)return _v4AdvExplain2(m,R,ans);
  var q=criterion(50,R),i=q.i,stop=E.roundToTick(Math.max(.01,q.sup-q.a*.45),'down'),target=q.res>q.c?q.res:maxA(R.h,i-60,i-1),risk=q.c-stop,rr=risk>0?(target-q.c)/risk:0,d2=Math.min(i+2,R.c.length-1),breach=minA(R.l,i+1,d2)<=stop;
  if(UI.exercise===1)return'D0 只能使用當下資料：趨勢、位置、MA20、量價、失策與上方空間。這張圖 R:R 約 '+rr.toFixed(2)+'。重點不是猜明天，而是做可重複的決策。';
  if(UI.exercise===2)return'D+1 出現後，只問「新證據有沒有讓原論點失效或更完整」，不要因一天損益就重寫理由。原失策仍是 '+px(stop)+'。';
  return'到 D+2 為止，'+(breach?'價格已碰到／跌破原失策。原論點應視為失效。':'原失策尚未被碰到。這不代表最後一定獲利，只代表原論點目前還沒有被價格否定。')+' 最終評分要把結果與決策品質分開。';
};
