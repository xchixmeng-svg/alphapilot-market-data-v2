
/* V7 one-page portrait — the page itself never scrolls or bounces.
   Top bar and bottom tabs stay put; only the box between them may slide (long lists),
   the home dashboard fits one screen, and a lesson keeps chart + question on one screen. */
@media (orientation:portrait) and (max-width:940px){
  html,body{height:var(--app-h,100dvh)!important;min-height:0!important;max-height:var(--app-h,100dvh)!important;overflow:hidden!important;overscroll-behavior:none!important}
  body{position:fixed!important;inset:0!important;width:100%!important}
  #app{height:var(--app-h,100dvh)!important;min-height:0!important;max-height:var(--app-h,100dvh)!important;overflow:hidden!important;display:flex!important;flex-direction:column!important}
  #app>.scanline{display:none!important}
  #app>.hudbar{position:relative!important;top:auto!important;flex:none!important}

  /* content box between the bars */
  #app>main,#app>.main,#app>.paywall,#app>.mastery{flex:1 1 auto!important;min-height:0!important;height:auto!important;max-height:none!important;overflow-x:hidden!important;overflow-y:auto!important;overscroll-behavior:contain!important;-webkit-overflow-scrolling:touch}
  #app>.ckPage{padding-bottom:calc(92px + env(safe-area-inset-bottom,0px))!important}

  /* home dashboard: one screen, no inner scroll */
  #app>.ckDashboard{display:flex!important;flex-direction:column!important;gap:10px!important;overflow:hidden!important;padding:10px 10px calc(84px + env(safe-area-inset-bottom,0px))!important}
  #app>.ckDashboard>*{flex:none!important}
  .ckDashboard .ckProfile{order:1!important;padding:11px 12px!important;gap:6px 12px!important}
  .ckDashboard .ckAvatar{width:56px!important;height:56px!important}
  .ckDashboard .ckStats{padding-top:8px!important}
  .ckDashboard .ckStats b{font-size:18px!important}
  .ckDashboard .ckHero{order:2!important;display:block!important;margin:0!important}
  .ckDashboard .ckHeroCta{margin:0!important;padding:0!important;gap:8px!important}
  .ckDashboard .ckStart{min-height:54px!important}
  .ckDashboard .ckCtaRow .ckBtn{min-height:48px!important}
  #app>.ckDashboard>.ckFeatures{order:3!important;flex:1 1 0!important;min-height:104px!important;max-height:196px!important}
  .ckDashboard .ckFeat{height:100%!important;min-height:0!important}
  .ckDashboard .ckSection:has(.ckStrip){order:4!important}
  .ckDashboard .ckSection:has(.ckStrip) .ckSecHead{margin-bottom:6px!important}
  .ckDashboard .ckStrip .ckTile{min-height:104px!important}
  /* course map, premium card and fine print live on the 完整課程 / 說明 pages */
  .ckDashboard .ckSection:has(.ckMods),.ckDashboard .ckPremium,.ckDashboard>.legal{display:none!important}

  /* lesson: header, chart filling the middle, question dock at the bottom */
  #app>.main{overflow:hidden!important;display:flex!important;flex-direction:column!important;padding:0!important}
  #app>.main>.training{flex:1 1 auto!important;min-height:0!important;height:auto!important;display:grid!important;grid-template-rows:auto minmax(170px,1fr) auto!important;overflow:hidden!important}
  #app>.main>:not(.training):not(.coachRail){flex:1 1 auto;min-height:0;overflow-y:auto!important}
  #app .trainingHead{position:relative!important;top:auto!important}
  #app .chartArea{height:auto!important;min-height:0!important;padding:6px 6px 0!important}
  #app .chartArea .chartFrame,#app .chartArea .chartwrap{height:100%!important;min-height:0!important}
  #app .lessonDock{min-height:0!important;max-height:calc(var(--app-h,100dvh) * .56)!important;overflow-y:auto!important;overscroll-behavior:contain!important;padding:8px 8px calc(10px + env(safe-area-inset-bottom,0px))!important}
  #app .lessonDock .prompt{margin-bottom:7px!important}

  /* cover: always exactly one screen */
  .ckLanding{overflow:hidden!important;align-items:center!important}
  .ckLanding .ckLandingFrame{max-height:var(--app-h,100dvh)!important}
}
/* short screens (iPhone SE, Safari with toolbars): drop the course strip, keep the rest */
@media (orientation:portrait) and (max-width:940px) and (max-height:720px){
  .ckDashboard .ckSection:has(.ckStrip){display:none!important}
  #app>.main>.training{grid-template-rows:auto minmax(150px,1fr) auto!important}
}
@media (orientation:portrait) and (max-width:940px) and (max-height:600px){
  .ckDashboard .ckStats{display:none!important}
  #app .lessonDock{max-height:calc(var(--app-h,100dvh) * .6)!important}
}
