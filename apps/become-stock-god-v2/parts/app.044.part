
// V4 chart-learning foundation. It is loaded immediately before the V3.5 visual transformer.
// Because V3.5 captures this create() wrapper, this transform runs AFTER the mission-specific
// visual transform and can enforce shared pedagogy rules without changing each legacy mission.
(function(){
  'use strict';
  if(!window.BSGChart||typeof window.BSGChart.create!=='function')return;
  var baseCreate=window.BSGChart.create;
  function api(){return window.BSGV3&&window.BSGV3._test?window.BSGV3._test:null;}
  function minA(a,s,e){var v=Infinity;for(var i=Math.max(0,s);i<=Math.min(a.length-1,e);i++)if(Number.isFinite(a[i]))v=Math.min(v,a[i]);return v;}
  function maxA(a,s,e){var v=-Infinity;for(var i=Math.max(0,s);i<=Math.min(a.length-1,e);i++)if(Number.isFinite(a[i]))v=Math.max(v,a[i]);return v;}
  function argExtreme(a,s,e,wantMax){var lo=Math.max(0,s),hi=Math.min(a.length-1,e),best=lo,v=wantMax?-Infinity:Infinity;for(var i=lo;i<=hi;i++){if(!Number.isFinite(a[i]))continue;if((wantMax&&a[i]>v)||(!wantMax&&a[i]<v)){v=a[i];best=i;}}return best;}
  function uniquePrices(a){var seen={},out=[];a.forEach(function(p){if(!Number.isFinite(p)||p<=0)return;var k=String(Math.round(p*10000));if(seen[k])return;seen[k]=1;out.push(p);});return out;}
  function missionId(){var a=api(),m=a&&a.ui&&a.ui.mission;return m?+m.id:0;}
  function enforce(d){
    if(!d||!d.R)return d;
    var a=api(),ui=a&&a.ui,mid=missionId(),R=d.R,i=d.d0Idx,c=R.c[i],o=R.o[i],atr=(R.atr&&R.atr[i])||c*.02;
    var sup=minA(R.l,i-20,i-1),res=maxA(R.h,i-20,i-1),quiz=!!(ui&&ui.mode==='mission'&&ui.exercise>0),out=Object.assign({},d);
    var top=Math.max(o,c),bottom=Math.min(o,c),pc=R.c[i-1],q=a&&a.criterion?a.criterion(mid,R):null;
    out.priceGuides=uniquePrices(out.priceGuides||[]);

    // First three teaching modules: tapping a candle cannot bypass the lesson by opening a full
    // OHLC tooltip. The chart itself supplies only the evidence the current concept needs.
    if(mid>=1&&mid<=18)out.allowCross=false;

    if(mid===1){
      out.hideAxisTicks=true;out.lines=[];
      out.priceGuides=uniquePrices([R.h[i],o,c,R.l[i]]);
      if(quiz)out.markers=[];
      else out.markers=[
        {idx:i,price:R.h[i],label:'最高價',color:'#ffd44a',prefer:'above'},
        {idx:i,price:o,label:'開盤價',color:'#9876ff',prefer:'side'},
        {idx:i,price:c,label:'收盤價',color:'#39f5ff',prefer:'side'},
        {idx:i,price:R.l[i],label:'最低價',color:'#24d79b',prefer:'below'}
      ];
    }
    if(mid===2){
      out.hideAxisTicks=true;out.lines=[];out.priceGuides=uniquePrices([R.h[i],top,bottom,R.l[i]]);
      out.markers=quiz?[]:[{idx:i,price:o,label:'開盤',color:'#9876ff',prefer:'side'},{idx:i,price:c,label:'收盤',color:'#39f5ff',prefer:'side'}];
    }
    if(mid===3){
      out.hideAxisTicks=true;out.lines=[];out.priceGuides=uniquePrices([o,c]);
      out.markers=quiz?[]:[{idx:i,price:o,label:'開盤',color:'#9876ff',prefer:'side'},{idx:i,price:c,label:'收盤',color:'#39f5ff',prefer:'side'}];
    }
    if(mid===4){
      out.hideAxisTicks=true;out.lines=[];out.priceGuides=uniquePrices([R.h[i],top,bottom,R.l[i]]);
      out.markers=quiz?[]:[
        {idx:i,price:R.h[i],label:'最高價',color:'#ffd44a',prefer:'above'},
        {idx:i,price:top,label:'實體上緣',color:'#39f5ff',prefer:'side'},
        {idx:i,price:bottom,label:'實體下緣',color:'#9876ff',prefer:'side'},
        {idx:i,price:R.l[i],label:'最低價',color:'#24d79b',prefer:'below'}
      ];
    }
    if(mid===5){
      out.hideAxisTicks=true;out.lines=[];out.priceGuides=uniquePrices([pc,o,c]);
      out.markers=[
        {idx:i-1,price:pc,label:'昨收',color:'#9876ff',prefer:'side'},
        {idx:i,price:o,label:'今開',color:'#ffd44a',prefer:'side'},
        {idx:i,price:c,label:'今收',color:'#39f5ff',prefer:'side'}
      ];
    }
    if(mid===6){
      out.priceGuides=[];
      if(quiz)out.markers=(out.markers||[]).filter(function(m){return /^D-?\d+$/.test(m.label||'')||m.label==='D0';});
    }
    if(mid===7){
      if(quiz){out.markers=[];out.priceGuides=uniquePrices([res,sup,c]);}
      else out.priceGuides=uniquePrices([res,c]);
    }
    if(mid===8||mid===9)out.priceGuides=[];
    if(mid===10){
      var h1=argExtreme(R.h,i-24,i-13,true),h2=argExtreme(R.h,i-12,i,true),l1=argExtreme(R.l,i-24,i-13,false),l2=argExtreme(R.l,i-12,i,false);
      out.markers=[
        {idx:h1,price:R.h[h1],label:'前段高',color:'#ffd44a',prefer:'above'},
        {idx:h2,price:R.h[h2],label:'後段高',color:'#ff9f43',prefer:'above'},
        {idx:l1,price:R.l[l1],label:'前段低',color:'#9876ff',prefer:'below'},
        {idx:l2,price:R.l[l2],label:'後段低',color:'#39f5ff',prefer:'below'}
      ];
    }
    if(mid===11){
      if(quiz){out.lines=[];out.zones=[];out.markers=[];}
      else out.lines=[{price:res,color:'#ff9f43',label:'重疊區上緣',dash:true},{price:sup,color:'#24d79b',label:'重疊區下緣',dash:true}];
    }
    if(mid===12){
      var ph=maxA(R.h,i-12,i-1),phi=argExtreme(R.h,i-12,i-1,true);
      out.lines=[{price:ph,color:'#ff9f43',label:quiz?'前高基準':'前一重要高點',dash:true}];
      out.markers=[{idx:phi,price:ph,label:'前高',color:'#ff9f43',prefer:'above'},{idx:i,price:c,label:'D0 收盤',color:'#39f5ff',prefer:'side'}];
    }

    // M13/M14 — teach the zone by name, then remove semantic labels and leave exact candidate
    // prices so the learner must find the repeated reaction area from the chart.
    if(mid===13||mid===14){
      if(quiz){out.zones=[];out.markers=[];out.lines=[];out.priceGuides=uniquePrices([sup,res,c]);}
      else out.priceGuides=uniquePrices([mid===13?sup:res,c]);
    }

    // M15 — the boundary names are legitimate coordinate labels; the learner still has to locate
    // D0 inside the range and reason about remaining upside/downside.
    if(mid===15){
      out.priceGuides=uniquePrices([sup,res,c]);
    }

    // M16 — pressure line is evidence. Practice keeps the reference but removes any verdict word.
    if(mid===16){
      out.zones=(out.zones||[]).map(function(z){return Object.assign({},z,{label:quiz?'前段壓力區':'前 20 日壓力'});});
      out.lines=(out.lines||[]).map(function(l){return Object.assign({},l,{label:quiz?'壓力基準':l.label});});
      out.markers=quiz?[]:out.markers;
    }

    // M17 — legacy labels literally said "假突破" / "跌回區間". Keep the same geometry but
    // rename the evidence so practice requires the learner to infer the failure.
    if(mid===17){
      var r17=maxA(R.h,i-22,i-3),b17=argExtreme(R.c,i-2,i-1,true);
      out.zones=(out.zones||[]).map(function(z){return Object.assign({},z,{label:'原壓力區'});});
      out.lines=[{price:r17,color:'#ff9f43',label:'原壓力',dash:true}];
      if(quiz)out.markers=[
        {idx:b17,price:R.c[b17],label:'突破時收盤',color:'#ffd44a',prefer:'above'},
        {idx:i,price:c,label:'D0 收盤',color:'#39f5ff',prefer:'below'}
      ];
    }

    // M18 — "突破" and "回測" are the lesson target, so practice uses neutral time labels.
    if(mid===18){
      var r18=maxA(R.h,i-25,i-6),bi=argExtreme(R.c,i-5,i-1,true);
      out.zones=(out.zones||[]).map(function(z){return Object.assign({},z,{label:quiz?'原壓力區':'原壓力 → 回測區'});});
      out.lines=[{price:r18,color:'#ff9f43',label:quiz?'壓力基準':'回測基準',dash:true}];
      if(quiz)out.markers=[
        {idx:bi,price:R.c[bi],label:'前一段收盤',color:'#ffd44a',prefer:'above'},
        {idx:i,price:c,label:'D0 收盤',color:'#39f5ff',prefer:'below'}
      ];
    }

    if(mid===31){
      var st31=window.BSG.roundToTick(Math.max(.01,sup-atr*.45),'down');
      out.lines=(out.lines||[]).map(function(l){return /失策/.test(l.label||'')?Object.assign({},l,{price:st31}):l;});
      if(quiz){out.zones=[];out.lines=[];out.markers=[];out.priceGuides=uniquePrices([st31,sup,c]);}
    }
    if(quiz&&mid===32){
      var tg32=res>c?res:maxA(R.h,i-60,i-1);
      out.lines=[];out.priceGuides=uniquePrices([tg32,sup,c]);
    }
    if(mid===33||mid===35){
      var st=window.BSG.roundToTick(Math.max(.01,sup-atr*.45),'down');
      out.lines=(out.lines||[]).map(function(l){return /失策/.test(l.label||'')?Object.assign({},l,{price:st}):l;});
    }
    return out;
  }
  window.BSGChart.create=function(wrap,opt){
    opt=opt||{};var getter=opt.getData,next=Object.assign({},opt);
    next.getData=function(){return enforce(getter?getter():null);};
    return baseCreate(wrap,next);
  };
  window.BSG_V4_FOUNDATION={version:'learning-foundation-v4',transform:enforce,uniquePrices:uniquePrices};
})();
