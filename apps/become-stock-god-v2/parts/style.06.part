
/* V3.4 mobile readability + living coach */
.coachPortrait,.homeCoachPortrait{position:relative!important;isolation:isolate!important;overflow:hidden!important;background-image:linear-gradient(to top,rgba(2,8,18,.98) 0,rgba(2,8,18,.22) 30%,transparent 64%)!important;background-color:#04101d!important}
.coachPortrait::before,.homeCoachPortrait::before{content:"";position:absolute;z-index:1;inset:-1%;background-image:url("__COACH_ASSET__");background-repeat:no-repeat;background-position:center 18%;background-size:cover;transform-origin:50% 80%;animation:coachIdle 5.2s ease-in-out infinite;will-change:transform,filter}
.coachPortrait::after,.homeCoachPortrait::after{content:"";position:absolute;z-index:2;inset:0;pointer-events:none;background:radial-gradient(circle at 52% 42%,rgba(57,245,255,.08),transparent 48%),linear-gradient(to top,rgba(2,8,18,.72),transparent 45%);animation:coachGlow 3.8s ease-in-out infinite}
.coachIdentity,.homeCoachSpeech{z-index:4!important}
@keyframes coachIdle{0%,100%{transform:translate3d(0,0,0) scale(1.005);filter:brightness(1)}50%{transform:translate3d(0,-4px,0) scale(1.018);filter:brightness(1.045)}}
@keyframes coachGlow{0%,100%{opacity:.74}50%{opacity:1}}
.coachSpeak{margin-top:7px;min-height:36px;border:1px solid rgba(57,245,255,.45);border-radius:9px;background:rgba(10,47,72,.72);color:#dffaff;font-weight:900;font-size:13px;padding:7px 10px}
.soundBtn{font-size:17px!important}
.audioMixer{display:flex;align-items:center;gap:4px}.audioBtn{min-width:32px;height:32px;border:1px solid rgba(87,190,232,.34);border-radius:9px;background:#081b2d;color:#eafaff;font-size:16px}.audioBtn.off{opacity:.45}
@media(prefers-reduced-motion:reduce){.coachPortrait::before,.homeCoachPortrait::before,.coachPortrait::after,.homeCoachPortrait::after{animation:none!important}}

/* portrait phone: large type first */
@media (orientation:portrait) and (max-width:940px){
 html,body{font-size:17px!important;line-height:1.58!important}
 .hudbar{height:62px!important;min-height:62px!important}.brandname{font-size:16px!important}.brandname b{font-size:19px!important}.hudpill{font-size:12px!important}.iconbtn,.audioBtn{font-size:18px!important;min-width:38px!important;width:38px!important;height:38px!important}
 .homebody{padding:14px 12px 30px!important}.heroPanel{padding:24px 20px!important}.kicker{font-size:13px!important}.heroTitle{font-size:46px!important;line-height:1.03!important}.heroLead{font-size:17px!important;line-height:1.72!important}.ctaRow .btn{font-size:16px!important;min-height:54px!important;padding:11px 15px!important}
 .statLabel{font-size:12px!important}.statValue{font-size:30px!important}.statBox{padding:15px!important}.worldCard .wc{font-size:11px!important}.worldCard .wt{font-size:21px!important}.worldCard .ws{font-size:15px!important;line-height:1.55!important}
 .homeCoach{min-height:330px!important;padding:10px!important}.homeCoachSpeech{padding:12px!important}.homeCoachSpeech b{font-size:14px!important}.homeCoachSpeech span{font-size:16px!important;line-height:1.6!important}.homeCoachPortrait{min-height:245px!important;aspect-ratio:16/10!important}.homeCoachPortrait::before{background-size:cover!important;background-position:center 16%!important;transform-origin:center 55%!important}
 .trainingHead{min-height:58px!important}.trainTitle strong{font-size:17px!important}.trainTitle span{font-size:13px!important}.missionTag{font-size:12px!important}
 .question{font-size:21px!important;line-height:1.55!important}.qtag{font-size:13px!important}.explain,.coachLine{font-size:15px!important;line-height:1.58!important}.answer{font-size:17px!important;line-height:1.5!important;min-height:70px!important}.answerHelp,.feedbackBox{font-size:15px!important;line-height:1.55!important}.btn{font-size:16px!important}
 .coachRail{width:136px!important;height:202px!important}.coachRail .coachPortrait::before{background-size:cover!important;background-position:center 12%!important}.coachRail .coachIdentity strong{font-size:13px!important}
}

/* short landscape: prioritize readable question/answers/coach over maximum chart area */
@media (orientation:landscape) and (max-height:520px){
 .hudbar{height:46px!important;min-height:46px!important}.brandname{font-size:14px!important}.lv,.hudpill{font-size:11px!important}.iconbtn,.audioBtn{width:34px!important;min-width:34px!important;height:34px!important;font-size:16px!important}
 .homebody{height:calc(var(--app-h,100dvh) - 46px)!important}.heroGrid:has(>.homeCoach){grid-template-columns:minmax(0,1fr) 205px 205px!important}.kicker{font-size:10px!important}.heroLead{font-size:12px!important;line-height:1.45!important;max-height:72px!important}.ctaRow .btn{font-size:12px!important;min-height:40px!important}.statLabel{font-size:9px!important}.statValue{font-size:19px!important}.homeCoachSpeech b{font-size:11px!important}.homeCoachSpeech span{font-size:11px!important;line-height:1.45!important}.coachSpeak{font-size:10px!important;min-height:29px!important}
 .main:has(>.training){height:calc(var(--app-h,100dvh) - 46px)!important;grid-template-columns:160px minmax(0,1fr) 205px!important}
 .sidehead{padding:7px!important}.worldtitle{font-size:14px!important}.missionrow{padding:5px!important;gap:5px!important}.missionrow .num{width:25px!important;height:25px!important;font-size:10px!important}.missionrow .tt{font-size:11px!important;line-height:1.25!important}
 .main:has(>.training)>.training{grid-template-rows:38px minmax(0,1fr) 148px!important}.trainingHead{padding:4px 7px!important}.missionTag{font-size:10px!important;padding:5px 7px!important}.trainTitle strong{font-size:13px!important}.chartlegend{font-size:10px!important;padding:4px 5px!important}.chartctl.v3 button{height:25px!important;min-width:31px!important;font-size:10px!important}
 .lessonDock{height:148px!important;padding:6px!important}.dockGrid{grid-template-columns:minmax(0,1.05fr) minmax(235px,.95fr)!important;gap:6px!important}.prompt{padding:7px 9px!important}.qtag{font-size:10px!important}.question{font-size:16px!important;line-height:1.32!important}.explain,.coachLine{font-size:11px!important;line-height:1.35!important;padding:4px 5px!important}.answers{gap:5px!important}.answer{min-height:40px!important;font-size:13px!important;line-height:1.2!important;padding:5px 6px!important}.answerHelp{font-size:10px!important}.feedbackBox{font-size:11px!important;line-height:1.3!important;padding:4px 6px!important}.btn{font-size:12px!important;min-height:34px!important}
 .coachRail{padding:6px!important;gap:5px!important}.coachPortrait::before{background-size:cover!important;background-position:center 15%!important;transform-origin:center 58%!important}.coachSpeech{padding:7px 8px!important}.coachSpeechTitle{font-size:11px!important;margin-bottom:3px!important}.coachSpeechBody{font-size:12px!important;line-height:1.38!important;max-height:68px!important}.coachIdentity span{font-size:8px!important}.coachIdentity strong{font-size:13px!important}.coachQuick{gap:3px!important}.coachQuick button{font-size:10px!important;min-height:27px!important}.coachQuick button:first-child{font-size:11px!important;min-height:30px!important}
}
