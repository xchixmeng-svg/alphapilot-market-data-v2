
// 從菜雞到股神 — BGM / SFX only. No voice controls or synthesized speech.
(function(){
  'use strict';
  function storeGet(k,fallback){try{var v=localStorage.getItem(k);return v==null?fallback:v;}catch(e){return fallback;}}
  function storeSet(k,v){try{localStorage.setItem(k,v);}catch(e){}}
  var bgmOn=storeGet('bsg_bgm','1')!=='0';
  var sfxOn=storeGet('bsg_sfx','1')!=='0';
  var ctx=null,bgmStarted=false,userActivated=false,musicTimer=null,bgmBus=null,chordIndex=0;
  // Calm, consonant C-major loop (I – vi – IV/C – V/B): no chromatic shifts between chords, every voice ≥ 220 Hz.
  var CHORDS=[
    [261.63,329.63,392.00,523.25],
    [220.00,261.63,329.63,440.00],
    [261.63,349.23,440.00,523.25],
    [246.94,293.66,392.00,493.88]
  ];
  var MIN_BGM_HZ=220;
  function ac(){
    try{
      var AC=window.AudioContext||window.webkitAudioContext;if(!AC)return null;
      if(!ctx)ctx=new AC();
      if(ctx.state==='suspended'){var p=ctx.resume();if(p&&p.catch)p.catch(function(){});}
      return ctx;
    }catch(e){return null;}
  }
  function stopBgm(){
    if(musicTimer){clearInterval(musicTimer);musicTimer=null;}
    if(bgmBus){try{bgmBus.disconnect();}catch(e){}bgmBus=null;}
    bgmStarted=false;
  }
  // Pure sine pad: a single oscillator per voice (no detuned pair, so no beating / wobble), slow swell.
  function airyPad(c,freq,when,dur,level){
    if(!bgmBus)return;
    try{
      var o=c.createOscillator(),g=c.createGain(),f=c.createBiquadFilter();
      o.type='sine';o.frequency.setValueAtTime(freq,when);
      f.type='lowpass';f.frequency.setValueAtTime(1400,when);f.Q.value=.3;
      g.gain.setValueAtTime(.0001,when);g.gain.exponentialRampToValueAtTime(level,when+1.8);g.gain.setValueAtTime(level,when+dur-2.2);g.gain.exponentialRampToValueAtTime(.0001,when+dur);
      o.connect(f);f.connect(g);g.connect(bgmBus);o.start(when);o.stop(when+dur+.1);
    }catch(e){}
  }
  // Soft felt-piano note: sine body with a quiet, exactly-octave overtone and a gentle 40 ms attack.
  function softPiano(c,freq,when,level){
    if(!bgmBus)return;
    try{
      var o=c.createOscillator(),h=c.createOscillator(),g=c.createGain(),hg=c.createGain(),f=c.createBiquadFilter();
      o.type='sine';o.frequency.setValueAtTime(freq,when);
      h.type='sine';h.frequency.setValueAtTime(freq*2,when);hg.gain.value=.12;
      f.type='lowpass';f.frequency.setValueAtTime(1800,when);f.frequency.exponentialRampToValueAtTime(900,when+2);
      g.gain.setValueAtTime(.0001,when);g.gain.exponentialRampToValueAtTime(level,when+.04);g.gain.exponentialRampToValueAtTime(level*.45,when+.6);g.gain.exponentialRampToValueAtTime(.0001,when+3.2);
      o.connect(f);h.connect(hg);hg.connect(f);f.connect(g);g.connect(bgmBus);o.start(when);h.start(when);o.stop(when+3.3);h.stop(when+3.3);
    }catch(e){}
  }
  function playChord(c){
    if(!bgmOn||!bgmBus)return;
    var chord=CHORDS[chordIndex%CHORDS.length],now=c.currentTime+.04;
    chord.forEach(function(fr,i){airyPad(c,fr,now,8.6,i===0?.009:.006);});
    // slow rising arpeggio of chord tones, one note every two seconds
    softPiano(c,chord[0],now+.3,.020);
    softPiano(c,chord[1],now+2.3,.017);
    softPiano(c,chord[2],now+4.3,.016);
    softPiano(c,chord[3],now+6.3,.013);
    chordIndex=(chordIndex+1)%CHORDS.length;
  }
  function startBgm(){
    if(!bgmOn||bgmStarted||!userActivated)return;
    var c=ac();if(!c)return;
    try{
      var master=c.createGain(),highpass=c.createBiquadFilter(),lowpass=c.createBiquadFilter(),comp=c.createDynamicsCompressor();
      master.gain.value=.62;
      highpass.type='highpass';highpass.frequency.value=200;highpass.Q.value=.5;
      lowpass.type='lowpass';lowpass.frequency.value=2200;lowpass.Q.value=.3;
      comp.threshold.value=-24;comp.knee.value=20;comp.ratio.value=2;comp.attack.value=.025;comp.release.value=.75;
      master.connect(highpass);highpass.connect(lowpass);lowpass.connect(comp);comp.connect(c.destination);bgmBus=master;
      bgmStarted=true;playChord(c);musicTimer=setInterval(function(){if(bgmOn&&bgmBus)playChord(c);},8000);
    }catch(e){stopBgm();}
  }
  function syncSfx(){storeSet('bsg_sfx',sfxOn?'1':'0');try{if(window.BSG_SOUND_API&&window.BSG_SOUND_API.set)window.BSG_SOUND_API.set(sfxOn);}catch(e){}}
  function setBgm(on){bgmOn=!!on;storeSet('bsg_bgm',bgmOn?'1':'0');if(bgmOn)startBgm();else stopBgm();}
  function setSfx(on){sfxOn=!!on;syncSfx();}
  document.addEventListener('pointerdown',function(){userActivated=true;syncSfx();if(bgmOn)startBgm();},{once:true,passive:true});
  document.addEventListener('click',function(e){
    var b=e.target&&e.target.closest?e.target.closest('[data-audio]'):null;if(!b)return;
    userActivated=true;var k=b.getAttribute('data-audio');
    if(k==='bgm')setBgm(!bgmOn);
    else if(k==='sfx')setSfx(!sfxOn);
  },true);
  window.addEventListener('pagehide',stopBgm);
  window.addEventListener('pageshow',function(){if(userActivated&&bgmOn)startBgm();});
  window.BSG_AUDIO_MIXER={
    state:function(){return {bgm:bgmOn,sfx:sfxOn,started:bgmStarted,activated:userActivated,music:'calm-felt-piano-v3',minHz:MIN_BGM_HZ};},
    setBgm:setBgm,setSfx:setSfx,sync:function(){syncSfx();}
  };
})();
