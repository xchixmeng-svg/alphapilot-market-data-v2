
// V3.4 audio mixer — independent BGM / SFX / coach voice.
(function(){
  function storeGet(k,fallback){try{var v=localStorage.getItem(k);return v==null?fallback:v;}catch(e){return fallback;}}
  function storeSet(k,v){try{localStorage.setItem(k,v);}catch(e){}}
  var bgmOn=storeGet('bsg_bgm','1')!=='0';
  var sfxOn=storeGet('bsg_sfx','1')!=='0';
  var voiceOn=storeGet('bsg_voice','1')!=='0';
  var ctx=null,bgmStarted=false,queued=false,userActivated=false,musicTimer=null,bgmBus=null,chordIndex=0;
  var CHORDS=[
    [130.81,164.81,196.00,246.94],
    [110.00,130.81,164.81,196.00],
    [87.31,130.81,164.81,196.00],
    [98.00,146.83,196.00,220.00]
  ];

  function ac(){
    try{
      var AC=window.AudioContext||window.webkitAudioContext;if(!AC)return null;
      if(!ctx)ctx=new AC();
      if(ctx.state==='suspended'){var p=ctx.resume();if(p&&p.catch)p.catch(function(){});}
      return ctx;
    }catch(e){return null;}
  }
  function stopBgm(){
    if(musicTimer){clearInterval(musicTimer);musicTimer=null;}
    if(bgmBus){try{bgmBus.disconnect();}catch(e){}bgmBus=null;}
    bgmStarted=false;
  }
  function padTone(c,freq,when,dur,level){
    if(!bgmBus)return;
    try{
      var o=c.createOscillator(),g=c.createGain(),f=c.createBiquadFilter();
      o.type='sine';o.frequency.setValueAtTime(freq,when);
      f.type='lowpass';f.frequency.setValueAtTime(1150,when);f.Q.value=.55;
      g.gain.setValueAtTime(.0001,when);g.gain.exponentialRampToValueAtTime(level,when+1.25);g.gain.setValueAtTime(level,when+dur-1.6);g.gain.exponentialRampToValueAtTime(.0001,when+dur);
      o.connect(f);f.connect(g);g.connect(bgmBus);o.start(when);o.stop(when+dur+.1);
    }catch(e){}
  }
  function softPluck(c,freq,when,level){
    if(!bgmBus)return;
    try{
      var o=c.createOscillator(),g=c.createGain(),f=c.createBiquadFilter();
      o.type='triangle';o.frequency.setValueAtTime(freq,when);
      f.type='lowpass';f.frequency.setValueAtTime(2200,when);f.frequency.exponentialRampToValueAtTime(900,when+1.5);
      g.gain.setValueAtTime(.0001,when);g.gain.exponentialRampToValueAtTime(level,when+.025);g.gain.exponentialRampToValueAtTime(.0001,when+1.8);
      o.connect(f);f.connect(g);g.connect(bgmBus);o.start(when);o.stop(when+1.9);
    }catch(e){}
  }
  function playChord(c){
    if(!bgmOn||!bgmBus)return;
    var chord=CHORDS[chordIndex%CHORDS.length],now=c.currentTime+.04;
    chord.forEach(function(fr,i){padTone(c,fr,now,8.1,i===0?.022:.017);});
    softPluck(c,chord[1]*2,now+.8,.018);
    softPluck(c,chord[2]*2,now+2.55,.016);
    softPluck(c,chord[3]*2,now+4.35,.018);
    softPluck(c,chord[2]*2,now+6.1,.014);
    chordIndex=(chordIndex+1)%CHORDS.length;
  }
  function startBgm(){
    if(!bgmOn||bgmStarted||!userActivated)return;
    var c=ac();if(!c)return;
    try{
      var master=c.createGain(),filter=c.createBiquadFilter(),comp=c.createDynamicsCompressor();
      master.gain.value=.78;
      filter.type='lowpass';filter.frequency.value=2400;filter.Q.value=.4;
      comp.threshold.value=-22;comp.knee.value=18;comp.ratio.value=2.2;comp.attack.value=.02;comp.release.value=.6;
      master.connect(filter);filter.connect(comp);comp.connect(c.destination);bgmBus=master;
      bgmStarted=true;playChord(c);musicTimer=setInterval(function(){if(bgmOn&&bgmBus)playChord(c);},8000);
    }catch(e){stopBgm();}
  }
  function setTxt(el,txt){if(el&&el.textContent!==txt)el.textContent=txt;}
  function setOff(el,off){if(el&&el.classList.contains('off')!==off)el.classList.toggle('off',off);}
  function syncLegacySfx(){
    storeSet('bsg_sfx',sfxOn?'1':'0');
    var old=document.querySelector('[data-coach="sound"]');if(!old)return;
    var oldOn=old.textContent!=='🔇';
    if(oldOn!==sfxOn){try{old.click();}catch(e){}}
  }
  function renderControls(){
    var stats=document.querySelector('.hudstats');if(!stats)return;
    var wrap=stats.querySelector('.audioMixer');
    if(!wrap){
      wrap=document.createElement('div');wrap.className='audioMixer';
      wrap.innerHTML='<button class="audioBtn" data-audio="bgm" aria-label="背景音樂"></button><button class="audioBtn" data-audio="sfx" aria-label="音效"></button><button class="audioBtn" data-audio="voice" aria-label="教練語音"></button>';
      var fs=stats.querySelector('[data-coach="fullscreen"]');
      try{stats.insertBefore(wrap,fs&&fs.parentNode===stats?fs:null);}catch(e){stats.appendChild(wrap);}
    }
    var b=wrap.querySelector('[data-audio="bgm"]'),s=wrap.querySelector('[data-audio="sfx"]'),v=wrap.querySelector('[data-audio="voice"]');
    setTxt(b,bgmOn?'🎵':'🎵×');setOff(b,!bgmOn);
    setTxt(s,sfxOn?'🔔':'🔕');setOff(s,!sfxOn);
    setTxt(v,voiceOn?'🗣️':'🤐');setOff(v,!voiceOn);
  }
  function sync(){renderControls();syncLegacySfx();}
  function queueSync(){if(queued)return;queued=true;requestAnimationFrame(function(){queued=false;sync();});}
  function closestFromTarget(t,sel){return t&&t.closest?t.closest(sel):null;}

  document.addEventListener('pointerdown',function(){userActivated=true;if(bgmOn)startBgm();},{once:true,passive:true});
  document.addEventListener('click',function(e){
    var ab=closestFromTarget(e.target,'[data-audio]');
    if(ab){
      userActivated=true;
      var k=ab.getAttribute('data-audio');
      if(k==='bgm'){
        bgmOn=!bgmOn;storeSet('bsg_bgm',bgmOn?'1':'0');
        if(bgmOn)startBgm();else stopBgm();
      }else if(k==='sfx'){
        sfxOn=!sfxOn;syncLegacySfx();
      }else if(k==='voice'){
        voiceOn=!voiceOn;storeSet('bsg_voice',voiceOn?'1':'0');
        if(!voiceOn&&'speechSynthesis' in window)try{window.speechSynthesis.cancel();}catch(x){}
      }
      renderControls();return;
    }
  },true);
  document.addEventListener('click',function(e){
    if(!voiceOn&&closestFromTarget(e.target,'[data-coach="speak"]')){e.preventDefault();e.stopImmediatePropagation();}
  },true);

  var root=document.getElementById('app');
  if(root)new MutationObserver(queueSync).observe(root,{childList:true,subtree:true});
  window.addEventListener('pagehide',stopBgm);
  window.addEventListener('pageshow',function(){queueSync();});
  window.BSG_AUDIO_MIXER={
    state:function(){return {bgm:bgmOn,sfx:sfxOn,voice:voiceOn,started:bgmStarted,activated:userActivated,music:'ambient-chords-v1'};},
    sync:queueSync
  };
  queueSync();
})();
