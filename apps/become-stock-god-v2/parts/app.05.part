
// V3.5 audio mixer — independent BGM / SFX / coach voice.
// BGM fundamentals are deliberately >= 220 Hz; a 205 Hz high-pass removes low-frequency hum.
(function(){
  function storeGet(k,fallback){try{var v=localStorage.getItem(k);return v==null?fallback:v;}catch(e){return fallback;}}
  function storeSet(k,v){try{localStorage.setItem(k,v);}catch(e){}}
  var bgmOn=storeGet('bsg_bgm','1')!=='0';
  var sfxOn=storeGet('bsg_sfx','1')!=='0';
  var voiceOn=storeGet('bsg_voice','1')!=='0';
  var ctx=null,bgmStarted=false,queued=false,userActivated=false,musicTimer=null,bgmBus=null,chordIndex=0;
  var CHORDS=[
    [261.63,329.63,392.00,493.88],
    [220.00,277.18,329.63,440.00],
    [246.94,293.66,369.99,493.88],
    [293.66,349.23,440.00,523.25]
  ];
  var MIN_BGM_HZ=220;

  function ac(){
    try{
      var AC=window.AudioContext||window.webkitAudioContext;if(!AC)return null;
      if(!ctx)ctx=new AC();
      if(ctx.state==='suspended'){var p=ctx.resume();if(p&&p.catch)p.catch(function(){});}
      return ctx;
    }catch(e){return null;}
  }
  function stopBgm(){
    if(musicTimer){clearInterval(musicTimer);musicTimer=null;}
    if(bgmBus){try{bgmBus.disconnect();}catch(e){}bgmBus=null;}
    bgmStarted=false;
  }
  function airyPad(c,freq,when,dur,level,detune){
    if(!bgmBus)return;
    try{
      var o=c.createOscillator(),o2=c.createOscillator(),g=c.createGain(),f=c.createBiquadFilter();
      o.type='sine';o.frequency.setValueAtTime(freq,when);
      o2.type='sine';o2.frequency.setValueAtTime(freq,when);o2.detune.setValueAtTime(detune||5,when);
      f.type='lowpass';f.frequency.setValueAtTime(1800,when);f.Q.value=.35;
      g.gain.setValueAtTime(.0001,when);g.gain.exponentialRampToValueAtTime(level,when+1.1);g.gain.setValueAtTime(level,when+dur-1.5);g.gain.exponentialRampToValueAtTime(.0001,when+dur);
      o.connect(f);o2.connect(f);f.connect(g);g.connect(bgmBus);o.start(when);o2.start(when);o.stop(when+dur+.1);o2.stop(when+dur+.1);
    }catch(e){}
  }
  function softPiano(c,freq,when,level){
    if(!bgmBus)return;
    try{
      var o=c.createOscillator(),h=c.createOscillator(),g=c.createGain(),hg=c.createGain(),f=c.createBiquadFilter();
      o.type='triangle';o.frequency.setValueAtTime(freq,when);
      h.type='sine';h.frequency.setValueAtTime(freq*2,when);hg.gain.value=.22;
      f.type='lowpass';f.frequency.setValueAtTime(2600,when);f.frequency.exponentialRampToValueAtTime(1050,when+1.65);
      g.gain.setValueAtTime(.0001,when);g.gain.exponentialRampToValueAtTime(level,when+.018);g.gain.exponentialRampToValueAtTime(level*.34,when+.34);g.gain.exponentialRampToValueAtTime(.0001,when+2.2);
      o.connect(f);h.connect(hg);hg.connect(f);f.connect(g);g.connect(bgmBus);o.start(when);h.start(when);o.stop(when+2.25);h.stop(when+2.25);
    }catch(e){}
  }
  function softBell(c,freq,when,level){
    if(!bgmBus)return;
    try{
      var o=c.createOscillator(),h=c.createOscillator(),g=c.createGain(),hg=c.createGain();
      o.type='sine';o.frequency.setValueAtTime(freq,when);
      h.type='sine';h.frequency.setValueAtTime(freq*2.01,when);hg.gain.value=.18;
      g.gain.setValueAtTime(.0001,when);g.gain.exponentialRampToValueAtTime(level,when+.012);g.gain.exponentialRampToValueAtTime(.0001,when+2.7);
      o.connect(g);h.connect(hg);hg.connect(g);g.connect(bgmBus);o.start(when);h.start(when);o.stop(when+2.75);h.stop(when+2.75);
    }catch(e){}
  }
  function playChord(c){
    if(!bgmOn||!bgmBus)return;
    var chord=CHORDS[chordIndex%CHORDS.length],now=c.currentTime+.04;
    chord.forEach(function(fr,i){airyPad(c,fr,now,8.15,i===0?.010:.007,4+i*2);});
    softPiano(c,chord[0],now+.55,.023);
    softPiano(c,chord[1],now+2.35,.020);
    softBell(c,chord[2]*2,now+4.15,.010);
    softPiano(c,chord[1],now+5.85,.017);
    softBell(c,chord[3],now+6.85,.008);
    chordIndex=(chordIndex+1)%CHORDS.length;
  }
  function startBgm(){
    if(!bgmOn||bgmStarted||!userActivated)return;
    var c=ac();if(!c)return;
    try{
      var master=c.createGain(),highpass=c.createBiquadFilter(),lowpass=c.createBiquadFilter(),comp=c.createDynamicsCompressor();
      master.gain.value=.62;
      highpass.type='highpass';highpass.frequency.value=205;highpass.Q.value=.7;
      lowpass.type='lowpass';lowpass.frequency.value=3200;lowpass.Q.value=.35;
      comp.threshold.value=-24;comp.knee.value=20;comp.ratio.value=2;comp.attack.value=.025;comp.release.value=.75;
      master.connect(highpass);highpass.connect(lowpass);lowpass.connect(comp);comp.connect(c.destination);bgmBus=master;
      bgmStarted=true;playChord(c);musicTimer=setInterval(function(){if(bgmOn&&bgmBus)playChord(c);},8000);
    }catch(e){stopBgm();}
  }
  function setTxt(el,txt){if(el&&el.textContent!==txt)el.textContent=txt;}
  function setOff(el,off){if(el&&el.classList.contains('off')!==off)el.classList.toggle('off',off);}
  function syncLegacySfx(){
    storeSet('bsg_sfx',sfxOn?'1':'0');
    var old=document.querySelector('[data-coach="sound"]');if(!old)return;
    var oldOn=old.textContent!=='🔇';
    if(oldOn!==sfxOn){try{old.click();}catch(e){}}
  }
  function renderControls(){
    var stats=document.querySelector('.hudstats');if(!stats)return;
    var wrap=stats.querySelector('.audioMixer');
    if(!wrap){
      wrap=document.createElement('div');wrap.className='audioMixer';
      wrap.innerHTML='<button class="audioBtn" data-audio="bgm" aria-label="背景音樂"></button><button class="audioBtn" data-audio="sfx" aria-label="音效"></button><button class="audioBtn" data-audio="voice" aria-label="教練語音"></button>';
      var fs=stats.querySelector('[data-coach="fullscreen"]');
      try{stats.insertBefore(wrap,fs&&fs.parentNode===stats?fs:null);}catch(e){stats.appendChild(wrap);}
    }
    var b=wrap.querySelector('[data-audio="bgm"]'),s=wrap.querySelector('[data-audio="sfx"]'),v=wrap.querySelector('[data-audio="voice"]');
    setTxt(b,bgmOn?'🎵':'🎵×');setOff(b,!bgmOn);
    setTxt(s,sfxOn?'🔔':'🔕');setOff(s,!sfxOn);
    setTxt(v,voiceOn?'🗣️':'🤐');setOff(v,!voiceOn);
  }
  function sync(){renderControls();syncLegacySfx();}
  function queueSync(){if(queued)return;queued=true;requestAnimationFrame(function(){queued=false;sync();});}
  function closestFromTarget(t,sel){return t&&t.closest?t.closest(sel):null;}

  document.addEventListener('pointerdown',function(){userActivated=true;if(bgmOn)startBgm();},{once:true,passive:true});
  document.addEventListener('click',function(e){
    var ab=closestFromTarget(e.target,'[data-audio]');
    if(ab){
      userActivated=true;
      var k=ab.getAttribute('data-audio');
      if(k==='bgm'){
        bgmOn=!bgmOn;storeSet('bsg_bgm',bgmOn?'1':'0');
        if(bgmOn)startBgm();else stopBgm();
      }else if(k==='sfx'){
        sfxOn=!sfxOn;syncLegacySfx();
      }else if(k==='voice'){
        voiceOn=!voiceOn;storeSet('bsg_voice',voiceOn?'1':'0');
        if(!voiceOn&&'speechSynthesis' in window)try{window.speechSynthesis.cancel();}catch(x){}
      }
      renderControls();return;
    }
  },true);
  document.addEventListener('click',function(e){
    if(!voiceOn&&closestFromTarget(e.target,'[data-coach="speak"]')){e.preventDefault();e.stopImmediatePropagation();}
  },true);

  var root=document.getElementById('app');
  if(root)new MutationObserver(queueSync).observe(root,{childList:true,subtree:true});
  window.addEventListener('pagehide',stopBgm);
  window.addEventListener('pageshow',function(){queueSync();});
  window.BSG_AUDIO_MIXER={
    state:function(){return {bgm:bgmOn,sfx:sfxOn,voice:voiceOn,started:bgmStarted,activated:userActivated,music:'airy-piano-bell-v2',minHz:MIN_BGM_HZ};},
    sync:queueSync
  };
  queueSync();
})();
