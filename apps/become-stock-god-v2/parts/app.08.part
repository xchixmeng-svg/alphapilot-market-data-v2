
// Product guard — keep the UI text/BGM/SFX-only and remove obsolete voice controls if old markup appears.
(function(){
  'use strict';
  function harden(){
    try{localStorage.setItem('bsg_voice','0');}catch(e){}
    document.querySelectorAll('[data-audio="voice"],[data-coach="speak"]').forEach(function(n){n.remove();});
  }
  harden();
  var root=document.getElementById('app');
  if(root)new MutationObserver(harden).observe(root,{childList:true,subtree:true});
})();
