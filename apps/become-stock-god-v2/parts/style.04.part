/* V3.1 game-shell visual rebuild — reference: neon stock academy */
#app{max-width:none!important;margin:0!important;width:100%!important;height:100vh!important;height:100dvh!important;overflow:hidden!important}
.screen{width:100%!important;max-width:none!important;background:
 radial-gradient(circle at 88% 18%,rgba(26,77,255,.18),transparent 24%),
 radial-gradient(circle at 10% 78%,rgba(0,226,255,.10),transparent 26%),
 linear-gradient(180deg,#020817 0%,#030b18 46%,#020711 100%)!important}
.screen:after{content:"";position:absolute;inset:0;pointer-events:none;z-index:-1;background:
 radial-gradient(circle at 15% 20%,rgba(255,255,255,.15) 0 1px,transparent 1.8px),
 radial-gradient(circle at 72% 32%,rgba(57,245,255,.12) 0 1px,transparent 1.8px),
 radial-gradient(circle at 42% 72%,rgba(255,255,255,.10) 0 1px,transparent 1.8px);background-size:140px 140px,170px 170px,210px 210px;opacity:.42}

/* top HUD */
.hudbar{height:76px!important;padding:9px 24px!important;gap:20px!important;border-bottom:1px solid rgba(48,205,255,.36)!important;background:linear-gradient(180deg,rgba(3,10,24,.99),rgba(3,13,28,.93))!important;box-shadow:0 10px 34px rgba(0,0,0,.42),0 1px 24px rgba(0,181,255,.08)!important}
.crown{width:48px!important;height:48px!important;font-size:25px!important;border-radius:13px!important;border-color:rgba(255,204,59,.72)!important;box-shadow:0 0 26px rgba(255,189,45,.30),inset 0 0 15px rgba(255,210,75,.09)!important}
.brandname{font-size:25px!important;letter-spacing:.04em!important;text-shadow:0 0 16px rgba(255,255,255,.08)}
.brandname b{font-size:30px!important;margin-left:5px;color:#ffd44a!important}
.brandsub{font-size:9px!important;letter-spacing:.24em!important;color:#78a9c3!important}
.xpbox{max-width:520px!important;justify-self:center;width:100%!important;border:1px solid rgba(69,162,255,.20);background:linear-gradient(180deg,rgba(11,26,50,.65),rgba(5,16,31,.35));padding:8px 16px;border-radius:12px;box-shadow:inset 0 0 18px rgba(46,142,255,.05)}
.xpbar{max-width:none!important;height:9px!important;background:#07192c!important}.xpbar i{background:linear-gradient(90deg,#b158ff,#63b8ff,#62f5ff)!important}
.lv{font-size:14px!important}.hudpill{height:44px!important;min-width:96px!important;border-color:rgba(59,181,255,.27)!important;background:linear-gradient(180deg,rgba(10,26,47,.92),rgba(4,15,29,.96))!important;font-size:14px!important}.iconbtn{width:44px!important;height:44px!important}

/* overall learning stage */
.main{padding:14px 18px 16px!important;gap:14px!important;background:transparent!important}
.sidebar{width:305px!important;flex:none;border:1px solid rgba(34,205,255,.45)!important;border-radius:18px!important;background:linear-gradient(180deg,rgba(5,18,35,.96),rgba(2,11,24,.97))!important;padding:14px!important;box-shadow:0 0 0 1px rgba(53,188,255,.05) inset,0 0 28px rgba(0,176,255,.09)!important}
.sidehead{border-color:rgba(61,195,255,.34)!important;background:linear-gradient(135deg,rgba(12,55,82,.62),rgba(5,22,39,.72))!important;box-shadow:inset 4px 0 0 #18dfff}
.worldcode{font-size:12px!important}.worldtitle{font-size:24px!important}.worldsub{font-size:12px!important}.worldprog .miniBar{height:8px!important}.worldprog .miniBar i{background:linear-gradient(90deg,#18ecae,#20e5ff)!important}
.missionrow{min-height:56px!important;border-radius:13px!important;padding:9px 10px!important;border-color:rgba(64,139,191,.23)!important;background:linear-gradient(90deg,rgba(8,28,48,.94),rgba(5,19,35,.85))!important}.missionrow .num{width:36px!important;height:36px!important}.missionrow .tt{font-size:14px!important}.missionrow .st{font-size:10px!important}.missionrow.current{border-color:#28e9ff!important;background:linear-gradient(90deg,rgba(21,208,255,.26),rgba(5,37,65,.82))!important;box-shadow:inset 4px 0 0 #45f1ff,0 0 18px rgba(35,221,255,.16)!important}.missionrow.locked{opacity:.42!important}

.training{min-width:0!important;border:1px solid rgba(38,202,255,.32)!important;border-radius:18px!important;overflow:hidden!important;background:linear-gradient(180deg,rgba(4,17,34,.92),rgba(2,10,22,.96))!important;grid-template-rows:62px minmax(0,1fr) 255px!important;box-shadow:0 0 0 1px rgba(31,147,255,.05) inset,0 0 36px rgba(0,111,255,.07)!important}
.trainingHead{padding:8px 18px!important;min-height:62px!important;border-bottom-color:rgba(45,193,255,.25)!important;background:linear-gradient(180deg,rgba(7,26,47,.92),rgba(4,17,33,.76))!important}.missionTag{min-width:68px!important;padding:9px 11px!important;font-size:13px!important;border-color:rgba(57,245,255,.60)!important}.trainTitle strong{font-size:18px!important}.trainTitle span{font-size:12px!important}.stepDots i{width:9px!important;height:9px!important}

/* chart is the visual hero */
.chartArea{padding:12px 14px 0!important}.chartFrame{min-height:360px!important;border-radius:16px!important;border:1px solid rgba(45,205,255,.55)!important;background:linear-gradient(180deg,#020916,#04111d)!important;box-shadow:inset 0 0 45px rgba(10,116,167,.05),0 0 28px rgba(0,178,255,.08)!important}.chartFrame:before{content:"MARKET TRAINING // PRICE ACTION"!important;top:12px!important;left:15px!important;color:rgba(123,213,241,.58)!important}.chartwrap{min-height:360px!important}.charttip{top:36px!important;left:14px!important;font-size:11px!important;padding:8px 10px!important;background:rgba(2,9,19,.94)!important;border-color:rgba(46,212,255,.44)!important}.chartlegend{top:10px!important;right:12px!important;font-size:11px!important;background:rgba(3,13,27,.92)!important}.chartctl.v3{right:12px!important;bottom:10px!important}.chartctl.v3 button{height:34px!important;min-width:44px!important}
.coachOrb{width:52px!important;height:52px!important;left:18px!important;bottom:16px!important;background:radial-gradient(circle at 35% 30%,#d4ffff 0,#47e8ff 12%,#1475c7 35%,#071b38 72%)!important;box-shadow:0 0 30px rgba(46,222,255,.32)!important}
.coachOrb:after{content:"教練"!important;position:absolute!important;inset:auto!important;left:62px!important;top:6px!important;width:max-content!important;border:1px solid rgba(46,220,255,.25)!important;border-radius:9px!important;background:rgba(4,18,33,.82)!important;padding:6px 9px!important;color:#a7efff!important;font:800 10px var(--font)!important;animation:none!important;opacity:1!important}

/* question / answer cockpit */
.lessonDock{min-height:255px!important;padding:12px 14px 14px!important;border-top:1px solid rgba(42,205,255,.31)!important;background:linear-gradient(180deg,rgba(3,14,28,.94),rgba(2,8,18,.99))!important}.dockGrid{grid-template-columns:minmax(380px,.96fr) minmax(520px,1.32fr)!important;gap:14px!important}.prompt{padding:16px 18px!important;border:1px solid rgba(45,211,255,.48)!important;border-radius:16px!important;background:linear-gradient(145deg,rgba(7,36,57,.94),rgba(4,20,38,.92))!important;box-shadow:inset 0 0 26px rgba(0,187,255,.05)!important}.prompt:before{width:5px!important}.qtag{font-size:15px!important}.difficulty{font-size:10px!important}.question{font-size:22px!important;line-height:1.5!important;margin-top:7px}.explain{font-size:13px!important;line-height:1.65!important}.coachLine{font-size:12px!important;padding:9px 11px!important;border-color:rgba(162,111,255,.32)!important;background:linear-gradient(90deg,rgba(114,58,255,.10),rgba(13,58,97,.18))!important}.answers{gap:11px!important}.answer{min-height:96px!important;border-radius:14px!important;font-size:16px!important;line-height:1.45!important;padding:13px 11px!important;border-width:1px!important;border-color:rgba(44,176,238,.55)!important;background:linear-gradient(180deg,rgba(11,48,75,.96),rgba(5,25,46,.97))!important;box-shadow:inset 0 0 22px rgba(44,172,255,.04)!important}.answer:nth-child(1){border-color:rgba(255,58,100,.68)!important;box-shadow:0 0 18px rgba(255,49,87,.08),inset 0 0 20px rgba(255,49,87,.04)!important}.answer:nth-child(2){border-color:rgba(49,218,255,.70)!important}.answer:nth-child(3){border-color:rgba(37,239,154,.68)!important}.answer:hover{transform:translateY(-1px);filter:brightness(1.12)}.answerHelp{min-height:40px!important;font-size:12px!important}.feedbackBox{font-size:13px!important;padding:10px 12px!important}.nextBtn{min-height:44px!important}

/* home should feel like a game dashboard too */
.homebody{padding:24px!important}.heroPanel,.glass,.worldCard,.premiumBanner{border-color:rgba(48,187,255,.31)!important}.heroPanel{min-height:290px!important;padding:32px!important;background:radial-gradient(circle at 80% 0,rgba(43,111,255,.18),transparent 40%),linear-gradient(135deg,rgba(9,29,52,.96),rgba(3,14,29,.96))!important}.heroTitle{font-size:clamp(42px,5vw,76px)!important}.worldCard{min-height:164px!important}.statPanel{background:linear-gradient(145deg,rgba(8,30,52,.96),rgba(4,16,31,.94))!important}

/* tablet */
@media(max-width:1180px){.hudbar{padding:8px 14px!important}.brandname{font-size:20px!important}.brandname b{font-size:24px!important}.sidebar{width:248px!important}.training{grid-template-rows:56px minmax(0,1fr) 300px!important}.dockGrid{grid-template-columns:1fr!important}.lessonDock{min-height:300px!important}.prompt{padding:12px 14px!important}.answers{grid-template-columns:repeat(3,1fr)!important}.answer{min-height:74px!important}.question{font-size:18px!important}}

/* mobile: stop pretending a desktop cockpit fits in one viewport */
@media(max-width:820px){
 html,body{overflow:auto!important;overscroll-behavior-y:auto!important;background:#020817!important}
 #app{height:auto!important;min-height:100dvh!important;overflow:visible!important}
 .screen{height:auto!important;min-height:100dvh!important;overflow:visible!important;display:block!important}
 .scanline{display:none!important}
 .hudbar{position:sticky!important;top:0!important;z-index:60!important;height:58px!important;padding:6px 8px!important;grid-template-columns:auto 1fr auto!important}.crown{width:35px!important;height:35px!important;font-size:18px!important}.brandname{font-size:14px!important}.brandname b{font-size:16px!important}.brandsub,.xpbox{display:none!important}.hudstats{justify-self:end!important}.hudpill{height:34px!important;min-width:58px!important;font-size:10px!important;padding:0 7px!important}.hudstats .hudpill.fire{display:none!important}.iconbtn{width:34px!important;height:34px!important;font-size:15px!important}
 .main{display:block!important;padding:0!important;overflow:visible!important}.sidebar{display:none!important}
 .training{height:auto!important;min-height:calc(100dvh - 58px)!important;display:block!important;border:0!important;border-radius:0!important;overflow:visible!important;background:linear-gradient(180deg,#04101f,#020817)!important}.trainingHead{position:sticky!important;top:58px!important;z-index:40!important;min-height:54px!important;padding:7px 9px!important;background:rgba(3,16,31,.96)!important}.missionTag{min-width:52px!important;font-size:10px!important;padding:7px!important}.trainTitle strong{font-size:14px!important}.trainTitle span{font-size:10px!important}.stepDots i{width:7px!important;height:7px!important}
 .chartArea{height:55dvh!important;min-height:370px!important;padding:7px!important}.chartFrame,.chartwrap{height:100%!important;min-height:360px!important;border-radius:12px!important}.chartFrame:before{font-size:8px!important;top:8px!important;left:9px!important}.charttip{font-size:9px!important;top:26px!important;left:8px!important;padding:5px 6px!important}.chartlegend{font-size:8px!important;top:6px!important;right:6px!important;gap:5px!important}.chartctl.v3{right:5px!important;bottom:5px!important}.chartctl.v3 button{height:30px!important;min-width:38px!important;font-size:9px!important}.coachOrb{width:38px!important;height:38px!important;left:12px!important;bottom:10px!important;font-size:10px!important}.coachOrb:after{display:none!important}
 .lessonDock{min-height:0!important;padding:9px 8px calc(18px + env(safe-area-inset-bottom))!important;background:#020817!important}.dockGrid{display:block!important}.prompt{padding:12px!important;border-radius:13px!important;margin-bottom:9px!important}.qtag{font-size:11px!important}.difficulty{font-size:8px!important}.question{font-size:17px!important;line-height:1.55!important}.explain{font-size:11px!important}.coachLine{font-size:11px!important}.answers{display:grid!important;grid-template-columns:1fr!important;gap:8px!important}.answer{min-height:62px!important;font-size:14px!important;padding:11px!important}.answerHelp{min-height:42px!important;font-size:12px!important}.feedbackBox{font-size:12px!important}.nextBtn{min-height:48px!important}
 .homebody{padding:12px 10px 24px!important}.heroGrid,.worldGrid{grid-template-columns:1fr!important}.heroPanel{min-height:0!important;padding:20px!important}.heroTitle{font-size:40px!important}.statPanel{grid-template-columns:1fr 1fr!important}.worldCard{min-height:128px!important}
 .debugBadge{display:none!important}
}

@media(max-width:390px){.chartArea{height:51dvh!important;min-height:340px!important}.chartFrame,.chartwrap{min-height:330px!important}.question{font-size:16px!important}.heroTitle{font-size:35px!important}.hudpill.gold{display:none!important}}
