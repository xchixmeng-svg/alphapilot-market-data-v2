function suitable(mid,R){var q=criterion(mid,R),i=q.i,k,stop,target;if(mid===6){var c6=[R.c[i-4],R.c[i-3],R.c[i-2],R.c[i-1],R.c[i]],ch6=c6[4]/c6[0]-1,u6=0,d6=0;for(k=1;k<5;k++){if(c6[k]>c6[k-1])u6++;else if(c6[k]<c6[k-1])d6++;}return (ch6>=.025&&u6>=3)||(ch6<=-.025&&d6>=3)||(Math.abs(ch6)<=.007&&u6>=1&&d6>=1);}if(mid===5)return ((R.c[i]>=R.o[i])!==(R.c[i]>=R.c[i-1]));if(mid===17){var r=maxA(R.h,i-22,i-3),b17=false;for(k=i-2;k<i;k++)if(R.c[k]>r*1.002)b17=true;return b17&&R.c[i]<r;}if(mid===18){var r2=maxA(R.h,i-25,i-6),b=false;for(k=i-5;k<i;k++)if(R.c[k]>r2*1.005)b=true;return b&&Math.abs(R.c[i]/r2-1)<.035;}if(mid===27)return q.trendUp&&q.ma&&Math.abs(q.dist)<.04;if(mid===28)return q.c>q.prevHi*.995;if(mid===29){var r3=maxA(R.h,i-25,i-6),b29=false;for(k=i-5;k<i;k++)if(R.c[k]>r3*1.005)b29=true;return b29&&R.c[i]>=r3*.995&&Math.abs(R.c[i]/r3-1)<.035;}if(mid===30)return q.ma&&q.dist>.07;if(mid===31){stop=Math.max(.01,q.sup-q.a*.45);return stop<q.c;}if(mid===32||mid===33){stop=Math.max(.01,q.sup-q.a*.45);target=q.res>q.c?q.res:maxA(R.h,i-60,i-1);return stop<q.c&&target>q.c*1.005;}if(mid===35){stop=Math.max(.01,q.sup-q.a*.45);return stop<q.c;}return true;}
var ROUND_MEMO={};function roundFor(mid,ex,mode){var key=mid+'|'+ex+'|'+mode;if(ROUND_MEMO[key])return ROUND_MEMO[key];var used={};if(mode==='mission'){for(var e=0;e<ex;e++)used[roundFor(mid,e,mode)]=1;}var pool=mode==='exam'?EXAM:TRAIN,seed=C.SEED+'|V3|'+mid+'|'+ex+'|'+mode+(mode==='mission'?'':'|'+S.seed),sh=E.seededShuffle(pool,seed),pick=null,fallback=null;for(var j=0;j<Math.min(sh.length,400);j++){if(used[sh[j]])continue;if(fallback===null)fallback=sh[j];var R=getR(sh[j]);if(R&&suitable(mid,R)){pick=sh[j];break;}}return ROUND_MEMO[key]=pick||fallback||sh[0];}
// Mixed-skill sessions (V4): practice and blind exam draw the skill first, then a suitable historical case.
// TRAIN (A/B pools, 2020-2023) feeds practice, EXAM (C pool, 2024-2025) feeds the blind exam — never mixed.
var PLAN_MEMO={};
function skillPlan(mode){var key=mode==='exam'?'exam':'practice|'+S.practice.round;if(PLAN_MEMO[key])return PLAN_MEMO[key];
 var n=mode==='exam'?100:400,base=[],k;for(k=1;k<=36;k++)base.push(k);
 // exam: every skill appears, the integrated skills (M24-M36) twice as often
 var bag=mode==='exam'?base.concat(base.filter(function(x){return x>=24;})):base,out=[],b=0;
 while(out.length<n){var sh=E.seededShuffle(bag,C.SEED+'|PLAN|'+key+'|'+S.seed+'|'+(b++));for(var j=0;j<sh.length&&out.length<n;j++)out.push(sh[j]);}
 for(var pass=0;pass<6;pass++){var clean=true;for(var q=1;q<out.length;q++)if(out[q]===out[q-1]){clean=false;for(var r=q+1;r<out.length;r++)if(out[r]!==out[q]&&out[r]!==out[q-1]&&(r+1>=out.length||out[r+1]!==out[q])&&(out[r-1]!==out[q]||r-1===q)){var t=out[q];out[q]=out[r];out[r]=t;break;}}if(clean)break;}
 return PLAN_MEMO[key]=out;}
function setupMission(id,ex,mode){UI.mission=CT.MISSIONS[id-1]||CT.MISSIONS[35];UI.exercise=ex||0;UI.mode=mode||'mission';UI.roundId=roundFor(UI.mission.id,UI.exercise,UI.mode);UI.feedback=null;UI.hint=0;UI.answer=null;}
function options(arr,correct){return{opts:arr,correct:correct};}
function shuffleOptions(vals,correctVal,seed){var pairs=vals.map(function(v,i){return{v:v,ok:i===correctVal};}),s=E.seededShuffle(pairs,seed),ci=s.findIndex(function(x){return x.ok;});return{opts:s.map(function(x){return x.v;}),correct:ci};}
function question(m,R,ex){var q=criterion(m.id,R),i=q.i,seed=m.id+'|'+ex+'|'+BYID[UI.roundId].lb;function sh(a,c){return shuffleOptions(a,c,seed);}var d,side,slope,atrp,vr,chg,bodyUp,dayUp,upper,lower,rrv,stop,target,risk;
 switch(m.skill){
 case'OHLC': if(ex%3===1)return sh(['開盤 '+px(q.o),'最高 '+px(R.h[i]),'收盤 '+px(q.c)],2);if(ex%3===2)return sh(['最低 '+px(R.l[i]),'開盤 '+px(q.o),'最高 '+px(R.h[i])],0);return sh(['最高 '+px(R.h[i]),'收盤 '+px(q.c),'最低 '+px(R.l[i])],0);
 case'BODY':return sh(['開盤到收盤','最低到最高','昨收到今收'],0);
 case'COLOR':bodyUp=q.c>=q.o;return sh(['紅 K','綠 K','只看這根無法知道'],bodyUp?0:1);
 case'WICK':upper=R.h[i]-Math.max(q.o,q.c);lower=Math.min(q.o,q.c)-R.l[i];side=upper>lower*1.25?'上影較長':lower>upper*1.25?'下影較長':'上下影接近';return sh(['上影較長','下影較長','上下影接近'],side==='上影較長'?0:side==='下影較長'?1:2);
 case'DAYCHANGE':dayUp=q.c>=q.pc;return sh(['今天相對昨收上漲','今天相對昨收下跌','K 棒顏色已足夠，不用昨收'],dayUp?0:1);
 case'SEQUENCE':chg=R.c[i]/R.c[i-4]-1;side=chg>.015?'整體上移':chg<-.015?'整體下移':'沒有明顯方向';return sh(['整體上移','整體下移','沒有明顯方向'],side==='整體上移'?0:side==='整體下移'?1:2);
 case'SWING_HIGH':return sh(['近 20 日高點約 '+px(q.res),'近 20 日低點約 '+px(q.sup),'今天收盤 '+px(q.c)],0);
 case'HIGHER_HIGH':side=q.hi2>q.hi1*1.003?'後段高點更高':q.hi2<q.hi1*.997?'後段高點更低':'差不多';return sh(['後段高點更高','後段高點更低','差不多'],side==='後段高點更高'?0:side==='後段高點更低'?1:2);
 case'HIGHER_LOW':side=q.lo2>q.lo1*1.003?'後段低點更高':q.lo2<q.lo1*.997?'後段低點更低':'差不多';return sh(['後段低點更高','後段低點更低','差不多'],side==='後段低點更高'?0:side==='後段低點更低'?1:2);
 case'DOWNTREND':side=q.trendDown?'下降結構':q.trendUp?'上升結構':'盤整／混合';return sh(['下降結構','上升結構','盤整／混合'],side==='下降結構'?0:side==='上升結構'?1:2);
 case'RANGE':side=!q.trendUp&&!q.trendDown?'盤整／混合':q.trendUp?'上升結構':'下降結構';return sh(['盤整／混合','上升結構','下降結構'],side==='盤整／混合'?0:side==='上升結構'?1:2);
 case'STRUCTURE_SHIFT':side=q.c>maxA(R.h,i-12,i-1)?'已突破近期重要高點':q.c<minA(R.l,i-12,i-1)?'仍在破底':'尚未確認改變';return sh(['已突破近期重要高點','仍在破底','尚未確認改變'],side==='已突破近期重要高點'?0:side==='仍在破底'?1:2);
 case'SUPPORT':return sh(['約 '+px(q.sup),'約 '+px(q.res),'約 '+px(q.c)],0);
 case'RESISTANCE':return sh(['約 '+px(q.res),'約 '+px(q.sup),'約 '+px(q.c)],0);
 case'RANGE_EDGE':var ds=Math.abs(q.c-q.sup),dr=Math.abs(q.res-q.c);side=ds<dr*.7?'靠近區間下緣':dr<ds*.7?'靠近區間上緣':'區間中間';return sh(['靠近區間下緣','靠近區間上緣','區間中間'],side==='靠近區間下緣'?0:side==='靠近區間上緣'?1:2);
 case'BREAKOUT':return sh(['已收盤站上前 20 日壓力','只有盤中碰到，不算站上','仍在壓力下'],q.c>q.prevHi?0:(R.h[i]>q.prevHi?1:2));
 case'FALSE_BREAKOUT':return sh(['突破後跌回原區間，品質下降','突破一定成功，只是正常震盪','只要曾創高就不用管結構'],0);
 case'RETEST':return sh(['像突破後回測原壓力','像高檔追價','像下降趨勢接刀'],0);
 case'MA20_ID':return sh(['MA20：近 20 日平均位置','MA60：近 60 日平均位置','成交量平均線'],0);
 case'MA20_SIDE':return sh(['股價在 MA20 上方','股價在 MA20 下方','兩者完全相同'],q.c>q.ma?0:q.c<q.ma?1:2);
 case'MA20_DISTANCE':d=Math.abs(q.dist||0);side=d<=.025?'接近 MA20':d>=.08?'明顯遠離 MA20':'中等距離';return sh(['接近 MA20（約 ±2.5% 內）','明顯遠離 MA20（約 8% 以上）','中等距離'],side.indexOf('接近')===0?0:side.indexOf('明顯')===0?1:2);
 case'MA20_SLOPE':slope=q.ma>q.oldMa*1.002?'MA20 往上':q.ma<q.oldMa*.998?'MA20 往下':'MA20 走平';return sh(['MA20 往上','MA20 往下','MA20 走平'],slope==='MA20 往上'?0:slope==='MA20 往下'?1:2);
 case'MA_STACK':side=q.c>q.ma&&q.ma>q.ma60?'價格 > MA20 > MA60':q.c<q.ma&&q.ma<q.ma60?'價格 < MA20 < MA60':'均線順序混合';return sh(['價格 > MA20 > MA60','價格 < MA20 < MA60','均線順序混合'],side==='價格 > MA20 > MA60'?0:side==='價格 < MA20 < MA60'?1:2);
 case'ATR':atrp=q.a/q.c;side=atrp>=.04?'高波動':atrp<=.02?'低波動':'中等波動';return sh(['高波動（ATR/股價 ≥ 4%）','低波動（≤ 2%）','中等波動'],side==='高波動'?0:side==='低波動'?1:2);
 case'VOLUME':vr=q.vr;side=vr>=1.5?'明顯放量':vr<=.7?'明顯縮量':'接近近期平均';return sh(['明顯放量','明顯縮量','接近近期平均'],side==='明顯放量'?0:side==='明顯縮量'?1:2);
 case'PRICE_VOLUME':chg=q.c/q.pc-1;side=chg>0&&q.vr>1.35?'上漲＋放量':chg<0&&q.vr>1.35?'下跌＋放量':q.vr<.8?'縮量':'量能普通';return sh(['上漲＋放量','下跌＋放量','縮量／量能普通'],side==='上漲＋放量'?0:side==='下跌＋放量'?1:2);
 case'PULLBACK':side=q.trendUp&&q.ma&&Math.abs(q.dist)<.05&&q.c>q.sup?'較像順勢回檔':'不像標準回檔';return sh(['較像順勢回檔','下降趨勢接刀','高檔追價'],side==='較像順勢回檔'?0:(q.trendDown?1:2));
 case'BREAKOUT_SETUP':side=q.c>q.prevHi?'較像有效突破':R.h[i]>q.prevHi?'只有盤中刺過':'仍未突破';return sh(['較像有效突破','只有盤中刺過','仍未突破'],side==='較像有效突破'?0:side==='只有盤中刺過'?1:2);
 case'RETEST_SETUP':return sh(['突破後回測守住，值得觀察','已完全跌回原區間，當作突破失敗','只要紅 K 就是回測成功'],0);
 case'NO_CHASE':side=(q.dist!=null&&q.dist>.08)||q.c>q.res*.995?'追高風險偏高':'位置尚未明顯過熱';return sh(['追高風險偏高','位置尚未明顯過熱','只要上漲就應該追'],side==='追高風險偏高'?0:1);
 case'INVALIDATION':stop=Math.max(.01,q.sup-q.a*.45);return sh(['放在支撐/結構低點下方：約 '+px(stop),'固定設在今天收盤 -1%','放在支撐上方，越近越好'],0);
 case'TARGET':target=q.res>q.c?q.res:maxA(R.h,i-60,i-1);return sh(['下一個明顯壓力：約 '+px(target),'固定今天收盤 +15%','支撐區：約 '+px(q.sup)],0);
 case'RR':stop=Math.max(.01,q.sup-q.a*.45);target=q.res>q.c?q.res:maxA(R.h,i-60,i-1);risk=q.c-stop;rrv=risk>0?(target-q.c)/risk:0;side=rrv>=2?'R:R ≥ 2':rrv>=1?'R:R 約 1～2':'R:R < 1';return sh(['R:R ≥ 2','R:R 約 1～2','R:R < 1'],side==='R:R ≥ 2'?0:side==='R:R 約 1～2'?1:2);
 case'POSITION':return sh(['失策距離越大，部位應越小','失策距離越大，部位應越大','部位和失策距離無關'],0);
 case'HOLD_EXIT':var day=Math.min(3,E.futureDays(R)),ci=X(day),st=Math.max(.01,q.sup-q.a*.45);side=R.c[ci]<st?'理由失效，應退出／重新評估':'理由尚未失效，可續抱觀察';return sh(['理由尚未失效，可續抱觀察','理由失效，應退出／重新評估','固定第 3 天一律賣'],side.indexOf('失效')>=0&&side.indexOf('尚未')<0?1:0);
 case'FULL_SCAN':var score=(q.trendUp?2:q.trendDown?-2:0)+(q.ma&&q.c>q.ma?1:-1)+(q.dist!=null&&q.dist>.09?-2:0)+(Math.abs(q.c-q.sup)<Math.abs(q.res-q.c)?1:0)+(q.vr>1.5&&q.c<q.pc?-1:0);side=score>=2?'值得進一步研究':score<=-2?'不值得買':'等待／資訊不夠乾淨';return sh(['值得進一步研究','不值得買','等待／資訊不夠乾淨'],side==='值得進一步研究'?0:side==='不值得買'?1:2);
 default:return options(['看懂了','還不確定','需要重看'],0);
 }}
function qtext(m,R,ex){var q=criterion(m.id,R);switch(m.skill){
 case'OHLC':return ex%3===1?'D0 這一天，哪個是「收盤」？':ex%3===2?'D0 這一天，哪個是「最低」？':'D0 這一天，哪個是「最高」？';
 case'BODY':return'K 棒中間的「實體」代表哪一段？';case'COLOR':return'只比較 D0 的開盤與收盤，這根是什麼 K？';case'WICK':return'D0 這根 K，哪一側影線更明顯？';case'DAYCHANGE':return'不要看 K 棒顏色。和「昨天收盤」相比，今天到底漲還跌？';case'SEQUENCE':return'只看最近 5 個收盤位置，整體往哪裡移？';case'SWING_HIGH':return'近 20 個交易日，真正的高點大約在哪？';case'HIGHER_HIGH':return'把前半段與後半段的重要高點相比，發生什麼？';case'HIGHER_LOW':return'把前半段與後半段的重要低點相比，發生什麼？';case'DOWNTREND':return'高點與低點一起看，這段結構比較像什麼？';case'RANGE':return'這段走勢有明確墊高／降低嗎？';case'STRUCTURE_SHIFT':return'現在有足夠證據說結構已改變嗎？';case'SUPPORT':return'近 20 日價格最常被接住的下方區域大約在哪？';case'RESISTANCE':return'近 20 日上方最明顯的壓力大約在哪？';case'RANGE_EDGE':return'現在價格位在區間哪一側？';case'BREAKOUT':return'相對前 20 日壓力，D0 算真正站上去了嗎？';case'FALSE_BREAKOUT':return'圖上突破後又跌回原區間，最合理的解讀是？';case'RETEST':return'這個位置最像哪種行為？';case'MA20_ID':return'圖上黃色發光線是什麼？';case'MA20_SIDE':return'目前收盤 '+px(q.c)+'，MA20 '+px(q.ma)+'。股價在哪一側？';case'MA20_DISTANCE':return'目前收盤與 MA20 相差約 '+pct(Math.abs(q.dist||0))+ '，屬於哪種距離？';case'MA20_SLOPE':return'MA20 今天和 5 天前相比，方向如何？';case'MA_STACK':return'現在價格、MA20、MA60 的順序是？';case'ATR':return'ATR 約占股價 '+pct(q.a/q.c)+'，這檔波動程度如何？';case'VOLUME':return'今天成交量約為近 20 日平均的 '+(q.vr||0).toFixed(2)+' 倍，算什麼？';case'PRICE_VOLUME':return'今天價格與成交量合起來看，最接近哪種狀態？';case'PULLBACK':return'把趨勢、位置與 MA20 合起來，這更像哪種情況？';case'BREAKOUT_SETUP':return'這次向上穿越壓力的品質如何？';case'RETEST_SETUP':return'突破後回到原壓力附近，現在應怎麼解讀？';case'NO_CHASE':return'你現在最需要警惕的是不是「追高」？';case'INVALIDATION':return'如果這是一筆回檔交易，失策點應該放哪裡才有邏輯？';case'TARGET':return'先不許願 +15%。第一個合理的上方觀察目標應看哪裡？';case'RR':return'用目前位置、支撐下失策、上方壓力估算，風險報酬大約在哪一級？';case'POSITION':return'如果另一筆交易的停損距離更寬，固定帳戶風險下部位應怎麼變？';case'HOLD_EXIT':return'現在已經走到 D+3。交易理由還在，還是已經失效？';case'FULL_SCAN':return'按照「趨勢 → 位置 → 均線 → 量價 → 空間」掃完，現在最合理的動作是？';default:return m.objective;}}
function explain(m,R,ans){var q=criterion(m.id,R),i=q.i;switch(m.skill){case'OHLC':return'這一關只認四個價格，不做預測。開 '+px(q.o)+'｜高 '+px(R.h[i])+'｜低 '+px(R.l[i])+'｜收 '+px(q.c)+'。';case'COLOR':return'K 色只比較今天開盤 '+px(q.o)+' 與收盤 '+px(q.c)+'。';case'DAYCHANGE':return'日漲跌一定要拿今天收盤 '+px(q.c)+' 去比昨天收盤 '+px(q.pc)+'；這和紅綠 K 是兩套比較。';case'MA20_DISTANCE':return'收盤 '+px(q.c)+'、MA20 '+px(q.ma)+'，乖離約 '+pct(q.dist||0)+'。先用百分比建立距離感，不要只靠畫面比例。';case'VOLUME':return'今天量 / 近 20 日平均量 ≈ '+(q.vr||0).toFixed(2)+' 倍。量要和自己的近期基準比。';case'RR':var st=Math.max(.01,q.sup-q.a*.45),tg=q.res>q.c?q.res:maxA(R.h,i-60,i-1),rr=(tg-q.c)/(q.c-st);return'用收盤 '+px(q.c)+'、失策約 '+px(st)+'、壓力約 '+px(tg)+'，R:R 約 '+(isFinite(rr)?rr.toFixed(2):'—')+'。';case'HOLD_EXIT':return'持有判斷不是看第幾天，而是檢查原本支撐／結構是否失效。';case'FULL_SCAN':return'完整判斷不是找單一神奇訊號，而是固定順序掃描，最後也允許「不做」。';default:return m.rule;}}
function hints(m,R){var q=criterion(m.id,R),i=q.i;var a=['先忽略其他資訊，只找這關標題中的那一件事。'];switch(m.skill){case'COLOR':a.push('只比較兩個數字：開盤 '+px(q.o)+'、收盤 '+px(q.c)+'。');a.push(q.c>=q.o?'收盤比較高，所以這根偏紅。':'收盤比較低，所以這根偏綠。');break;case'DAYCHANGE':a.push('不要用今天開盤。拿今天收盤 '+px(q.c)+' 比昨天收盤 '+px(q.pc)+'。');break;case'MA20_SIDE':case'MA20_DISTANCE':a.push('黃色線就是 MA20，目前約 '+px(q.ma)+'；收盤約 '+px(q.c)+'。');a.push('差距約 '+pct(Math.abs(q.dist||0))+'。');break;case'SUPPORT':a.push('往左看近 20 天，找價格多次下去又被拉起的低位區。');a.push('這題的區域約在 '+px(q.sup)+' 附近。');break;case'RESISTANCE':a.push('往左找多次漲上去又被壓回的高位區。');a.push('這題約在 '+px(q.res)+' 附近。');break;case'VOLUME':a.push('不要看絕對張數，比「今天 / 近20日平均」。');a.push('這題約 '+(q.vr||0).toFixed(2)+' 倍。');break;case'FULL_SCAN':a.push('先問：趨勢？再問：現在靠近支撐還是壓力？');a.push('最後才把 MA、量與上方空間放進來。');break;default:a.push(m.rule);a.push(m.anti);}return a;}
