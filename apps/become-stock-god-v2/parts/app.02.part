function suitable(mid,R){var q=criterion(mid,R),i=q.i,k,stop,target;if(mid===5)return ((R.c[i]>=R.o[i])!==(R.c[i]>=R.c[i-1]));if(mid===17){var r=maxA(R.h,i-22,i-3),b17=false;for(k=i-2;k<i;k++)if(R.c[k]>r*1.002)b17=true;return b17&&R.c[i]<r;}if(mid===18){var r2=maxA(R.h,i-25,i-6),b=false;for(k=i-5;k<i;k++)if(R.c[k]>r2*1.005)b=true;return b&&Math.abs(R.c[i]/r2-1)<.035;}if(mid===27)return q.trendUp&&q.ma&&Math.abs(q.dist)<.04;if(mid===28)return q.c>q.prevHi*.995;if(mid===29){var r3=maxA(R.h,i-25,i-6),b29=false;for(k=i-5;k<i;k++)if(R.c[k]>r3*1.005)b29=true;return b29&&R.c[i]>=r3*.995&&Math.abs(R.c[i]/r3-1)<.035;}if(mid===30)return q.ma&&q.dist>.07;if(mid===31){stop=Math.max(.01,q.sup-q.a*.45);return stop<q.c;}if(mid===32||mid===33){stop=Math.max(.01,q.sup-q.a*.45);target=q.res>q.c?q.res:maxA(R.h,i-60,i-1);return stop<q.c&&target>q.c*1.005;}if(mid===35){stop=Math.max(.01,q.sup-q.a*.45);return stop<q.c;}return true;}
function roundFor(mid,ex,mode){var pool=mode==='exam'?EXAM:TRAIN,seed=C.SEED+'|V3|'+mid+'|'+ex+'|'+mode,sh=E.seededShuffle(pool,seed);for(var j=0;j<Math.min(sh.length,180);j++){var R=getR(sh[j]);if(R&&suitable(mid,R))return sh[j];}return sh[0];}
function setupMission(id,ex,mode){UI.mission=CT.MISSIONS[id-1]||CT.MISSIONS[35];UI.exercise=ex||0;UI.mode=mode||'mission';UI.roundId=roundFor(UI.mission.id,UI.exercise,UI.mode);UI.feedback=null;UI.hint=0;UI.answer=null;}
function options(arr,correct){return{opts:arr,correct:correct};}
function shuffleOptions(vals,correctVal,seed){var pairs=vals.map(function(v,i){return{v:v,ok:i===correctVal};}),s=E.seededShuffle(pairs,seed),ci=s.findIndex(function(x){return x.ok;});return{opts:s.map(function(x){return x.v;}),correct:ci};}
function question(m,R,ex){var q=criterion(m.id,R),i=q.i,seed=m.id+'|'+ex+'|'+BYID[UI.roundId].lb;function sh(a,c){return shuffleOptions(a,c,seed);}var d,side,slope,atrp,vr,chg,bodyUp,dayUp,upper,lower,rrv,stop,target,risk;
 switch(m.skill){
 case'OHLC': if(ex%3===1)return sh(['開盤 '+px(q.o),'最高 '+px(R.h[i]),'收盤 '+px(q.c)],2);if(ex%3===2)return sh(['最低 '+px(R.l[i]),'開盤 '+px(q.o),'最高 '+px(R.h[i])],0);return sh(['最高 '+px(R.h[i]),'收盤 '+px(q.c),'最低 '+px(R.l[i])],0);
 case'BODY':return sh(['開盤到收盤','最低到最高','昨收到今收'],0);
 case'COLOR':bodyUp=q.c>=q.o;return sh(['紅 K','綠 K','只看這根無法知道'],bodyUp?0:1);
 case'WICK':upper=R.h[i]-Math.max(q.o,q.c);lower=Math.min(q.o,q.c)-R.l[i];side=upper>lower*1.25?'上影較長':lower>upper*1.25?'下影較長':'上下影接近';return sh(['上影較長','下影較長','上下影接近'],side==='上影較長'?0:side==='下影較長'?1:2);
 case'DAYCHANGE':dayUp=q.c>=q.pc;return sh(['今天相對昨收上漲','今天相對昨收下跌','K 棒顏色已足夠，不用昨收'],dayUp?0:1);
 case'SEQUENCE':chg=R.c[i]/R.c[i-4]-1;side=chg>.015?'整體上移':chg<-.015?'整體下移':'沒有明顯方向';return sh(['整體上移','整體下移','沒有明顯方向'],side==='整體上移'?0:side==='整體下移'?1:2);
 case'SWING_HIGH':return sh(['近 20 日高點約 '+px(q.res),'近 20 日低點約 '+px(q.sup),'今天收盤 '+px(q.c)],0);
 case'HIGHER_HIGH':side=q.hi2>q.hi1*1.003?'後段高點更高':q.hi2<q.hi1*.997?'後段高點更低':'差不多';return sh(['後段高點更高','後段高點更低','差不多'],side==='後段高點更高'?0:side==='後段高點更低'?1:2);
 case'HIGHER_LOW':side=q.lo2>q.lo1*1.003?'後段低點更高':q.lo2<q.lo1*.997?'後段低點更低':'差不多';return sh(['後段低點更高','後段低點更低','差不多'],side==='後段低點更高'?0:side==='後段低點更低'?1:2);
 case'DOWNTREND':side=q.trendDown?'下降結構':q.trendUp?'上升結構':'盤整／混合';return sh(['下降結構','上升結構','盤整／混合'],side==='下降結構'?0:side==='上升結構'?1:2);
 case'RANGE':side=!q.trendUp&&!q.trendDown?'盤整／混合':q.trendUp?'上升結構':'下降結構';return sh(['盤整／混合','上升結構','下降結構'],side==='盤整／混合'?0:side==='上升結構'?1:2);
 case'STRUCTURE_SHIFT':side=q.c>maxA(R.h,i-12,i-1)?'已突破近期重要高點':q.c<minA(R.l,i-12,i-1)?'仍在破底':'尚未確認改變';return sh(['已突破近期重要高點','仍在破底','尚未確認改變'],side==='已突破近期重要高點'?0:side==='仍在破底'?1:2);
 case'SUPPORT':return sh(['約 '+px(q.sup),'約 '+px(q.res),'約 '+px(q.c)],0);
 case'RESISTANCE':return sh(['約 '+px(q.res),'約 '+px(q.sup),'約 '+px(q.c)],0);
 case'RANGE_EDGE':var ds=Math.abs(q.c-q.sup),dr=Math.abs(q.res-q.c);side=ds<dr*.7?'靠近區間下緣':dr<ds*.7?'靠近區間上緣':'區間中間';return sh(['靠近區間下緣','靠近區間上緣','區間中間'],side==='靠近區間下緣'?0:side==='靠近區間上緣'?1:2);
 case'BREAKOUT':return sh(['已收盤站上前 20 日壓力','只有盤中碰到，不算站上','仍在壓力下'],q.c>q.prevHi?0:(R.h[i]>q.prevHi?1:2));
 case'FALSE_BREAKOUT':return sh(['突破後跌回原區間，品質下降','突破一定成功，只是正常震盪','只要曾創高就不用管結構'],0);
 case'RETEST':return sh(['像突破後回測原壓力','像高檔追價','像下降趨勢接刀'],0);
 case'MA20_ID':return sh(['MA20：近 20 日平均位置','MA60：近 60 日平均位置','成交量平均線'],0);
 case'MA20_SIDE':return sh(['股價在 MA20 上方','股價在 MA20 下方','兩者完全相同'],q.c>q.ma?0:q.c<q.ma?1:2);
 case'MA20_DISTANCE':d=Math.abs(q.dist||0);side=d<=.025?'接近 MA20':d>=.08?'明顯遠離 MA20':'中等距離';return sh(['接近 MA20（約 ±2.5% 內）','明顯遠離 MA20（約 8% 以上）','中等距離'],side.indexOf('接近')===0?0:side.indexOf('明顯')===0?1:2);
 case'MA20_SLOPE':slope=q.ma>q.oldMa*1.002?'MA20 往上':q.ma<q.oldMa*.998?'MA20 往下':'MA20 走平';return sh(['MA20 往上','MA20 往下','MA20 走平'],slope==='MA20 往上'?0:slope==='MA20 往下'?1:2);
 case'MA_STACK':side=q.c>q.ma&&q.ma>q.ma60?'價格 > MA20 > MA60':q.c<q.ma&&q.ma<q.ma60?'價格 < MA20 < MA60':'均線順序混合';return sh(['價格 > MA20 > MA60','價格 < MA20 < MA60','均線順序混合'],side==='價格 > MA20 > MA60'?0:side==='價格 < MA20 < MA60'?1:2);
 case'ATR':atrp=q.a/q.c;side=atrp>=.04?'高波動':atrp<=.02?'低波動':'中等波動';return sh(['高波動（ATR/股價 ≥ 4%）','低波動（≤ 2%）','中等波動'],side==='高波動'?0:side==='低波動'?1:2);
 case'VOLUME':vr=q.vr;side=vr>=1.5?'明顯放量':vr<=.7?'明顯縮量':'接近近期平均';return sh(['明顯放量','明顯縮量','接近近期平均'],side==='明顯放量'?0:side==='明顯縮量'?1:2);
 case'PRICE_VOLUME':chg=q.c/q.pc-1;side=chg>0&&q.vr>1.35?'上漲＋放量':chg<0&&q.vr>1.35?'下跌＋放量':q.vr<.8?'縮量':'量能普通';return sh(['上漲＋放量','下跌＋放量','縮量／量能普通'],side==='上漲＋放量'?0:side==='下跌＋放量'?1:2);
 case'PULLBACK':side=q.trendUp&&q.ma&&Math.abs(q.dist)<.05&&q.c>q.sup?'較像順勢回檔':'不像標準回檔';return sh(['較像順勢回檔','下降趨勢接刀','高檔追價'],side==='較像順勢回檔'?0:(q.trendDown?1:2));
 case'BREAKOUT_SETUP':side=q.c>q.prevHi?'較像有效突破':R.h[i]>q.prevHi?'只有盤中刺過':'仍未突破';return sh(['較像有效突破','只有盤中刺過','仍未突破'],side==='較像有效突破'?0:side==='只有盤中刺過'?1:2);
 case'RETEST_SETUP':return sh(['突破後回測守住，值得觀察','已完全跌回原區間，當作突破失敗','只要紅 K 就是回測成功'],0);
 case'NO_CHASE':side=(q.dist!=null&&q.dist>.08)||q.c>q.res*.995?'追高風險偏高':'位置尚未明顯過熱';return sh(['追高風險偏高','位置尚未明顯過熱','只要上漲就應該追'],side==='追高風險偏高'?0:1);
 case'INVALIDATION':stop=Math.max(.01,q.sup-q.a*.45);return sh(['放在支撐/結構低點下方：約 '+px(stop),'固定設在今天收盤 -1%','放在支撐上方，越近越好'],0);
 case'TARGET':target=q.res>q.c?q.res:maxA(R.h,i-60,i-1);return sh(['下一個明顯壓力：約 '+px(target),'固定今天收盤 +15%','支撐區：約 '+px(q.sup)],0);
 case'RR':stop=Math.max(.01,q.sup-q.a*.45);target=q.res>q.c?q.res:maxA(R.h,i-60,i-1);risk=q.c-stop;rrv=risk>0?(target-q.c)/risk:0;side=rrv>=2?'R:R ≥ 2':rrv>=1?'R:R 約 1～2':'R:R < 1';return sh(['R:R ≥ 2','R:R 約 1～2','R:R < 1'],side==='R:R ≥ 2'?0:side==='R:R 約 1～2'?1:2);
 case'POSITION':return sh(['失策距離越大，部位應越小','失策距離越大，部位應越大','部位和失策距離無關'],0);
 case'HOLD_EXIT':var day=Math.min(3,E.futureDays(R)),ci=X(day),st=Math.max(.01,q.sup-q.a*.45);side=R.c[ci]<st?'理由失效，應退出／重新評估':'理由尚未失效，可續抱觀察';return sh(['理由尚未失效，可續抱觀察','理由失效，應退出／重新評估','固定第 3 天一律賣'],side.indexOf('失效')>=0&&side.indexOf('尚未')<0?1:0);
 case'FULL_SCAN':var score=(q.trendUp?2:q.trendDown?-2:0)+(q.ma&&q.c>q.ma?1:-1)+(q.dist!=null&&q.dist>.09?-2:0)+(Math.abs(q.c-q.sup)<Math.abs(q.res-q.c)?1:0)+(q.vr>1.5&&q.c<q.pc?-1:0);side=score>=2?'值得進一步研究':score<=-2?'不值得買':'等待／資訊不夠乾淨';return sh(['值得進一步研究','不值得買','等待／資訊不夠乾淨'],side==='值得進一步研究'?0:side==='不值得買'?1:2);
 default:return options(['看懂了','還不確定','需要重看'],0);
 }}
function qtext(m,R,ex){var q=criterion(m.id,R);switch(m.skill){
 case'OHLC':return ex%3===1?'D0 這一天，哪個是「收盤」？':ex%3===2?'D0 這一天，哪個是「最低」？':'D0 這一天，哪個是「最高」？';