ge==='open')return '只公布開盤價供你執行原計畫；不會先讓你偷看當天高低收。';if(E.sharesHeld(c.st)>0)return '你已經承諾交易。之後每天只問：原本理由還成立嗎？';return '進場窗口已關閉。後面的行情只用來復盤，不能反悔買進。';}
function playChartData(c,R){var st=c.st,last=X(Math.max(0,st.day)),lines=[],lesson=c.mode==='lesson'?CT.LESSONS[c.lesson-1]:null,zones=[];if(c.stage==='plan'){lines.push({id:'stop',price:c.draft.stop,color:'#ffad38',label:'失策',draggable:true},{id:'target',price:c.draft.target,color:'#e7b84b',label:'目標區',draggable:true},{id:'entry',price:R.c[X(0)],color:'#55a8ff',label:'D0收盤',dash:true});}else if(st.firstEntry){lines.push({price:st.firstEntry.price,color:'#55a8ff',label:'進場'});if(E.isNum(st.stop))lines.push({price:st.stop,color:'#ffad38',label:'停損'});if(E.isNum(st.target))lines.push({price:st.target,color:'#e7b84b',label:'目標'});}if(lesson&&c.stage!=='holding'&&c.stage!=='playback'&&c.stage!=='open')zones=zonesFor(lesson.demo,R);return{R:R,lastIdx:last,d0Idx:X(0),showMA:c.mode==='lesson'?c.lesson>=5:S.lessons_done.length>=5,zones:zones,markers:[],lines:lines,labelFor:function(i){var k=i-X(0);return k<=0?'D'+k:'D+'+k;}};}
function dayBadges(c,R,q){var st=c.st,a=[];if(c.mode==='lesson'){a.push('<span class="badge blue">本課提示開啟</span>');if(c.lesson>=2)a.push('<span class="badge">教學判讀 '+q.trend+'</span>');if(c.lesson>=5)a.push('<span class="badge">D0距 MA20 '+pct(q.ma20Dist,true)+'</span>');if(c.lesson>=4)a.push('<span class="badge">D0量能 '+(q.volRatio?q.volRatio.toFixed(2)+'×':'—')+'</span>');}else{a.push('<span class="badge">提示關閉｜自己判斷</span>');}if(st.firstEntry)a.push('<span class="badge gold">成本 '+px(st.firstEntry.price)+'</span>');return a.join('');}
function playPanel(c,R,q){var st=c.st;if(c.stage==='inspect')return '<div class="coach"><div class="avatar">教</div><div class="say">先別問「會不會漲」。先回答：<strong>這個位置值不值得冒險？</strong></div></div>'+(c.mode==='lesson'?'<div class="card flat" style="margin-top:12px"><div class="small muted">本課觀察重點</div><div style="margin-top:6px">'+esc(CT.LESSONS[c.lesson-1].sub)+'</div></div>':'');
if(c.stage==='plan'){var est=E.maxSharesForRisk(START_NAV,START_NAV,q.close,c.draft.stop,c.draft.riskPct),pm=E.planMetrics({entry:q.close,stop:c.draft.stop,target:c.draft.target,shares:est,nav:START_NAV,atr:q.atr});return '<div class="card"><div class="eyebrow">PRE-COMMIT</div><div class="h2">先把交易寫死</div><div class="small muted">明天還沒出現。現在先決定你接受的條件。</div><div class="planline"><span class="k">交易型態</span><span class="v">'+esc(c.setup||'尚未選')+'</span></div><div class="row wrap" style="margin:8px 0">'+['回檔','突破','突破回測','其他'].map(function(x){return'<button class="chip '+(c.setup===x?'on':'')+'" data-act="setup" data-v="'+x+'">'+x+'</button>';}).join('')+'</div><div class="planline"><span class="k">失策／停損</span><span class="v" id="stopv">'+px(c.draft.stop)+'</span></div><div class="planline"><span class="k">目標／壓力</span><span class="v" id="targetv">'+px(c.draft.target)+'</span></div><div class="planline"><span class="k">最多接受跳空</span><span class="v">'+(c.draft.maxGap===null?'不限制':pct(c.draft.maxGap,true))+'</span></div><div class="row wrap" style="margin:8px 0">'+[0,.01,.02,.03].map(function(x){return'<button class="chip '+(c.draft.maxGap===x?'on':'')+'" data-act="gap" data-v="'+x+'">'+pct(x,true)+'</button>';}).join('')+'</div><div class="planline"><span class="k">單筆帳戶風險</span><span class="v">'+pct(c.draft.riskPct)+'</span></div><div class="row wrap" style="margin-top:8px">'+[.005,.01,.015,.02].map(function(x){return'<button class="chip '+(c.draft.riskPct===x?'on':'')+'" data-act="risk" data-v="'+x+'">'+pct(x)+'</button>';}).join('')+'</div><div class="hr"></div><div class="kv"><span class="k">估算股數</span><span class="v">'+money(est)+' 股</span></div><div class="kv"><span class="k">ATR 距離</span><span class="v">'+(pm.atrMultiple?pm.atrMultiple.toFixed(2)+' ATR':'—')+'</span></div><div class="kv"><span class="k">估算 R:R</span><span class="v">'+(pm.rr?pm.rr.toFixed(2):'—')+'</span></div></div>';}
if(c.stage==='open'){var o=E.revealOpen(st,R,c.openDay),invalid=o.exceeds||o.open<=c.draft.stop||o.open>=c.draft.target;return '<div class="card '+(invalid?'bad':'info')+'"><div class="eyebrow">D'+c.openDay+' OPEN</div><div class="row between"><div><div class="small muted">開盤價</div><div class="big">'+px(o.open)+'</div></div><div style="text-align:right"><div class="small muted">相對 D0</div><div class="big '+(o.planGap>0?'up':'down')+'">'+pct(o.planGap,true)+'</div></div></div><div class="hr"></div><div class="small">'+(o.locked?'漲停鎖死：客觀上無法成交。':o.exceeds?'超過你事前設定的最大可接受跳空，原計畫失效。':o.open<=c.draft.stop?'開盤已在失策點以下，原計畫失效。':o.open>=c.draft.target?'開盤已高於你原本的目標／壓力區，不應再用原計畫追入。':'仍在你事前允許的進場條件內。')+'</div></div>';}
if(c.stage==='holding'){var held=E.sharesHeld(st),r=E.currentR(st,R,st.day);return '<div class="card"><div class="eyebrow">HOLDING</div><div class="h2">今天收盤後，你只需要回答一件事</div><div class="lead">原本買進理由還成立嗎？</div><div class="grid2" style="margin-top:12px"><div class="rulebox"><div class="small muted">持有</div><div class="h2">'+money(held)+' 股</div></div><div class="rulebox"><div class="small muted">目前 R</div><div class="h2">'+(r===null?'—':(r>0?'+':'')+r.toFixed(2)+'R')+'</div></div></div>'+(st.pending?'<div class="coach" style="margin-top:10px"><div class="avatar">✓</div><div class="say">已決定<strong>明日開盤賣出</strong>。你可以在進到下一天前取消。</div></div>':'')+'</div>';}
if(c.stage==='playback')return '<div class="card"><div class="eyebrow">REVIEW ONLY</div><div class="h2">進場窗口已關閉</div><div class="lead">你現在可以看後續行情，但這題不能再買。這是為了防止「多看幾天才說自己本來會買」的後見之明。</div></div>';
return '';}
function playActions(c,R){var st=c.st;if(c.stage==='inspect')return '<div class="decision3"><button class="btn good" data-act="decision" data-v="buy">有機會<small>我要先做計畫</small></button><button class="btn bad" data-act="decision" data-v="skip">不值得買<small>放棄後不能追回</small></button><button class="btn" data-act="decision" data-v="unsure">看不懂<small>也是合法答案</small></button></div>';
if(c.stage==='plan')return '<div class="btnrow"><button class="btn ghost" data-act="backInspect">重看</button><button class="btn primary" data-act="lockPlan" '+(!c.setup?'disabled':'')+'>鎖定計畫，看 D1 開盤</button></div>';
if(c.stage==='open'){var o=E.revealOpen(st,R,c.openDay);if(o.locked&&c.openDay===1)return '<button class="btn primary block" data-act="retryD2">D1 鎖漲停，查看 D2 唯一重試</button>';if(o.locked&&c.openDay===2)return '<button class="btn block" data-act="abandon">D2 仍鎖漲停，本題無法進場</button>';var bad=o.exceeds||o.open<=c.draft.stop||o.open>=c.draft.target;return '<div class="btnrow"><button class="btn" data-act="abandon">放棄，本題不再買</button><button class="btn primary" data-act="execute" '+(bad?'disabled':'')+'>照原計畫買進</button></div>';}
if(c.stage==='holding')return '<div class="btnrow"><button class="btn" data-act="stopSheet">管理停損</button>'+(st.pending?'<button class="btn bad" data-act="cancelExit">取消明日賣出</button>':'<button class="btn bad" data-act="sellNext">明日開盤賣出</button>')+'</div><button class="btn primary block" style="margin-top:8px" data-act="nextDay">持有，進到下一交易日</button>';
if(c.stage==='playback')return '<div class="btnrow"><button class="btn" data-act="next5">快轉 5 天</button><button class="btn primary" data-act="nextDay">下一交易日</button></div>';
return '<button class="btn primary block" data-act="result">查看復盤</button>';}
function updatePlanFields(){var a=document.getElementById('stopv'),b=document.getElementById('targetv');if(a)a.textContent=px(current().draft.stop);if(b)b.textContent=px(current().draft.target);UI.chart&&UI.chart.draw();}

function stepOne(){var c=current(),R=getR(c.id),st=c.st;if(st.done){c.stage='done';save();go('result');return;}E.advanceDay(st,R);if(E.isBankrupt(navNow(c))){E.liquidateAtClose(st,R,st.day,'BANKRUPTCY');c.bankrupt=true;}if(st.done)c.stage='done';else if(E.sharesHeld(st)>0)c.stage='holding';else if(st.firstEntry)c.stage='done';else c.stage='playback';save();if(c.stage==='done')go('result');else render();}
function finishNoTradeIfEnd(){var c=current(),R=getR(c.id);if(c.st.day>=futureEnd(R)){c.st.done=true;c.stage='done';save();go('result');return true;}return false;}

function dateLabel(v){var s=String(v||'');return s.length===8?s.slice(0,4)+'-'+s.slice(4,6)+'-'+s.slice(6,8):s;}
function coachReview(R,q){
  var buy='';
  if(q.trend==='下降') buy='下降結構先不要急著抄底；等低點不再破、重新站回關鍵位置，或形成突破／回測後再談買點。';
  else if(E.isNum(q.ma20Dist)&&q.ma20Dist>0.08) buy='位置已明顯遠離 MA20。即使股票很強，也先等回檔或整理，不用在乖離過大處追價。';
  else if(q.breakout) buy='偏「突破型」觀察：只有 D1 沒有過度跳空、仍在原計畫風險範圍內，才考慮執行。';
  else if(q.nearSupport&&q.trend!=='下降') buy='偏「回檔型」觀察：價格接近近期支撐，重點是支撐守住，而且 D1 不能跳空到失去風報比。';
  else buy='目前沒有很乾淨的低風險位置。可以等更靠近支撐、有效突破，或直接選擇不買。';
  var a=q.atr||Math.max(.01,q.close*.02), stop=Math.max(.01,q.support-.5*a), target=(q.resistance>q.close*1.01?q.resistance:(q.hi60>q.close*1.01?q.hi60:q.close+2*a));
  return{buy:buy,stop:E.roundToTick(stop,'down'),target:E.roundToTick(target,'up'),exit:'持有後不是看「第幾天」。有效跌破失策區就代表原判斷受破壞；接近第一壓力區要觀察是否轉弱；若高低點持續墊高、支撐未破，可以繼續持有。'};
}
function review(c){var R=getR(c.id),st=c.st,day=Math.max(0,Math.min(st.day,futureEnd(R))),nav=E.navAt(st,R.c[X(day)]),pnl=nav-START_NAV,q=context(R),traded=!!st.firstEntry,bad=[];if(traded){if(st.firstEntry.accountRisk>0.02)bad.push('單筆帳戶風險超過 2%');if(st.flags.stop_widen_count>0)bad.push('進場後把停損往下放寬');if(st.flags.chase_plan_violation||st.flags.gap_plan_exceeded)bad.push('超過原本可接受進場條件仍追價');}
  var label;if(traded&&pnl>0&&bad.length)label='賺錢，但過程有問題';else if(traded&&pnl<0&&!bad.length)label='好虧損：計畫有守住';else if(traded&&pnl>=0)label='紀律獲利';else label=c.decision==='unsure'?'看不懂也沒有硬出手':'這題你選擇不買';
  var d1=R.o[X(1)],end=Math.min(futureEnd(R),20),mx=maxA(R.h,X(1),X(end)),mn=minA(R.l,X(1),X(end));return{nav:nav,pnl:pnl,label:label,bad:bad,ctx:q,best:mx/d1-1,worst:mn/d1-1,traded:traded};}
function applyOutcome(c){
  if(!c||c.applied)return;
  var r=review(c);
  if(c.mode==='lesson'){
    S.practiced[c.lesson]=true; S.lesson_used[c.lesson]=(S.lesson_used[c.lesson]||0)+1; maybeCompleteLesson(c.lesson);
  }else if(c.mode==='practice'){
    S.practice_results.push({id:c.id,pnl:r.pnl,decision:c.decision}); S.practice_idx++;
  }else if(c.mode==='exam'){
    S.exam_results.push({id:c.id,pnl:r.pnl,decision:c.decision}); S.exam_idx++;
  }
  c.applied=true; save();
}
SC.result=function(){var c=current();if(!c){go('home');return;}applyOutcome(c);var r=review(c),st=c.st,m=meta(c.id);app.innerHTML='<div class="screen">'+top('復盤','home')+'<div class="content"><div class="card '+(r.bad.length?'bad':'good')+'"><div class="eyebrow">ROUND REVIEW</div><div class="resultmark">'+esc(r.label)+'</div><div class="row between" style="margin-top:12px"><div><div class="small muted">本題損益</div><div class="big '+(r.pnl>0?'up':r.pnl<0?'down':'')+'">'+(r.pnl>0?'+':'')+nt(r.pnl)+'</div></div><span class="badge">'+esc(m.lb)+'</span></div></div>'+
'<div class="card flat"><div class="eyebrow">REVEAL</div><div class="h2">答案揭曉</div><div class="kv"><span class="k">真實股票</span><span class="v">'+esc(m.code)+' '+esc(m.name)+'</span></div><div class="kv"><span class="k">D0 日期</span><span class="v">'+dateLabel(BANK.calendar[m.d0])+'</span></div></div>'+
'<div class="card"><div class="h2">先看你當時能看到的事實</div><div class="kv"><span class="k">D0 結構</span><span class="v">'+r.ctx.trend+'</span></div><div class="kv"><span class="k">距 MA20</span><span class="v">'+pct(r.ctx.ma20Dist,true)+'</span></div><div class="kv"><span class="k">近期壓力</span><span class="v">'+px(r.ctx.resistance)+'</span></div><div class="kv"><span class="k">近期支撐</span><span class="v">'+px(r.ctx.support)+'</span></div><div class="kv"><span class="k">5/20 日量</span><span class="v">'+(r.ctx.volRatio?r.ctx.volRatio.toFixed(2)+'×':'—')+'</span></div></div>'+
(r.traded?'<div class="card"><div class="h2">交易過程</div><div class="kv"><span class="k">實際進場</span><span class="v">D+'+st.firstEntry.day+' @ '+px(st.firstEntry.price)+'</span></div><div class="kv"><span class="k">相對 D0 進場偏離</span><span class="v">'+pct(st.firstEntry.gap,true)+'</span></div><div class="kv"><span class="k">原始帳戶風險</span><span class="v">'+pct(st.firstEntry.accountRisk)+'</span></div><div class="kv"><span class="k">原始停損距離</span><span class="v">'+(st.firstEntry.atrMultiple?st.firstEntry.atrMultiple.toFixed(2)+' ATR':'—')+'</span></div>'+(r.bad.length?'<div class="hr"></div>'+r.bad.map(function(x){return'<div class="small up">× '+esc(x)+'</div>';}).join(''):'<div class="hr"></div><div class="small down">✓ 沒有偵測到主要紀律違規</div>')+'</div>':'')+
(function(){var cr=coachReview(getR(c.id),r.ctx);return '<div class="card info"><div class="eyebrow">COACH REVIEW</div><div class="h2">教練會怎麼看這個位置</div><div class="small muted">這是依 D0 當時資料產生的教學參考，不是事後唯一正解。</div><div class="hr"></div><div class="small"><strong>買點思路：</strong>'+esc(cr.buy)+'</div><div class="kv"><span class="k">參考失策區</span><span class="v">'+px(cr.stop)+'</span></div><div class="kv"><span class="k">第一壓力／觀察區</span><span class="v">'+px(cr.target)+'</span></div><div class="small" style="margin-top:8px"><strong>賣出思路：</strong>'+esc(cr.exit)+'</div></div>';})()+
'<div class="card flat"><div class="h2">結果不是答案，只是回饋</div><div class="small muted">以 D1 開盤為基準，後續前 '+Math.min(20,futureEnd(getR(c.id)))+' 天盤中最高曾 '+pct(r.best,true)+'，最低曾 '+pct(r.worst,true)+'。這不能反過來改寫你 D0 當時該不該買。</div></div>'+
resultButtons(c)+'</div>'+FOOT+'</div>';};
function resultButtons(c){if(c.mode==='lesson'){var done=lessonDone(c.lesson);return '<button class="btn primary block" data-act="lesson" data-n="'+c.lesson+'">'+(done?'回本課／前往下一課':'回本課完成測驗')+'</button>';}if(c.mode==='practice')return '<button class="btn primary block" data-act="nextPractice">下一題亂數實戰</button><button class="btn block" style="margin-top:8px" data-act="home">回首頁</button>';return '<button class="btn primary block" data-act="nextExam">下一題盲測</button><button class="btn block" style="margin-top:8px" data-act="home">暫停盲測</button>';}

SC.about=function(){app.innerHTML='<div class="screen">'+top('V2 說明',UI.params.back||'home')+'<div class="content"><div class="card"><div class="h2">這版重做了什麼</div><ul><li>進場只有 D1；只有 D1 客觀鎖漲停才允許 D2 一次重試。</li><li>自己放棄後，後續只能復盤，不能再買。</li><li>移除 D21 強制賣出，持有直到失策、停損、目標、手動退出或題目資料窗結束。</li><li>400 題訓練池亂數、100 題