
// Grade a drawn price line as a zone, not an exact pixel. The lesson's interaction spec supplies the
// target price and tolerance, which allows reasonable technical-analysis variation while still rejecting
// lines that miss the taught area. The chosen answer is then sent through the normal scoring path.
(function(){
  'use strict';
  document.addEventListener('click',function(e){
    var b=e.target.closest('[data-v4-line-confirm]');if(!b)return;
    var t=window.BSGV3&&window.BSGV3._test,ui=t&&t.ui,L=window.BSG_LESSONS;if(!t||!ui||!ui.mission||!L)return;
    var spec=L.get(ui.mission.id),it=spec&&spec.interaction;if(!it||it.type!=='pricePick')return;
    var pick=window.BSG_V4_LAST_PICK,read=document.getElementById('drawPickReadout');
    if(!Number.isFinite(pick)){if(read)read.textContent=it.empty||'先在圖上點一個價位，再按確認。';return;}
    var R=t.getR(ui.roundId),q=t.criterion(ui.mission.id,R),target=it.target(q),tol=it.tolerance(q),ok=Math.abs(pick-target)<=tol;
    var quiz=t.question(ui.mission,R,ui.exercise),idx=ok?quiz.correct:(quiz.correct+1)%quiz.opts.length;
    if(read)read.textContent='你畫在 '+pick.toFixed(window.BSG.priceDecimals(pick))+' 元；合理區域容許誤差約 ±'+tol.toFixed(window.BSG.priceDecimals(target))+' 元。';
    var target2=document.querySelector('.v4HiddenAnswers .answer[data-i="'+idx+'"]');if(target2)target2.click();
  });
})();
