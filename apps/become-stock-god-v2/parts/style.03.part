:root{--bg:#030814;--bg2:#07111f;--panel:#091727;--panel2:#0d2134;--line:rgba(73,201,255,.24);--line2:rgba(137,110,255,.28);--txt:#effaff;--muted:#7d9ab0;--cyan:#39f5ff;--blue:#26b9ff;--violet:#9876ff;--gold:#ffd44a;--red:#ff465f;--green:#24d79b;--orange:#ff9f43;--font:-apple-system,BlinkMacSystemFont,"PingFang TC","Noto Sans TC","Microsoft JhengHei",sans-serif;--mono:ui-monospace,SFMono-Regular,Menlo,monospace}*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}html,body{margin:0;background:radial-gradient(circle at 70% -10%,#132a50 0,#07111f 25%,#030814 58%);color:var(--txt);font:500 15px/1.45 var(--font);min-height:100%;overflow:hidden}button{font:inherit;color:inherit;cursor:pointer}button:disabled{opacity:.32;pointer-events:none}#app{height:100vh;height:100dvh;overflow:hidden}.screen{height:100vh;height:100dvh;display:flex;flex-direction:column;position:relative;isolation:isolate}.screen:before{content:"";position:absolute;inset:0;pointer-events:none;z-index:-1;background:linear-gradient(rgba(57,245,255,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(57,245,255,.018) 1px,transparent 1px);background-size:32px 32px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.9),transparent 85%)}.scanline{position:fixed;pointer-events:none;z-index:50;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,rgba(57,245,255,.55),transparent);box-shadow:0 0 18px rgba(57,245,255,.5);animation:scan 7s linear infinite;opacity:.35}@keyframes scan{0%{top:-2%}100%{top:102%}}.hudbar{height:64px;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:12px;padding:8px 14px;border-bottom:1px solid var(--line);background:linear-gradient(180deg,rgba(5,15,29,.98),rgba(5,13,25,.86));box-shadow:0 10px 34px rgba(0,0,0,.28);z-index:12}.brand{display:flex;align-items:center;gap:9px;min-width:0}.crown{width:39px;height:39px;border:1px solid rgba(255,212,74,.45);border-radius:12px;display:grid;place-items:center;background:radial-gradient(circle,#443812 0,#15140e 70%);color:var(--gold);box-shadow:0 0 22px rgba(255,212,74,.18);font-size:20px}.brandname{font-weight:950;letter-spacing:.08em;white-space:nowrap}.brandname b{color:var(--gold);text-shadow:0 0 12px rgba(255,212,74,.35)}.brandsub{font:700 9px/1.2 var(--mono);letter-spacing:.18em;color:#5ea4c4}.xpbox{display:flex;align-items:center;gap:9px;min-width:0}.lv{color:#d9c8ff;font:900 12px var(--mono);white-space:nowrap}.xpbar{height:7px;flex:1;min-width:60px;max-width:320px;background:#0b1c2e;border:1px solid rgba(100,168,210,.18);border-radius:999px;overflow:hidden}.xpbar i{display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--violet),var(--cyan));box-shadow:0 0 14px var(--cyan)}.hudstats{display:flex;align-items:center;gap:8px}.hudpill{height:38px;min-width:78px;padding:0 11px;border:1px solid var(--line);border-radius:11px;background:linear-gradient(180deg,rgba(10,27,45,.95),rgba(6,17,31,.95));display:flex;align-items:center;justify-content:center;gap:6px;font:800 12px var(--mono);white-space:nowrap}.hudpill.gold{color:var(--gold)}.hudpill.fire{color:#ff7b5f}.iconbtn{width:40px;height:40px;border-radius:11px;border:1px solid var(--line);background:#09192a;display:grid;place-items:center;font-size:18px}.iconbtn:hover,.iconbtn:active{border-color:var(--cyan);box-shadow:0 0 16px rgba(57,245,255,.18)}.main{flex:1;min-height:0;display:flex;overflow:hidden}.sidebar{width:290px;border-right:1px solid var(--line);background:linear-gradient(180deg,rgba(7,18,32,.92),rgba(4,11,22,.96));padding:12px;overflow:auto;scrollbar-width:thin;scrollbar-color:#17415a transparent}.sidehead{border:1px solid var(--line);border-radius:15px;padding:13px;background:linear-gradient(135deg,rgba(23,67,93,.24),rgba(10,19,35,.5));margin-bottom:10px}.worldcode{font:900 10px var(--mono);letter-spacing:.16em;color:var(--cyan)}.worldtitle{font-size:21px;font-weight:950;margin:3px 0}.worldsub{font-size:12px;color:var(--muted)}.worldprog{margin-top:10px;display:flex;align-items:center;gap:8px}.miniBar{height:5px;flex:1;background:#0e2538;border-radius:99px;overflow:hidden}.miniBar i{display:block;height:100%;background:linear-gradient(90deg,var(--cyan),var(--violet));box-shadow:0 0 12px rgba(57,245,255,.3)}.missionlist{display:flex;flex-direction:column;gap:7px}.missionrow{width:100%;display:grid;grid-template-columns:36px 1fr auto;gap:9px;align-items:center;text-align:left;border:1px solid rgba(70,145,190,.18);border-radius:12px;padding:8px;background:rgba(8,23,39,.72)}.missionrow .num{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:#0d263a;border:1px solid rgba(77,190,255,.22);font:900 11px var(--mono);color:#7ea8c0}.missionrow .tt{font-weight:850;font-size:13px}.missionrow .st{font-size:10px;color:var(--muted);margin-top:1px}.missionrow.current{border-color:var(--cyan);background:linear-gradient(90deg,rgba(57,245,255,.16),rgba(57,245,255,.04));box-shadow:inset 3px 0 0 var(--cyan),0 0 18px rgba(57,245,255,.09)}.missionrow.current .num{color:#06151e;background:var(--cyan);box-shadow:0 0 16px rgba(57,245,255,.35)}.missionrow.done{border-color:rgba(36,215,155,.25)}.missionrow.done .num{color:#062017;background:var(--green)}.missionrow.locked{opacity:.32}.missionrow.premium .lock{color:var(--gold)}.homebody{flex:1;min-height:0;overflow:auto;padding:18px 20px 28px}.heroGrid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(300px,.7fr);gap:16px}.heroPanel,.glass{border:1px solid var(--line);border-radius:18px;background:linear-gradient(145deg,rgba(11,31,51,.94),rgba(5,14,28,.88));box-shadow:inset 0 1px 0 rgba(255,255,255,.035),0 18px 60px rgba(0,0,0,.24);position:relative;overflow:hidden}.heroPanel:after,.glass:after{content:"";position:absolute;width:180px;height:180px;border-radius:50%;right:-70px;top:-90px;background:radial-gradient(circle,rgba(57,245,255,.2),transparent 70%);pointer-events:none}.heroPanel{padding:24px}.kicker{font:900 11px var(--mono);letter-spacing:.17em;color:var(--cyan)}.heroTitle{font-size:clamp(31px,4.5vw,58px);line-height:.98;font-weight:1000;letter-spacing:-.04em;margin:8px 0 12px}.heroTitle span{display:block;color:var(--gold);text-shadow:0 0 22px rgba(255,212,74,.22)}.heroLead{max-width:720px;color:#b8d0de;font-size:15px;line-height:1.65}.ctaRow{display:flex;gap:10px;flex-wrap:wrap;margin-top:18px}.btn{min-height:46px;border-radius:12px;border:1px solid var(--line);background:linear-gradient(180deg,#102a42,#0a1a2c);padding:9px 15px;font-weight:900;letter-spacing:.01em;display:inline-flex;align-items:center;justify-content:center;gap:7px}.btn.primary{color:#04131a;background:linear-gradient(135deg,#58fbff,#2ec9ff);border-color:#74fbff;box-shadow:0 0 24px rgba(57,245,255,.2)}.btn.gold{color:#211b04;background:linear-gradient(135deg,#ffe36f,#ffbd37);border-color:#ffe67c;box-shadow:0 0 24px rgba(255,212,74,.16)}.btn.green{color:#03170f;background:linear-gradient(135deg,#4ff0b0,#24d79b);border-color:#69f3bd}.btn.red{color:#fff;background:linear-gradient(135deg,#8d2537,#4a1322);border-color:#c1465d}.btn.ghost{background:rgba(7,19,34,.45)}.btn.full{width:100%}.btn:active{transform:translateY(1px) scale(.995)}.statPanel{padding:18px;display:grid;grid-template-columns:1fr 1fr;gap:10px}.statBox{border:1px solid rgba(86,167,214,.2);border-radius:14px;background:rgba(7,22,38,.76);padding:13px}.statLabel{font-size:10px;color:var(--muted);letter-spacing:.11em;text-transform:uppercase}.statValue{font:950 25px/1.1 var(--mono);margin-top:4px}.statValue.cyan{color:var(--cyan)}.statValue.gold{color:var(--gold)}.worldGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:16px}.worldCard{border:1px solid rgba(76,165,210,.22);border-radius:16px;padding:16px;background:linear-gradient(145deg,rgba(11,28,47,.9),rgba(6,15,28,.9));min-height:142px;position:relative;overflow:hidden}.worldCard .wc{font:900 9px var(--mono);letter-spacing:.15em;color:var(--cyan)}.worldCard .wt{font-size:18px;font-weight:950;margin:5px 0}.worldCard .ws{font-size:12px;color:var(--muted)}.worldCard .wp{position:absolute;left:16px;right:16px;bottom:14px;display:flex;align-items:center;gap:8px}.worldCard.locked{opacity:.46}.worldCard.active{border-color:rgba(57,245,255,.65);box-shadow:0 0 24px rgba(57,245,255,.08)}.premiumBanner{margin-top:16px;padding:16px;display:flex;gap:16px;align-items:center;justify-content:space-between}.premiumBanner .gem{font-size:30px;color:var(--gold)}.training{flex:1;min-width:0;min-height:0;display:grid;grid-template-rows:auto minmax(0,1fr) auto;background:radial-gradient(circle at 55% 18%,rgba(24,69,102,.15),transparent 44%)}.trainingHead{min-height:52px;display:flex;align-items:center;gap:10px;padding:7px 12px;border-bottom:1px solid rgba(76,160,205,.18);background:rgba(4,13,25,.7)}.missionTag{min-width:54px;border:1px solid rgba(57,245,255,.42);color:var(--cyan);background:rgba(57,245,255,.07);border-radius:10px;padding:7px 9px;font:900 11px var(--mono);text-align:center;box-shadow:inset 0 0 16px rgba(57,245,255,.06)}.trainTitle{min-width:0}.trainTitle strong{display:block;font-size:15px}.trainTitle span{font-size:11px;color:var(--muted)}.stepDots{margin-left:auto;display:flex;gap:5px}.stepDots i{width:7px;height:7px;border-radius:50%;background:#1a3448;border:1px solid #285570}.stepDots i.on{background:var(--cyan);box-shadow:0 0 9px var(--cyan)}.stepDots i.done{background:var(--green)}.chartArea{min-height:0;position:relative;padding:10px 10px 0}.chartFrame{height:100%;min-height:280px;border:1px solid rgba(57,245,255,.34);border-radius:16px;overflow:hidden;position:relative;background:#050b17;box-shadow:0 0 0 1px rgba(57,245,255,.035) inset,0 0 42px rgba(0,177,255,.07)}.chartFrame:before{content:"MARKET FEED // HISTORICAL TRAINING";position:absolute;z-index:2;left:12px;top:9px;font:800 9px var(--mono);letter-spacing:.12em;color:rgba(109,201,230,.42);pointer-events:none}.chartwrap{width:100%;height:100%;min-height:280px;position:relative;touch-action:none}.chartwrap canvas{display:block;width:100%;height:100%}.charttip{position:absolute;z-index:8;left:10px;top:30px;max-width:calc(100% - 20px);padding:6px 8px;border:1px solid rgba(57,245,255,.3);border-radius:8px;background:rgba(2,10,18,.9);color:#dff8ff;font:750 10px var(--mono);pointer-events:none;box-shadow:0 0 18px rgba(57,245,255,.1)}.chartctl.v3{position:absolute;z-index:7;right:8px;bottom:8px;display:flex;gap:5px}.chartctl.v3 button{height:30px;min-width:39px;border:1px solid rgba(70,153,200,.28);border-radius:8px;background:rgba(5,18,31,.9);font:800 10px var(--mono);color:#7190a8}.chartctl.v3 button.on{color:var(--cyan);border-color:rgba(57,245,255,.7);box-shadow:0 0 11px rgba(57,245,255,.12)}.chartlegend{position:absolute;z-index:7;right:8px;top:8px;display:flex;gap:8px;padding:5px 7px;border-radius:8px;border:1px solid rgba(70,153,200,.22);background:rgba(4,14,25,.86);font:800 10px var(--mono)}.chartlegend span{display:flex;align-items:center;gap:4px}.chartlegend i{display:block;width:14px;height:3px;border-radius:3px}.coachOrb{position:absolute;z-index:6;left:16px;bottom:13px;width:42px;height:42px;border-radius:50%;display:grid;place-items:center;border:1px solid rgba(57,245,255,.6);background:radial-gradient(circle at 38% 35%,#78fbff,#136079 35%,#061826 72%);box-shadow:0 0 22px rgba(57,245,255,.24),inset 0 0 13px rgba(255,255,255,.12);color:white;font-weight:1000}.coachOrb:before,.coachOrb:after{content:"";position:absolute;inset:-6px;border:1px solid rgba(57,245,255,.2);border-radius:50%;animation:orb 2.8s linear infinite}.coachOrb:after{inset:-11px;animation-duration:5.2s;opacity:.45}@keyframes orb{to{transform:rotate(360deg)}}.lessonDock{border-top:1px solid var(--line);background:linear-gradient(180deg,rgba(4,13,25,.92),#04101e);padding:10px 12px calc(10px + env(safe-area-inset-bottom));min-height:190px}.dockGrid{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(310px,.8fr);gap:12px;height:100%}.prompt{border:1px solid rgba(57,245,255,.28);border-radius:14px;background:linear-gradient(135deg,rgba(10,32,51,.86),rgba(7,18,32,.78));padding:12px 14px;position:relative;overflow:hidden}.prompt:before{content:"";position:absolute;left:0;top:0;bottom:0;width:3px;background:linear-gradient(var(--cyan),var(--violet));box-shadow:0 0 12px var(--cyan)}.promptTop{display:flex;align-items:center;gap:8px;margin-bottom:5px}.qtag{font:950 12px var(--mono);color:var(--cyan)}.difficulty{font:800 9px var(--mono);border:1px solid rgba(57,245,255,.25);border-radius:999px;padding:2px 7px;color:#7fb0c6}.question{font-size:18px;font-weight:900;line-height:1.35}.explain{font-size:12px;color:#a7c2d1;margin-top:7px;line-height:1.5}.coachLine{margin-top:8px;padding:7px 9px;border-radius:9px;background:rgba(90,119,255,.08);border:1px solid rgba(142,118,255,.22);font-size:11px;color:#c8c0ff}.answers{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;align-content:stretch}.answer{min-height:70px;border:1px solid rgba(76,163,210,.3);border-radius:13px;background:linear-gradient(180deg,#0c253a,#081a2b);font-weight:900;padding:10px;text-align:center;position:relative;overflow:hidden}.answer:hover{border-color:rgba(57,245,255,.7)}.answer.correct{border-color:var(--green);box-shadow:0 0 18px rgba(36,215,155,.16);background:linear-gradient(180deg,rgba(22,89,68,.72),rgba(7,39,31,.9))}.answer.wrong{border-color:var(--red);box-shadow:0 0 18px rgba(255,70,95,.12);background:linear-gradient(180deg,rgba(100,28,41,.7),rgba(48,12,23,.9))}.answer small{display:block;color:var(--muted);font-weight:650;margin-top:3px;font-size:10px}.answerHelp{grid-column:1/-1;min-height:38px;border:1px dashed rgba(122,155,185,.26);background:transparent;border-radius:10px;color:#7f9bae;font-size:11px;font-weight:800}.feedbackBox{grid-column:1/-1;border:1px solid rgba(36,215,155,.36);background:rgba(36,215,155,.07);border-radius:12px;padding:9px 11px;font-size:12px;line-height:1.45}.feedbackBox.bad{border-color:rgba(255,70,95,.4);background:rgba(255,70,95,.06)}.feedbackBox strong{color:#fff}.nextBtn{grid-column:1/-1}.pulse{animation:pulse 1.7s ease-in-out infinite}@keyframes pulse{50%{box-shadow:0 0 28px rgba(57,245,255,.32)}}.mastery{display:grid;place-items:center;height:100%;padding:24px;text-align:center}.rankRing{width:150px;height:150px;border-radius:50%;display:grid;place-items:center;position:relative;background:radial-gradient(circle,#102a41 0,#07131f 58%,#030814 70%);border:1px solid rgba(57,245,255,.45);box-shadow:0 0 50px rgba(57,245,255,.13),inset 0 0 28px rgba(57,245,255,.08)}.rankRing:before{content:"";position:absolute;inset:-9px;border:2px solid transparent;border-top-color:var(--cyan);border-right-color:var(--violet);border-radius:50%;animation:orb 4s linear infinite}.rankRing .grade{font:1000 48px var(--mono);color:var(--cyan);text-shadow:0 0 18px rgba(57,245,255,.45)}.mastery h2{font-size:28px;margin:17px 0 4px}.mastery p{max-width:580px;color:#9ab7c8}.rewardRow{display:flex;gap:10px;margin:12px 0 18px}.reward{border:1px solid rgba(255,212,74,.3);border-radius:11px;padding:7px 11px;color:var(--gold);background:rgba(255,212,74,.05);font:850 12px var(--mono)}.paywall{display:grid;place-items:center;height:100%;padding:24px}.payCard{max-width:720px;border:1px solid rgba(255,212,74,.42);border-radius:22px;padding:24px;background:radial-gradient(circle at 80% 0,rgba(255,212,74,.12),transparent 38%),linear-gradient(145deg,#0d2034,#06111f);box-shadow:0 0 60px rgba(255,212,74,.08)}.payIcon{font-size:40px}.payTitle{font-size:34px;font-weight:1000;margin:6px 0}.payPrice{font:1000 34px var(--mono);color:var(--gold);margin:10px 0}.payFeatures{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0}.payFeature{border:1px solid rgba(84,159,200,.18);background:rgba(7,23,39,.6);border-radius:10px;padding:9px 10px;font-size:12px;color:#b8cddd}.legal{font-size:10px;color:#5f8197;margin-top:10px}.toast{position:fixed;z-index:100;left:50%;bottom:18px;transform:translateX(-50%);max-width:calc(100% - 28px);border:1px solid rgba(57,245,255,.3);background:rgba(4,15,26,.96);box-shadow:0 8px 32px rgba(0,0,0,.4),0 0 18px rgba(57,245,255,.08);border-radius:11px;padding:9px 12px;font-size:12px}.sheetBg{position:fixed;inset:0;z-index:80;background:rgba(0,0,0,.62);backdrop-filter:blur(3px)}.sheet{position:fixed;z-index:81;left:50%;bottom:0;transform:translateX(-50%);width:min(680px,100%);max-height:76vh;overflow:auto;border:1px solid rgba(57,245,255,.35);border-bottom:0;border-radius:20px 20px 0 0;background:linear-gradient(#0b2032,#06111f);padding:18px 18px calc(18px + env(safe-area-inset-bottom));box-shadow:0 -20px 60px rgba(0,0,0,.35)}.sheet h3{margin:0 0 7px;font-size:20px}.sheet p{color:#a8c2d1}.hintStep{border-left:2px solid var(--cyan);padding:8px 10px;margin:8px 0;background:rgba(57,245,255,.055);font-size:12px}.debugBadge{position:fixed;right:8px;top:70px;z-index:60;font:800 9px var(--mono);border:1px solid rgba(255,212,74,.25);border-radius:999px;padding:3px 7px;color:#8e8353;background:rgba(6,13,22,.7);pointer-events:none}@media(max-width:980px){.sidebar{width:220px}.dockGrid{grid-template-columns:1fr}.lessonDock{min-height:245px}.answers{grid-template-columns:repeat(3,1fr)}.worldGrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:760px){html,body{overflow:hidden}.hudbar{height:56px;padding:6px 8px;gap:7px}.brandname{font-size:13px}.brandsub{display:none}.crown{width:34px;height:34px;border-radius:10px}.xpbox{display:none}.hudstats .hudpill:nth-child(2){display:none}.hudpill{min-width:62px;height:34px;padding:0 8px;font-size:10px}.main{display:block;position:relative}.sidebar{display:none}.homebody{padding:12px 10px 18px}.heroGrid{grid-template-columns:1fr}.heroPanel{padding:18px}.heroTitle{font-size:38px}.heroLead{font-size:13px}.statPanel{padding:12px}.worldGrid{grid-template-columns:1fr 1fr;gap:8px}.worldCard{min-height:128px;padding:12px}.worldCard .wt{font-size:15px}.worldCard .ws{font-size:10px}.training{height:calc(100dvh - 56px);grid-template-rows:48px minmax(0,1fr) auto}.trainingHead{padding:5px 8px}.trainTitle strong{font-size:13px}.trainTitle span{font-size:9px}.stepDots i{width:6px;height:6px}.chartArea{padding:6px 6px 0}.chartFrame{border-radius:12px}.lessonDock{min-height:238px;padding:7px 7px calc(7px + env(safe-area-inset-bottom))}.dockGrid{gap:6px}.prompt{padding:9px 10px;border-radius:11px}.promptTop{margin-bottom:3px}.question{font-size:15px}.explain{font-size:10px;margin-top:4px}.coachLine{font-size:10px;padding:5px 7px;margin-top:5px}.answers{gap:5px}.answer{min-height:58px;border-radius:10px;padding:7px 5px;font-size:12px}.answer small{font-size:9px}.answerHelp{min-height:32px}.feedbackBox{padding:6px 8px;font-size:10px}.btn{min-height:40px;padding:7px 10px;font-size:12px}.chartlegend{font-size:9px;top:6px;right:6px}.chartctl.v3{right:5px;bottom:5px;gap:3px}.chartctl.v3 button{min-width:34px;height:27px;font-size:9px}.coachOrb{left:10px;bottom:9px;width:34px;height:34px;font-size:11px}.premiumBanner{display:block}.premiumBanner .btn{margin-top:10px;width:100%}.paywall{padding:14px}.payCard{padding:18px}.payTitle{font-size:26px}.payFeatures{grid-template-columns:1fr}.debugBadge{display:none}}@media(max-width:390px){.brandname{font-size:12px}.hudpill{min-width:56px}.worldGrid{grid-template-columns:1fr}.worldCard{min-height:108px}.heroTitle{font-size:34px}.lessonDock{min-height:250px}.answer{font-size:11px}.question{font-size:14px}}