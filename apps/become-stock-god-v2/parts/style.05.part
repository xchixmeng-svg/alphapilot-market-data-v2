/* V3 game shell — desktop + iPhone landscape + integrated AI coach */
#app,.screen{max-width:none!important;width:100%!important;height:var(--app-h,100dvh)!important;min-height:0!important}
.fullscreenBtn{font-size:20px!important}
@media(min-width:941px){
  .main:has(>.training){display:grid!important;grid-template-columns:300px minmax(0,1fr) 280px!important;align-items:stretch!important;overflow:hidden!important}
  .main:has(>.training)>.sidebar{width:auto!important;min-width:0!important}
  .main:has(>.training)>.training{min-width:0!important}
  .training{grid-template-rows:54px minmax(0,1fr) auto!important}
  .trainingHead{padding:7px 14px!important;background:linear-gradient(180deg,rgba(7,22,39,.98),rgba(4,13,25,.9))!important}
  .chartArea{padding:10px 12px 0!important}
  .chartFrame{border-radius:18px!important;border-color:rgba(57,245,255,.56)!important;box-shadow:0 0 0 1px rgba(57,245,255,.06) inset,0 0 34px rgba(0,190,255,.1)!important}
  .lessonDock{min-height:218px!important;padding:10px 12px 12px!important;background:linear-gradient(180deg,rgba(5,16,29,.96),rgba(3,10,20,.99))!important}
  .dockGrid{grid-template-columns:minmax(0,1.12fr) minmax(330px,.88fr)!important;gap:12px!important}
  .prompt,.answers{min-width:0}.prompt{padding:14px 16px!important;border-color:rgba(57,245,255,.46)!important;box-shadow:0 0 20px rgba(57,245,255,.06) inset!important}
  .question{font-size:20px!important;line-height:1.38!important}.answer{min-height:82px!important;font-size:15px!important;border-width:1px!important;box-shadow:inset 0 0 18px rgba(57,245,255,.025)!important}
  .sidebar{border-right-color:rgba(57,245,255,.32)!important;box-shadow:8px 0 32px rgba(0,0,0,.22)}.sidehead{border-color:rgba(57,245,255,.38)!important;box-shadow:0 0 20px rgba(57,245,255,.07) inset!important}
}
.coachRail{min-width:0;position:relative;display:flex;flex-direction:column;gap:10px;padding:12px 10px;border-left:1px solid rgba(57,245,255,.34);background:radial-gradient(circle at 50% 34%,rgba(34,108,172,.24),transparent 42%),linear-gradient(180deg,#061326 0,#020915 100%);overflow:hidden;box-shadow:-10px 0 34px rgba(0,0,0,.22)}
.coachRail:before{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(120deg,transparent 0 49%,rgba(57,245,255,.035) 50%,transparent 51%) 0 0/36px 36px,radial-gradient(circle at 90% 8%,rgba(132,91,255,.18),transparent 24%)}
.coachSpeech{position:relative;z-index:3;border:1px solid rgba(57,245,255,.58);border-radius:15px;padding:12px 13px 14px;background:linear-gradient(145deg,rgba(11,38,61,.96),rgba(5,19,35,.94));box-shadow:0 0 24px rgba(57,245,255,.12),inset 0 0 18px rgba(57,245,255,.035)}
.coachSpeechTitle{font:950 12px var(--mono);letter-spacing:.04em;color:var(--cyan);margin-bottom:7px;text-shadow:0 0 12px rgba(57,245,255,.28)}.coachSpeechBody{font-size:14px;line-height:1.58;color:#e7f7ff;font-weight:700}
.coachPortrait,.homeCoachPortrait{position:relative;z-index:2;overflow:hidden;background-image:linear-gradient(to top,rgba(2,8,18,.98) 0,rgba(2,8,18,.05) 34%,transparent 60%),url("__COACH_ASSET__");background-size:cover;background-position:center top;border:1px solid rgba(57,245,255,.3);box-shadow:0 0 28px rgba(57,245,255,.12),inset 0 0 30px rgba(57,245,255,.035)}
.coachPortrait{flex:1;min-height:300px;border-radius:18px}.coachIdentity{position:absolute;z-index:3;left:10px;right:10px;bottom:8px;display:flex;align-items:flex-end;justify-content:space-between;padding:7px 9px;border:1px solid rgba(57,245,255,.36);border-radius:10px;background:rgba(3,13,25,.82);backdrop-filter:blur(8px)}
.coachIdentity span{font:800 9px var(--mono);letter-spacing:.13em;color:#6fb9d5}.coachIdentity strong{font-size:18px;color:#fff;text-shadow:0 0 12px rgba(57,245,255,.32)}
.coachQuick{position:relative;z-index:3;display:grid;grid-template-columns:1fr 1fr;gap:7px}.coachQuick button{min-height:40px;border:1px solid rgba(68,176,226,.36);border-radius:10px;background:linear-gradient(180deg,#0b2740,#07192c);color:#d9f4ff;font-weight:900;font-size:10px}.coachQuick button:first-child{grid-column:1/-1;border-color:rgba(57,245,255,.7);font-size:12px;background:linear-gradient(180deg,rgba(20,73,111,.98),rgba(7,33,55,.98))}
.coachOrb{background-image:url("__COACH_ASSET__")!important;background-size:cover!important;background-position:center top!important;color:transparent!important;border-color:rgba(57,245,255,.72)!important}
/* Home coach is a real third column, not a floating label. */
.heroGrid:has(>.homeCoach){grid-template-columns:minmax(0,1.25fr) minmax(280px,.55fr) 270px!important;align-items:stretch}
.homeCoach{min-width:0;display:flex;flex-direction:column;gap:8px;border:1px solid rgba(57,245,255,.34);border-radius:18px;padding:9px;background:radial-gradient(circle at 50% 25%,rgba(42,117,180,.2),transparent 42%),linear-gradient(180deg,#07172a,#030a15);box-shadow:0 18px 60px rgba(0,0,0,.24),0 0 30px rgba(57,245,255,.08);overflow:hidden}
.homeCoachSpeech{position:relative;z-index:3;border:1px solid rgba(57,245,255,.5);border-radius:12px;padding:9px 10px;background:rgba(5,24,42,.94)}.homeCoachSpeech b{display:block;color:var(--cyan);font-size:11px;margin-bottom:4px}.homeCoachSpeech span{display:block;color:#e9f8ff;font-size:11px;line-height:1.4;font-weight:750}
.homeCoachPortrait{flex:1;min-height:300px;border-radius:14px}
.debugBadge{display:none!important}
@media(min-width:941px) and (max-width:1240px){.main:has(>.training){grid-template-columns:225px minmax(0,1fr) 220px!important}.heroGrid:has(>.homeCoach){grid-template-columns:minmax(0,1fr) 240px 210px!important}.coachRail{padding:8px 6px}.coachSpeech{padding:9px}.coachSpeechBody{font-size:11px}.coachPortrait{min-height:240px}.lessonDock{min-height:250px!important}.dockGrid{grid-template-columns:1fr!important}}
/* iPhone / short landscape: use visible viewport height, remove all minimum heights that caused clipping. */
@media (orientation:landscape) and (max-height:520px){
  html,body{height:var(--app-h,100dvh)!important;min-height:0!important;overflow:hidden!important}
  #app,.screen{height:var(--app-h,100dvh)!important;min-height:0!important;overflow:hidden!important}
  .hudbar{height:44px!important;min-height:44px!important;padding:4px 8px!important;gap:6px!important}.crown{width:32px!important;height:32px!important}.brandname{font-size:12px!important}.brandsub{display:none!important}.xpbox{display:flex!important}.lv{font-size:9px!important}.hudpill{height:30px!important;min-width:48px!important;padding:0 6px!important}.iconbtn{width:32px!important;height:32px!important}
  .homebody{height:calc(var(--app-h,100dvh) - 44px)!important;overflow:hidden!important;padding:8px!important}.worldGrid,.premiumBanner,.legal{display:none!important}
  .heroGrid:has(>.homeCoach){height:100%!important;grid-template-columns:minmax(0,1fr) 210px 190px!important;gap:7px!important}.heroPanel{padding:12px!important}.kicker{font-size:8px!important}.heroTitle{font-size:clamp(28px,6.3vh,40px)!important;margin:4px 0 7px!important}.heroLead{font-size:10px!important;line-height:1.42!important;max-height:58px!important;overflow:hidden}.ctaRow{margin-top:8px!important}.ctaRow .btn{min-height:36px!important;font-size:10px!important;padding:6px 10px!important}.statPanel{padding:7px!important;gap:5px!important}.statBox{padding:7px!important;border-radius:10px!important}.statLabel{font-size:7px!important}.statValue{font-size:17px!important}.homeCoach{padding:5px!important;gap:4px!important;border-radius:12px!important}.homeCoachSpeech{padding:6px!important}.homeCoachSpeech b,.homeCoachSpeech span{font-size:8px!important}.homeCoachPortrait{min-height:0!important;height:100%!important;border-radius:10px!important;background-position:center 5%!important}
  .main:has(>.training){height:calc(var(--app-h,100dvh) - 44px)!important;display:grid!important;grid-template-columns:150px minmax(0,1fr) 180px!important;overflow:hidden!important}
  .main:has(>.training)>.sidebar{display:block!important;width:auto!important;min-width:0!important;height:100%!important;padding:5px!important;overflow:auto!important}.sidehead{padding:6px!important;margin-bottom:4px!important}.worldtitle{font-size:13px!important}.worldsub{display:none!important}.missionlist{gap:3px!important}.missionrow{grid-template-columns:25px 1fr auto!important;gap:4px!important;padding:4px!important}.missionrow .num{width:23px!important;height:23px!important;font-size:8px!important}.missionrow .tt{font-size:9px!important}.missionrow .st{display:none!important}
  .main:has(>.training)>.training{height:100%!important;min-height:0!important;overflow:hidden!important;grid-template-rows:34px minmax(0,1fr) 112px!important}.trainingHead{min-height:0!important;padding:2px 5px!important}.missionTag{min-width:40px!important;padding:4px!important;font-size:8px!important}.trainTitle strong{font-size:10px!important}.trainTitle span{display:none!important}.chartArea{min-height:0!important;height:100%!important;padding:3px 4px 0!important}.chartFrame,.chartwrap{height:100%!important;min-height:0!important;border-radius:9px!important}.chartlegend{font-size:7px!important;padding:3px!important}.chartctl.v3 button{height:22px!important;min-width:27px!important;font-size:7px!important}.lessonDock{height:112px!important;min-height:0!important;padding:4px!important;overflow:hidden!important}.dockGrid{height:100%!important;grid-template-columns:minmax(0,1.08fr) minmax(210px,.92fr)!important;gap:4px!important}.prompt{padding:5px 7px!important}.promptTop{margin:0!important}.qtag{font-size:8px!important}.difficulty{display:none!important}.question{font-size:11px!important;line-height:1.25!important}.explain,.coachLine{font-size:8px!important;line-height:1.25!important;margin-top:2px!important;padding:3px 4px!important}.answers{gap:3px!important}.answer{min-height:32px!important;font-size:9px!important;padding:3px!important;border-radius:7px!important}.answer small{display:none!important}.answerHelp{min-height:24px!important;font-size:8px!important}.feedbackBox{font-size:8px!important;padding:3px 4px!important}.btn{min-height:30px!important;font-size:9px!important}
  .coachRail{display:flex!important;height:100%!important;padding:4px!important;gap:4px!important}.coachSpeech{padding:5px!important;border-radius:8px!important}.coachSpeechTitle{font-size:8px!important;margin:0 0 2px!important}.coachSpeechBody{font-size:8px!important;line-height:1.25!important;max-height:42px!important;overflow:hidden!important}.coachPortrait{min-height:0!important;flex:1!important;border-radius:9px!important;background-position:center 5%!important}.coachIdentity{left:4px!important;right:4px!important;bottom:4px!important;padding:3px 4px!important}.coachIdentity span{font-size:6px!important}.coachIdentity strong{font-size:11px!important}.coachQuick{gap:2px!important}.coachQuick button{min-height:22px!important;font-size:7px!important;padding:2px!important}.coachQuick button:first-child{min-height:25px!important;font-size:8px!important}
}
/* Portrait phone keeps a small visible coach card; training itself remains scrollable. */
@media (orientation:portrait) and (max-width:940px){
  html,body{overflow:auto!important;height:auto!important}.screen,#app{height:auto!important;min-height:var(--app-h,100dvh)!important}.homebody{overflow:visible!important}.heroGrid:has(>.homeCoach){grid-template-columns:1fr!important}.homeCoach{min-height:240px!important}.homeCoachPortrait{min-height:190px!important;background-position:center 12%!important}.main{overflow:visible!important;display:block!important}.sidebar{display:none!important}.training{height:auto!important;min-height:calc(var(--app-h,100dvh) - 56px)!important;grid-template-rows:48px minmax(360px,52dvh) auto!important}.chartArea,.chartFrame,.chartwrap{min-height:360px!important}.lessonDock{min-height:0!important}.dockGrid{display:block!important}.prompt{margin-bottom:7px!important}.answers{grid-template-columns:1fr!important}.coachRail{position:fixed!important;right:8px;bottom:8px;z-index:95!important;width:118px!important;height:176px!important;display:block!important;padding:0!important;border-radius:16px!important}.coachRail .coachSpeech,.coachRail .coachQuick{display:none!important}.coachRail .coachPortrait{position:absolute!important;inset:0!important;min-height:0!important;border-radius:16px!important;background-position:center top!important}.coachRail .coachIdentity{left:5px!important;right:5px!important;bottom:5px!important;padding:4px!important}.coachRail .coachIdentity span{display:none!important}.coachRail .coachIdentity strong{font-size:11px!important}
}
