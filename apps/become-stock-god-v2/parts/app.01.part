/* 從菜雞到股神 (V3 engine) — adaptive learning game */
(function(){
'use strict';
var E=window.BSG,C=E.C,CT=window.BSG_CONTENT,BANK=JSON.parse(document.getElementById('bank-data').textContent),X=E.ix;
var SAVE_KEY='bsg_v3_product',app=document.getElementById('app'),BYID={},DEC={};
BANK.rounds.forEach(function(r){BYID[r.id]=r;});
var TRAIN=BANK.rounds.filter(function(r){return r.slot==='primary'&&(r.pool==='A'||r.pool==='B');}).map(function(r){return r.id;});
var EXAM=BANK.rounds.filter(function(r){return r.slot==='primary'&&r.pool==='C';}).map(function(r){return r.id;});
var UI={screen:'home',chart:null,mission:null,mode:'mission',roundId:null,exercise:0,feedback:null,hint:0,answer:null,sheet:null};
var scan='<div class="scanline"></div>';
function decodeRound(r){var f100=function(a){return a.map(function(x){return x/100;});},f4=function(a){return a?a.map(function(x){return x===null?null:x/10000;}):null;};return{o:f100(r.o),h:f100(r.h),l:f100(r.l),c:f100(r.c),v:r.v.slice(),atr:f4(r.atr),ma20:f4(r.m20),ma60:f4(r.m60),ic:r.ic?f4(r.ic):r.o.map(function(){return null;})};}
function getR(id){if(DEC[id])return DEC[id];var m=BYID[id];if(!m)return null;var R=decodeRound(m),errs=E.validateRound(R);if(errs.length){console.error('invalid round',id,errs);return null;}DEC[id]=R;return R;}
function esc(x){return String(x==null?'':x).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c];});}
function pct(x,d){if(!isFinite(x))return '—';return (x*100).toFixed(d==null?1:d)+'%';}
function px(x){return E.isNum(x)?x.toFixed(E.priceDecimals(x)):'—';}
function clamp(x,a,b){return Math.max(a,Math.min(b,x));}
function avg(a,s,e){var n=0,t=0;s=Math.max(0,s);e=Math.min(a.length-1,e);for(var i=s;i<=e;i++)if(E.isNum(a[i])){t+=a[i];n++;}return n?t/n:null;}
function minA(a,s,e){var v=Infinity;s=Math.max(0,s);e=Math.min(a.length-1,e);for(var i=s;i<=e;i++)v=Math.min(v,a[i]);return v;}
function maxA(a,s,e){var v=-Infinity;s=Math.max(0,s);e=Math.min(a.length-1,e);for(var i=s;i<=e;i++)v=Math.max(v,a[i]);return v;}
function toast(t){var n=document.createElement('div');n.className='toast';n.textContent=t;document.body.appendChild(n);setTimeout(function(){n.remove();},1900);}
function newSeed(){return Date.now().toString(36)+Math.floor(Math.random()*1e9).toString(36);}
function newSave(){return{version:3,created:new Date().toISOString(),completed:[],xp:0,coins:0,streak:0,premium:false,missionStats:{},practice:{idx:0,correct:0,total:0,round:1},exam:{idx:0,correct:0,total:0},lastMission:1,seed:newSeed()};}
// SAVE_KEY and version stay as they were so every existing V3 player keeps their progress.
// migrate() only fills fields that newer builds need; it never resets existing values.
function migrate(s){var d=newSave();if(!Array.isArray(s.completed))s.completed=[];s.completed=s.completed.map(Number).filter(function(x){return x>=1&&x<=36;}).filter(function(x,i,a){return a.indexOf(x)===i;}).sort(function(a,b){return a-b;});['xp','coins','streak'].forEach(function(k){if(!isFinite(s[k]))s[k]=0;});if(typeof s.premium!=='boolean')s.premium=!!s.premium;if(!s.missionStats||typeof s.missionStats!=='object')s.missionStats={};s.practice=Object.assign({},d.practice,s.practice||{});s.exam=Object.assign({},d.exam,s.exam||{});if(!(s.practice.round>=1))s.practice.round=1;if(!isFinite(s.lastMission))s.lastMission=1;if(!s.seed)s.seed=newSeed();if(!s.created)s.created=d.created;s.version=3;return s;}
function load(){try{var s=JSON.parse(localStorage.getItem(SAVE_KEY)||'null');if(s&&s.version===3)return migrate(s);}catch(e){}return newSave();}
var S=load();function save(){try{localStorage.setItem(SAVE_KEY,JSON.stringify(S));}catch(e){}}save();
function completed(id){return S.completed.indexOf(id)>=0;}
function unlocked(id){if(id===1)return true;return completed(id-1);}
function premiumNeeded(id){return id>CT.FREE_THROUGH&&!S.premium;}
function level(){return Math.floor(S.xp/600)+1;}function xpIn(){return S.xp%600;}var RANKS=['菜雞學徒','K 線小雞','結構雞','位置獵雞','量價分析雞','風控指揮雞'];
function rankName(){var n=S.completed.length;return n>=36?'股神候補':RANKS[Math.floor(n/6)];}
function chickStage(){var n=S.completed.length;return n>=36?'god':n>=12?'scholar':'rookie';}
function chickImg(stage,cls){return '<span class="ckChick ck-'+(stage||chickStage())+(cls?' '+cls:'')+'" role="img" aria-label="小雞"></span>';}
function hud(back){return '<header class="hudbar">'+
 '<div class="brand">'+(back?'<button class="iconbtn" data-act="home" aria-label="返回首頁">‹</button>':chickImg(null,'crown'))+'<div><div class="brandname">從菜雞到<b>股神</b></div><div class="brandsub">新手也能學會看 K 線與結構</div></div></div>'+
 '<div class="xpbox"><span class="lv">LV.'+level()+'</span><div class="xpbar"><i style="width:'+(xpIn()/6)+'%"></i></div><span class="lv">'+xpIn()+' / 600 EXP</span></div>'+
 '<div class="hudstats"><div class="hudpill gold">◆ '+S.coins+'</div><div class="hudpill fire">🔥 '+S.streak+'</div><button class="iconbtn" data-act="home">⌂</button></div></header>';}
function destroyChart(){if(UI.chart){UI.chart.destroy();UI.chart=null;}}
function go(screen){destroyChart();closeSheet();UI.screen=screen;render();}
function render(){try{if(UI.screen==='home')home();else if(UI.screen==='training')training();else if(UI.screen==='mastery')mastery();else if(UI.screen==='paywall')paywall();else if(UI.screen==='practiceHome')practiceHome();else if(UI.screen==='overview')overview();else home();}catch(e){console.error(e);app.innerHTML=scan+hud(true)+'<div class="paywall"><div class="payCard"><div class="payTitle">系統錯誤</div><p>'+esc(e.message)+'</p><button class="btn primary" data-act="home">返回基地</button></div></div>';}}
function worldProgress(w){var arr=CT.MISSIONS.filter(function(m){return m.world===w.id;}),n=arr.filter(function(m){return completed(m.id);}).length;return{n:n,total:arr.length,p:n/arr.length*100};}
function nextMission(){for(var i=1;i<=CT.MISSIONS.length;i++)if(!completed(i))return i;return 36;}
function pad2(n){return String(n).padStart(2,'0');}
function bottomNav(cur){var items=[['home','首頁','⌂','home'],['overview','36 關總覽','☰','overview'],['continue','繼續','▶','continueNext'],['practiceHome','實戰艙','⤨','practiceHome']];
 return '<nav class="ckNav" aria-label="主要導覽">'+items.map(function(it){return '<button class="ckNavBtn'+(cur===it[0]?' on':'')+'" data-act="'+it[3]+'"'+(cur===it[0]?' aria-current="page"':'')+'><span class="ckNavIc" aria-hidden="true">'+it[2]+'</span><span>'+it[1]+'</span></button>';}).join('')+'</nav>';}
function missionCard(x){var d=completed(x.id),u=unlocked(x.id),lock=u&&!d&&premiumNeeded(x.id),state=d?'done':u?'next':'locked',badge=d?'✓ 已完成':lock?'◆ 完整版':u?'▶ 下一關':'🔒 未解鎖';
 return '<button class="ckTile '+state+'" data-mid="'+x.id+'" '+(u?'data-act="mission" data-id="'+x.id+'"':'disabled aria-disabled="true"')+'><span class="ckTileNum">'+pad2(x.id)+'</span><span class="ckTileTxt"><b>'+esc(x.title)+'</b><small>'+esc(x.sub)+'</small></span><span class="ckTileState">'+badge+'</span></button>';}
function home(){var next=nextMission(),m=CT.MISSIONS[next-1],done=S.completed.length,all=done>=36,xp=xpIn();
 var cta=done===0?'開始遊戲':all?'重玩完整掃描':'繼續進度｜M'+pad2(next)+' '+m.title;
 var hero='<section class="ckHero"><div class="ckHeroArt" role="img" aria-label="三隻小雞：看不懂 K 線的菜雞、認真讀書的小雞、戴墨鏡的股神"></div>'+
  '<h1 class="ckSrOnly">從菜雞到股神</h1><p class="ckSrOnly">新手也能學會看 K 線與結構</p>'+
  '<div class="ckHeroCta"><button class="ckBtn ckGold ckStart" data-act="mission" data-id="'+next+'"><span>'+esc(cta)+'</span><span aria-hidden="true">›</span></button>'+
  '<div class="ckCtaRow"><button class="ckBtn ckCyan" data-act="overview"><span class="ckIc" aria-hidden="true">☰</span>36 關總覽</button>'+
  '<button class="ckBtn ckViolet'+(all?'':' ckSoftLock')+'" data-act="practiceHome"><span class="ckIc" aria-hidden="true">⤨</span>隨機實戰'+(all?'':'<em>完成 36 關解鎖</em>')+'</button></div></div></section>';
 var profile='<section class="ckCard ckProfile">'+chickImg(null,'ckAvatar')+'<div class="ckProfMain"><div class="ckRank">'+esc(rankName())+'</div><div class="ckLvRow"><span class="ckLv">Lv.'+level()+'</span><span class="ckXpTxt">'+xp+' / 600 EXP</span></div><div class="ckXp"><i style="width:'+(xp/6)+'%"></i></div></div>'+
  '<div class="ckStats"><div><b>'+done+'<small>/36</small></b><span>關卡進度</span></div><div><b>'+S.streak+'</b><span>連勝</span></div><div><b>'+S.practice.correct+'</b><span>實戰答對</span></div></div></section>';
 var feats='<section class="ckFeatures">'+
  '<button class="ckFeat" data-act="overview">'+chickImg('scholar','ckFeatArt')+'<b>情境教學</b><small>從一根 K 到完整掃描，一次只學一件事</small></button>'+
  '<button class="ckFeat" data-act="continueNext">'+chickImg('rookie','ckFeatArt')+'<b>互動練習</b><small>真實歷史 K 線，看圖作答</small></button>'+
  '<button class="ckFeat" data-act="practiceHome">'+chickImg('god','ckFeatArt')+'<b>挑戰關卡</b><small>400 題混合實戰、100 題盲測</small></button></section>';
 var upNext=all?ORDER_IDS.slice(-3).map(function(x){return CT.MISSIONS[x-1];}):orderAfter(next,3);
 var strip='<section class="ckSection"><header class="ckSecHead"><h2>接下來的關卡</h2><button class="ckLink" data-act="overview">查看全部 ›</button></header><div class="ckStrip">'+upNext.map(missionCard).join('')+'</div></section>';
 var mods='<section class="ckSection"><header class="ckSecHead"><h2>課程地圖</h2><span class="ckMuted">'+done+' / 36</span></header><div class="ckMods">'+CT.WORLDS.map(function(w){var p=worldProgress(w);return '<button class="ckMod" data-act="overview" data-world="'+w.id+'"><span class="ckModCode">MODULE 0'+w.id+'</span><b>'+esc(w.title)+'</b><span class="ckMiniBar"><i style="width:'+p.p+'%"></i></span><small>'+p.n+' / '+p.total+'</small></button>';}).join('')+'</div></section>';
 var prem=!S.premium?'<section class="ckCard ckPremium"><div><b>免費試玩到第 6 關</b><small>完整版：36 關能力鏈、400 題實戰、100 題盲測</small></div><button class="ckBtn ckGold ckSmall" data-act="paywall">查看完整版</button></section>':'';
 app.innerHTML=scan+hud(false)+'<main class="homebody ckHome">'+hero+profile+feats+strip+mods+prem+'<div class="legal">歷史行情學習遊戲｜非即時行情｜不是投資建議｜目前為產品測試版，金流按鈕為模擬。</div></main>'+bottomNav('home');}
function overview(){var next=nextMission(),done=S.completed.length,all=done>=36,nm=CT.MISSIONS[next-1];
 var top='<section class="ckCard ckOvTop">'+chickImg(null,'ckAvatar')+'<div><div class="ckRank">已完成 '+done+' / 36</div><div class="ckXp"><i style="width:'+(done/36*100)+'%"></i></div><small class="ckMuted">'+(all?'36 關全部完成，任何一關都可以重玩。':'下一關：M'+pad2(next)+' '+esc(nm.title))+'</small></div>'+(all?'':'<button class="ckBtn ckGold ckSmall" data-act="mission" data-id="'+next+'">繼續 ›</button>')+'</section>';
 var groups=CT.WORLDS.map(function(w){var ms=inOrder(CT.MISSIONS.filter(function(x){return x.world===w.id;})),p=worldProgress(w);
  return '<section class="ckModule" id="world-'+w.id+'"><header class="ckModHead"><span class="ckModCode">MODULE 0'+w.id+'</span><h2>'+esc(w.title)+'</h2><span class="ckModProg">'+p.n+' / '+p.total+'</span></header><span class="ckMiniBar"><i style="width:'+p.p+'%"></i></span><div class="ckTiles">'+ms.map(missionCard).join('')+'</div></section>';}).join('');
 app.innerHTML=scan+hud(true)+'<main class="ckPage ckOverview"><h1 class="ckPageTitle">36 關總覽</h1><p class="ckMuted ckPageSub">已完成的關卡可以隨時重玩，不會重複領首次完成獎勵；還沒解鎖的關卡要照順序來。</p>'+top+groups+'</main>'+bottomNav('overview');
 var focus=UI.focusWorld;UI.focusWorld=null;var target=focus?document.getElementById('world-'+focus):document.querySelector('.ckTile.next');if(target&&target.scrollIntoView)target.scrollIntoView({block:focus?'start':'center'});}
function currentWorldMissions(m){return CT.MISSIONS.filter(function(x){return x.world===m.world;});}
function sidebar(m){var w=CT.WORLDS[m.world-1],p=worldProgress(w),rows=currentWorldMissions(m).map(function(x){var d=completed(x.id),u=unlocked(x.id),lock=premiumNeeded(x.id);return '<button class="missionrow '+(x.id===m.id?'current ':'')+(d?'done ':'')+(!u?'locked ':'')+(lock?'premium':'')+'" '+(u?'data-act="mission" data-id="'+x.id+'"':'disabled')+'><span class="num">'+(d?'✓':String(x.id).padStart(2,'0'))+'</span><span><span class="tt">'+esc(x.title)+'</span><span class="st">'+esc(x.sub)+'</span></span><span class="lock">'+(lock?'◆':d?'✓':'›')+'</span></button>';}).join('');return '<aside class="sidebar"><div class="sidehead"><div class="worldcode">MODULE 0'+w.id+' // '+w.code+'</div><div class="worldtitle">'+esc(w.title)+'</div><div class="worldsub">'+esc(w.sub)+'</div><div class="worldprog"><div class="miniBar"><i style="width:'+p.p+'%"></i></div><span style="font:800 10px var(--mono)">'+p.n+'/'+p.total+'</span></div></div><div class="missionlist">'+rows+'</div></aside>';}
function criterion(id,R){var i=X(0),c=R.c[i],o=R.o[i],pc=R.c[i-1],ma=R.ma20[i],ma60=R.ma60[i],a=R.atr[i]||c*.02,sup=minA(R.l,i-20,i-1),res=maxA(R.h,i-20,i-1),v20=avg(R.v,i-19,i),vr=v20?R.v[i]/v20:1,oldMa=R.ma20[i-5],prevHi=maxA(R.h,i-20,i-1),prevLo=minA(R.l,i-20,i-1);var hi1=maxA(R.h,i-24,i-13),hi2=maxA(R.h,i-12,i),lo1=minA(R.l,i-24,i-13),lo2=minA(R.l,i-12,i),trendUp=hi2>hi1*1.005&&lo2>lo1*1.005,trendDown=hi2<hi1*.995&&lo2<lo1*.995,dist=ma?c/ma-1:null;
 return{i:i,c:c,o:o,pc:pc,ma:ma,ma60:ma60,a:a,sup:sup,res:res,v20:v20,vr:vr,oldMa:oldMa,prevHi:prevHi,prevLo:prevLo,hi1:hi1,hi2:hi2,lo1:lo1,lo2:lo2,trendUp:trendUp,trendDown:trendDown,dist:dist};}
