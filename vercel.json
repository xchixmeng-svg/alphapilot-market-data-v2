{
  "cleanUrls": true,
  "headers": [
    { "source": "/(index.html)?", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(bgm.mp3|landing.webp|app-icon.webp|icon-192.png|icon-512.png|apple-touch-icon.png)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
  ]
}
