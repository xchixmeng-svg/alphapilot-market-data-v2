{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "V6.2-LLM-REASONING-v2.0",
  "title": "AlphaPilot V6.2 LLM decision response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision", "evidence_quality", "hypothesis_type", "hypothesis",
    "primary_evidence_ids", "secondary_evidence_ids", "counter_evidence_ids",
    "system_limitations", "bull_thesis", "bear_thesis", "invalidation",
    "decision_reason", "entry", "failure_exit"
  ],
  "properties": {
    "decision": {"type": "string", "enum": ["REJECT", "WATCH", "CANDIDATE", "HIGH_CONVICTION"]},
    "evidence_quality": {"type": "string", "enum": ["STRONG", "MODERATE", "WEAK"]},
    "hypothesis_type": {"type": "string", "minLength": 1, "maxLength": 80},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 1000},
    "primary_evidence_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "secondary_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "counter_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "system_limitations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true, "description": "Must exactly echo system_unavailable_evidence_ids. Transparency only; never evidence, counter-evidence, or a reason for caution."},
    "bull_thesis": {"type": "string", "minLength": 1, "maxLength": 1200},
    "bear_thesis": {"type": "string", "minLength": 1, "maxLength": 1200},
    "invalidation": {"type": "string", "minLength": 1, "maxLength": 1200},
    "decision_reason": {"type": "string", "minLength": 1, "maxLength": 1000, "description": "Must rely on case-available evidence or case-specific supported gaps. Do not cite permanent system limitations as a reason."},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ideal_low", "ideal_high"],
      "properties": {
        "status": {"type": "string", "enum": ["NOW", "WAIT_FOR_PULLBACK", "WAIT_FOR_CONFIRMATION", "NOT_ACTIONABLE"]},
        "ideal_low": {"type": ["number", "null"]},
        "ideal_high": {"type": ["number", "null"]}
      },
      "description": "REJECT/WATCH require NOT_ACTIONABLE and null bounds. CANDIDATE/HIGH_CONVICTION require positive numeric bounds with ideal_low <= ideal_high."
    },
    "failure_exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_price", "reason", "trigger_type"],
      "properties": {
        "exit_price": {"type": ["number", "null"]},
        "reason": {"type": ["string", "null"]},
        "trigger_type": {
          "type": "string",
          "enum": ["PRICE_STRUCTURE_BREAK", "THESIS_INVALIDATION", "CATALYST_FAILURE", "VALUATION_EXPECTATION_BREAK", "MULTI_EVIDENCE_FAILURE", "UNAVAILABLE"]
        }
      },
      "description": "REJECT/WATCH require null exit_price and UNAVAILABLE. CANDIDATE/HIGH_CONVICTION require a positive exit_price strictly below entry.ideal_high, a non-empty reason, and a non-UNAVAILABLE trigger."
    }
  }
}
