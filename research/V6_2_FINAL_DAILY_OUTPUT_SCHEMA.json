          "description": "Calibrated unconditional probability of reaching +20% within 120 trading sessions, regardless of interim drawdown."
        },
        "p_hit30_h20": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Calibrated unconditional probability of reaching +30% within 20 trading sessions, regardless of interim drawdown."
        },
        "p_hit30_h40": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
