        },
        "p_hit20_h30": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Calibrated unconditional probability of reaching +20% within 30 trading sessions, regardless of interim drawdown."
        },
        "p_hit30_h30": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Calibrated unconditional probability of reaching +30% within 30 trading sessions, regardless of interim drawdown."
        },
        "p_hit50_h30": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Calibrated unconditional probability of reaching +50% within 30 trading sessions, regardless of interim drawdown."
        }
      },
      "description": "Primary calibrated profit probabilities start at +10%. Sub-10% moves are not V6.2 profit opportunities. Barrier-first fields are secondary path-risk diagnostics only."
    },
    "upside": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_low_pct",
        "base_high_pct",
        "bull_pct"
      ],
      "properties": {
        "base_low_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "base_high_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "bull_pct": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_mae_low_pct",
        "expected_mae_high_pct"
      ],
      "properties": {
        "expected_mae_low_pct": {
          "type": [
            "number",
            "null"
          ]
        },
        "expected_mae_high_pct": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "likely_start_min_sessions",
        "likely_start_max_sessions",
        "main_window_min_sessions",
        "main_window_max_sessions"
      ],
      "properties": {
        "likely_start_min_sessions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "likely_start_max_sessions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "main_window_min_sessions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "main_window_max_sessions": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "description": "Primary V6.2 maturity target is approximately 20-30 trading sessions for at least +10%; longer duration is allowed only under an explicit continuation decision."
    },
    "continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "reason",
        "still_advancing"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_APPLICABLE",
            "CONTINUE",
            "REASSESS",
            "END"
          ]
        },
        "still_advancing": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1200
        }
      },
      "description": "Post-maturity continuation state. Beyond ~30 sessions, only an opportunity still advancing with an intact thesis should remain active."
    },
    "launch_quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p_next_session_positive",
        "p_launch_within_3_sessions",
        "p_launch_within_5_sessions",
        "expected_prelaunch_mae_pct"
      ],
      "properties": {
        "p_next_session_positive": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "p_launch_within_3_sessions": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "p_launch_within_5_sessions": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "expected_prelaunch_mae_pct": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "description": "Entry-timing quality only. Fast launch is preferred but is not the primary success definition."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "analysis_status": {
            "const": "INSUFFICIENT_INPUT"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "const": null
          },
          "evidence_quality": {
            "const": "NOT_ASSESSABLE"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "analysis_status": {
            "const": "COMPLETE"
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "enum": [
              "REJECT",
              "WATCH",
              "CANDIDATE",
              "HIGH_CONVICTION"
            ]
          },
          "evidence_quality": {
            "enum": [
              "STRONG",
              "MODERATE",
              "WEAK"
            ]
          }
        }
      }
    }
  ]
}
