{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "V6.2-FINAL-DAILY-OPPORTUNITY-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_date",
    "code",
    "analysis_status",
    "missing_required_inputs",
    "decision",
    "evidence_quality",
    "hypothesis_type",
    "hypothesis",
    "primary_evidence_ids",
    "secondary_evidence_ids",
    "counter_evidence_ids",
    "bull_thesis",
    "bear_thesis",
    "invalidation",
    "decision_reason",
    "entry",
    "probabilities",
    "upside",
    "risk",
    "timing",
    "continuation",
    "launch_quality"
  ],
  "properties": {
    "decision_date": {
      "type": "integer"
    },
    "code": {
      "type": "string",
      "minLength": 4,
      "maxLength": 10
    },
    "analysis_status": {
      "enum": [
        "COMPLETE",
        "INSUFFICIENT_INPUT"
      ]
    },
    "missing_required_inputs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "decision": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "REJECT",
        "WATCH",
        "CANDIDATE",
        "HIGH_CONVICTION",
        null
      ]
    },
    "evidence_quality": {
      "enum": [
        "STRONG",
        "MODERATE",
        "WEAK",
        "NOT_ASSESSABLE"
      ]
    },
    "hypothesis_type": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "hypothesis": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1500
    },
    "primary_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "secondary_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "counter_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "bull_thesis": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1800
    },
    "bear_thesis": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1800
    },
    "invalidation": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1800
    },
    "decision_reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1200
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "current_price",
        "ideal_low",
        "ideal_high",
        "conditional_on_entry"
      ],
      "properties": {
        "status": {
          "enum": [
            "NOW",
            "WAIT_FOR_PULLBACK",
            "WAIT_FOR_CONFIRMATION",
            "NOT_ACTIONABLE",
            "UNAVAILABLE"
          ]
        },
        "current_price": {
          "type": [
            "number",
            "null"
          ]
        },
        "ideal_low": {
          "type": [
            "number",
            "null"
          ]
        },
        "ideal_high": {
          "type": [
            "number",
            "null"
          ]
        },
        "conditional_on_entry": {
          "type": "boolean"
        }
      }
    },
    "probabilities": {
      "type": "object",
