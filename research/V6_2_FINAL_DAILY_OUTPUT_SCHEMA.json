        "p_up10_before_down5_h40",
        "p_up10_before_down5_h60",
        "p_up20_before_down10_h20",
        "p_up20_before_down10_h40",
        "p_up20_before_down10_h60",
        "p_up20_before_down10_h120",
        "p_hit10_h30",
        "p_hit20_h30",
        "p_hit30_h30",
        "p_hit50_h30"
      ],
      "properties": {
        "p_hit10_h20": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Calibrated unconditional probability of reaching +10% within 20 trading sessions, regardless of interim drawdown."
        },
        "p_hit10_h40": {
          "type": [
            "number",
            "null"
