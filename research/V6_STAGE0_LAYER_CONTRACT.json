    },
    {
      "layer_id": "0C_COMPANY",
      "required": true,
      "manifest_path": "data/history/v6-layered/manifests/0C_COMPANY.json"
    },
    {
      "layer_id": "0D_MACRO",
      "required": true,
      "manifest_path": "data/history/v6-layered/manifests/0D_MACRO.json"
    },
    {
      "layer_id": "0E_EVENT_TIME",
      "required": true,
      "manifest_path": "data/history/v6-layered/manifests/0E_EVENT_TIME.json"
    },
    {
      "layer_id": "0F_FINAL_ASSEMBLY",
      "required": true,
      "manifest_path": "data/history/v6-layered/manifests/0F_FINAL_ASSEMBLY.json"
    }
