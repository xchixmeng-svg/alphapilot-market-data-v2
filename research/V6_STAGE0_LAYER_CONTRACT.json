  "dataset_time_semantics_allowed": [
    "decision_date_daily",
    "periodic_release_asof",
    "event_timestamp_asof",
    "static_live_only"
  ],
  "fallback_equivalence_gate": {
    "must_pass_before_layer_freeze": true,
    "allowed_status": [
      "PROVISIONAL",
      "PASS",
      "FAIL"
    ],
    "minimum_overlap_observations": 60,
    "minimum_distinct_calendar_years": 3,
    "absolute_value_tolerance": 0.000001,
    "allowed_value_mismatch_rate": 0,
    "required_checks": [
      "series_semantics_identity",
      "units_identity",
      "frequency_identity",
      "source_lineage_identity",
      "date_alignment",
      "numeric_value_match",
      "publication_or_availability_lag"
    ],
    "rule_if_primary_unreachable_on_actions": "Fallback remains PROVISIONAL. Perform equivalence audit in an independent reachable environment and commit immutable evidence before SOURCE FREEZE."
  },
  "stage0f_cross_layer_gate": {
    "all_required_layers_must_be_frozen_pass": true,
    "daily_required_layer_eligible_date_coverage": 1,
    "periodic_join_rule": "available_at <= decision_time",
    "event_join_rule": "published_at <= decision_time",
    "future_join_violations_allowed": 0,
    "silent_zero_fill_violations_allowed": 0,
    "duplicate_decision_key_violations_allowed": 0,
    "must_report": [
      "eligible_decision_dates",
      "per_layer_date_start_end",
      "per_layer_eligible_date_coverage",
      "unmatched_dates_by_layer",
      "missingness_by_layer_dataset",
      "availability_lag_or_stale_age_distribution",
      "timezone_and_session_normalization",
      "future_join_violations",
      "silent_zero_fill_violations",
      "duplicate_decision_key_violations",
      "input_manifest_sha256"
    ]
  },
  "layer_ablation_audit": {
    "diagnostic_only": true,
    "may_increase_user_facing_probability": false,
    "may_remove_or_reweight_layer_under_same_lock_after_oos": false,
    "schema_change_requires_successor_preregistration": true
  }
