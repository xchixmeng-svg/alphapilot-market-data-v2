  "layer_manifest_required_fields": [
    "layer_id",
    "status",
    "schema_version",
    "generation_commit",
    "generated_at_utc",
    "source_lineage",
    "datasets",
    "date_start",
    "date_end",
    "row_count",
    "file_sha256",
    "missingness",
    "pit_rules"
